# ===== 履歴 =====
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt share_history hist_ignore_all_dups hist_ignore_space hist_reduce_blanks

# ===== 補完 =====
# install.sh が書き出す道具の補完と、システムの vendor-completions（docker など。zsh-bin の fpath には無い）
fpath=(~/.local/share/zsh/site-functions(N/) /usr/share/zsh/vendor-completions(N/) $fpath)
typeset -U fpath
# 誰でも書ける fpath（共有の端末・CI の /usr/local など）は、問わずに fpath から外してから compinit する
# （zsh 5.8 の compinit -i は外さないので、そこの同じ名前の補完が読まれる）。compaudit が挙げた場所（ファイルならその場所）と、
# その下にある fpath を外す（危ない親の下には .zwc を置ける）
# zsh 自身の関数の場所まで危ない端末（GitHub の実行環境は /usr/share が 777）では compinit も外れるので、補完の初期化をせずに進む（危ない場所のコードは動かさない）
autoload -Uz compaudit
() {
  local x d; local -a bad keep
  for x in ${(f)"$(compaudit 2>/dev/null)"}; do [[ -f $x ]] && x=${x:h}; [[ -d $x ]] && bad+=($x); done
  (( $#bad )) || return 0
  for d in $fpath; do for x in $bad; do [[ $d == $x || $d == $x/* ]] && continue 2; done; keep+=($d); done
  fpath=($keep)
}
() { (( $# )) } ${^fpath}/compinit(N) && autoload -Uz compinit && compinit -i
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}' # 大文字小文字を区別しない
zstyle ':completion:*' menu select

# ===== キー操作（vi 風）=====
bindkey -v
KEYTIMEOUT=1 # Esc でノーマルモードへ即座に切り替え
# モードに合わせてカーソル形状を変える（挿入: 縦棒 / ノーマル: ブロック）
zle-keymap-select() {
  if [[ $KEYMAP == vicmd ]]; then printf '\e[2 q'; else printf '\e[6 q'; fi
}
zle-line-init() { printf '\e[6 q'; }
zle -N zle-keymap-select
zle -N zle-line-init

# ===== ツール =====
command -v mise >/dev/null && eval "$(mise activate zsh)"
command -v fnm >/dev/null && eval "$(fnm env --shell zsh)" # fnm use を使えるようにする
command -v starship >/dev/null && eval "$(starship init zsh)"
# fzf: Ctrl-R 履歴検索 / Ctrl-T ファイル / Alt-C ディレクトリ移動（bindkey -v の後に読む）
command -v fzf >/dev/null && source <(fzf --zsh)

# ls / cat 自体は置き換えない（Claude Code 等が実行するコマンドの挙動を変えないため）
alias ll='eza -l --git --icons'
alias la='eza -la --git --icons'
alias lt='eza --tree --level=2 --icons'
alias lg='lazygit'
alias lzd='lazydocker'
# 並列作業: git worktree を作ってその中で Claude Code を起動（cw <名前>）
# tmux の新しいウィンドウ（C-g c）で実行すると、状態表示もウィンドウごとに出る
cw() { claude -w "$@"; }

# 端末ごとの設定と秘密（リポジトリの外）。プラグインの設定（ZSH_AUTOSUGGEST_* など）は読み込みの前に書ける
if [[ -f ~/.zshrc.local ]]; then source ~/.zshrc.local; fi

# ===== プラグイン（install.sh が clone）=====
ZPLUGINS="$HOME/.local/share/zsh/plugins"
[ -f "$ZPLUGINS/zsh-autosuggestions/zsh-autosuggestions.zsh" ] &&
  source "$ZPLUGINS/zsh-autosuggestions/zsh-autosuggestions.zsh"
# syntax-highlighting は最後に読む必要がある
[ -f "$ZPLUGINS/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ] &&
  source "$ZPLUGINS/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
