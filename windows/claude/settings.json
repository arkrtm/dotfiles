{
  "cleanupPeriodDays": 365,
  "env": {
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "1"
  },
  "permissions": {
    "allow": [
      "Bash(tinymemory:*)",
      "Bash(git diff:*)",
      "Bash(codex-review:*)",
      "PowerShell(tinymemory *)",
      "PowerShell(git diff *)",
      "PowerShell(codex-review *)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push:*)",
      "Bash(gh pr merge:*)",
      "Bash(integrate --human-approved:*)",
      "Bash(integrate setup --force:*)",
      "PowerShell(git push *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(integrate --human-approved *)",
      "PowerShell(integrate setup --force *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.codex/auth.json)",
      "Edit(~/.config/integrate/**)"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dotfiles/windows/posix/hook\" env",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "sh -c 'PATH=\"$PATH:$HOME/.local/bin:$HOME/.cargo/bin\"; command -v tinymemory >/dev/null 2>&1 && exec tinymemory hook session-start; exit 0'",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dotfiles/windows/posix/hook\" integrate-hook session-start",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dotfiles/windows/posix/hook\" agent-pane cleanup",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|fork",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dotfiles/windows/posix/hook\" handoff --session-start",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dotfiles/windows/posix/hook\" integrate-hook pre-edit",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dotfiles/windows/posix/hook\" context-nudge",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dotfiles/windows/posix/hook\" agent-pane cleanup",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dotfiles/windows/posix/hook\" agent-pane start",
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/dotfiles/windows/posix/hook\" agent-pane stop",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "pwsh -NoProfile -NonInteractive -File \"$HOME/dotfiles/windows/claude/statusline.ps1\""
  },
  "enabledPlugins": {
    "tinymemory@tinymemory": true,
    "superpowers@claude-plugins-official": true,
    "ponytail@ponytail": true
  },
  "extraKnownMarketplaces": {
    "tinymemory": {
      "source": {
        "source": "github",
        "repo": "arkrtm/tinymemory"
      }
    },
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "preferredNotifChannel": "terminal_bell",
  "remoteControlAtStartup": true
}
