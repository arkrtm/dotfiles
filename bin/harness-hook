#!/bin/sh
"""true"
# sh としての起動部（Python から見ると、ここは何もしない文字列）: uv で自分自身を Python として実行し直す。
# hook を起動する側の PATH の並びや、mise の shim（cwd の mise 設定で壊れうる）に左右されないよう、
# install.sh が置く ~/.local/libexec/uv を直接使う（無ければ exit 127。PATH の uv には落とさない）
exec "$HOME/.local/libexec/uv" run --script --quiet "$0" "$@"
"""
# /// script
# requires-python = ">=3.9"
# ///
"""Claude Code の自作ハーネス: コードを変えたら、承認済みの要件の写しと、検証・受け入れ・レビュー（TDD を含む）の証拠がそろうまで
コミットも完了もさせない。
あわせて、コンテキストが溜まったら区切りで tinymemory に session を保存させる（compact や clear で流れが落ちないように）。

これは「うっかり・手抜きを止めるガードレール」であり、セキュリティ境界ではない。Bash を使えるエージェントが
意図的に迂回すること（commit-tree、git 設定の差し替え、証拠ファイルの書き換え等）は原理的に防ぎ切れない。
代表的な迂回語は拒否するが、最終的には CLAUDE.md の規則（迂回しない）に依る。

Claude Code の hooks から:
  harness-hook turn          UserPromptSubmit  ターン開始。開始時点の作業ツリーの指紋・HEAD とローカルブランチの先端・時刻・
                                               未ステージの手元の変更（写しの最初の保存が .baseline にする）を記録する
  harness-hook guard-branch  PreToolUse        Edit/Write。git の main/master 上なら編集を拒否（作業別ブランチの強制）
  harness-hook guard-bash    PreToolUse        Bash。関門を迂回する形（--no-verify 等、hook と git の設定を消す・書き換える形）を含めば拒否
                                               （コマンド行を字句に分けて見る。コミットメッセージの中の -n などは除く）。
                                               共通の pre-commit が呼ばれないリポジトリ（リポジトリ側の core.hooksPath）では
                                               git commit の前に関門の判定をし、関門を通らないコミットが残っていれば git push と
                                               main・master への git merge を拒否
  harness-hook bash          PostToolUse       Bash。宣言した検証コマンド（.harness-verify と <git-common-dir>/harness-verify の行）が
                                               リポジトリのトップで単独で成功したら、その時点の作業ツリーに「検証済み」（宣言した行がすべて
                                               同じ内容で成功したときだけ証拠になる。宣言が無ければ何を成功させても証拠にならない。
                                               サブエージェント内の実行と、下位のディレクトリでの実行は記録しない）。
                                               tinymemory に session を保存したら、その時点のコンテキストの使用量を「前回の保存」に
  harness-hook bash-failed   PostToolUseFailure Bash。検証コマンド（VERIFY_CMD の形はパイプ等の形でも、宣言した行も）が失敗したら、
                                               その作業ツリーの「検証済み」を消し、出力の先頭を <git-dir>/harness-red-log に残す
                                               （サブエージェント内も。implementer の RED を観測できるように）
  harness-hook review-done   SubagentStop      reviewer / acceptor の報告を <git-dir>/harness-last-review / harness-last-accept に保存する（合否に関わらず）。
                                               reviewer が 3 軸（仕様適合・テスト・品質・保守性）とも「承認」で終了したら、その時点の作業ツリーに「レビュー済み」。
                                               acceptor が受け入れ条件（[AC<n>]）と判定のすべてを「合格」で終了し、要件の写しの受け入れ条件の番号
                                               （AC<n>:）がすべてその中にあれば「受け入れ済み」（写しに番号が無ければ受け入れ済みにしない）。
                                               どちらも、報告の版がその時点の作業ツリー全体の版と同じときだけ記録する
  harness-hook stop          Stop              このターンに作られたコミットに、pre-commit を通っていない（git の hook が呼ばれなかった）
                                               コード変更のコミットがあるか、このターンにコード（既存のテストの変更・削除を含む）が変わり、
                                               証拠が足りなければ 1 回だけ差し戻す。
                                               差し戻さないときは、前回の保存からコンテキストが溜まっていれば 1 回だけ差し戻して remember させる
  （turn / bash / bash-failed / review-done / stop は、cwd のリポジトリを関門の対象に登録する）
git から（core.hooksPath = ~/.config/git/hooks の pre-commit → run-hook）:
  harness-hook pre-commit    Claude Code からのコミット（環境変数 CLAUDECODE あり）で、対象に登録済みか一時ディレクトリの外の
                             リポジトリのとき、ステージ済みの内容に証拠が足りなければ exit 1。人の手動コミットや、テストが一時
                             ディレクトリに作るリポジトリは対象外
  harness-hook post-commit   同じ git commit の pre-commit が関門を通していれば、コミットされた tree を記録する（Stop の突き合わせ用）
skill・手元から:
  harness-hook requirements-path  cwd のリポジトリの、承認済みの要件と受け入れ条件の写しの置き場所
                             （<git-dir>/harness-requirements/<ブランチ名>.md）を出す。ディレクトリは作り、ファイルは作らない
  harness-hook requirements-save  標準入力をその写しとして保存し、パスを出す（.git の下は Write ツールでは書けないため。
                             空の入力や、main/master の上では保存しない。同じ依頼の前の版にあった受け入れ条件の番号が無い版は、
                             「## 変更の承認」の節が無ければ保存しない。版はすべて .history に残す）。保存した時の HEAD も記録し、
                             その後にコード変更のコミットがあれば写しは古い（保存し直すまで証拠にならない）

文書・画像など（DOC_EXT の拡張子・DOC_NAME の名前）以外のファイルはすべて「コード」（関門の対象）。
文書でも、リポジトリのトップの .harness-code（fnmatch のパターン）に当たればコード（.harness-code と .harness-verify 自体もコード）。
判定は git の状態に基づく（Edit ツールでも sed -i でも同じ）。検証・受け入れ・レビューは「どの内容に対して行ったか」を
変更ファイルの blob ID と、要件の写し・自分だけの検証の宣言（<git-common-dir>/harness-verify）の指紋で覚える
（git add の前後や改行変換で変わらない。あとから編集すれば、要件や自分だけの宣言を書き換えても無効になる）。
コードを変えているのに要件の写しが無い（空）か古いか、写しの受け入れ条件に番号（AC<n>:）が無いか、検証コマンドの宣言が無ければ、
それだけで証拠は足りない。
証拠は作業ツリー単位、対象の登録はリポジトリ単位（worktree は本体と共通）で ~/.local/state/harness/repo/<id>/ に、ターンの開始状態と前回の保存はセッション単位で持つ。
依存は uv だけ（先頭の起動部が uv で Python を用意する。uv が無いと起動できず exit 127）。
起動できれば、hook としては失敗しても常に exit 0（pre-commit だけが exit 1 を返す）。
"""
import contextlib
import fcntl
import fnmatch
import functools
import hashlib
import itertools
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import time

# 関門の対象外（文書・画像など、振る舞いを変えないもの）の拡張子と、拡張子の無い名前（小文字で書き、大文字小文字を区別せずに比べる）。
# これ以外はすべて「コード」（依存の定義・lockfile・環境・テンプレート・スキーマ・データ・拡張子の無いスクリプトなども）
DOC_EXT = {
    ".md", ".markdown", ".txt", ".rst", ".adoc", ".asciidoc", ".org", ".textile", ".rtf", ".pdf", ".doc", ".docx",
    ".png", ".jpg", ".jpeg", ".gif", ".webp", ".bmp", ".ico", ".svg", ".tif", ".tiff", ".heic", ".avif",
    ".mp3", ".mp4", ".mov", ".wav", ".webm", ".woff", ".woff2", ".ttf", ".otf", ".eot",
}
DOC_NAME = {"license", "licence", "copying", "notice", "authors", "contributors", "changelog", "changes", "history", "readme",
            ".ds_store"}
# .txt でも振る舞いを変えるファイル（依存の定義 requirements*.txt・constraints*.txt・requirements/*.txt、CMake）
CODE_TXT = re.compile(r"(?:^|/)(?:cmakelists|(?:requirements|constraints)[\w.-]*|requirements/[^/]+)\.txt$", re.I)
# リポジトリのトップに置く関門の設定（1 行 1 項目。空行と # で始まる行は無視）。関門を黙って弱められないよう、これ自体もコード
#   .harness-code    コードとみなすパスの fnmatch パターン（* は / にも当たる。例: config/claude/*）
#   .harness-verify  検証コマンドの宣言（共有）。<git-common-dir>/harness-verify（自分だけ。リポジトリに置けないとき。書式は同じ）の行と
#                    合わせて、すべてが同じ内容で成功したときだけ「検証済み」（宣言に無いコマンドは証拠にならない。宣言が無ければ検証済みにならない）
CODE_FILE, VERIFY_FILE, PRIVATE_VERIFY = ".harness-code", ".harness-verify", "harness-verify"
# <git-dir> の下に残す、失敗した検証コマンドの記録（RED の観測用）: 1 件の出力の行数、残す件数、全体の上限（バイト）
RED_LOG, RED_LINES, RED_KEEP, RED_BYTES = "harness-red-log", 15, 50, 100_000
# <git-dir> の下の、承認済みの要件と受け入れ条件の写しの置き場所（中に <ブランチ名>.md と、保存した時の HEAD の <ブランチ名>.md.head）
REQUIREMENTS = "harness-requirements"
# 関門を通ってコミットされた内容（tree）の記録（リポジトリ単位）と、残す件数。関門を通した pre-commit の git の PID（post-commit が照合する）
GATED, GATED_KEEP, PENDING = "gated", 500, "gated-pending"
GATED_PATCH = "gated-patch"  # 関門を通ったコミットの patch-id（rebase・cherry-pick で付け替えたコミットを見分ける）
# reflog の記録のうち、コミットを作る操作（取り込んだ他人のコミットと、自分で作ったコミットを見分ける。checkout・reset・fast-forward は作らない）
CREATED = re.compile(r"^(?:commit|cherry-pick|revert|am)\b|^(?:rebase|pull)\b.*\((?:pick|reword|edit|squash|fixup|continue)\): |Merge made by")
# Stop が見つけた、関門を通っていないコミット（リポジトリ単位。push の前に見る）と、Bash の前の判定が通したコミットの実行待ち（セッション単位）
UNGATED, GUARD_PENDING = "ungated", "guard-pending"
# Bash の前の判定が通したコミットを記録してよいコマンドの git のサブコマンド（コミットの内容を変えないもの）
SIMPLE_GIT = {"add", "commit", "status", "log", "diff", "show"}
MERGE_VALUE_OPTS = {"-m", "-F", "-s", "-X", "--file", "--strategy", "--strategy-option", "--into-name", "--cleanup"}  # 値を取る git merge のオプション
# テストとみなすパス（新しいテストの追加は関門の対象外にする。指紋には含める）: リポジトリのトップの tests/・test/・spec/・__tests__/ の下と、
# テストの名前の規則（test_*.py、*_test.*・*.test.*・*.spec.*・*_spec.*。データ・設定の拡張子は除く。JVM・Swift・C#・PHP・Scala・Groovy の
# *Test.*・*Tests.*）。src/test/server.go・api/spec/openapi.yaml・SpeedTest.tsx のようなテストに見える名前のコードは含めない
TEST_PATH = re.compile(
    r"^(?i:tests?|spec|__tests__)/"
    r"|(?:^|/)(?:test_[^/]*\.py|[^/]+(?:_test|\.test|\.spec|_spec)\.(?!(?:[^/]*\.)?(?i:json|ya?ml|toml|xml|ini|cfg|conf|properties|sql|tf|hcl)$)[^/]+"
    r"|[^/]*[a-z0-9]Tests?\.(?:java|kt|kts|swift|cs|php|scala|groovy))$"
)
# コマンド位置: 行頭か && の直後。その後に command/exec/sudo/time/nice/env/timeout N の前置と VAR=val の前置を許す
CMD_POS = r"(?:^|&&\s*)(?:(?:command|exec|sudo|time|nice|env|timeout \S+)\s+)*(?:\w+=\S*\s+)*"
# 検証コマンドの形。失敗したら「検証済み」を消し、RED として記録する（成功は証拠にしない。証拠は宣言したコマンドの成功だけ）
VERIFY_CMD = re.compile(
    CMD_POS + r"(?:\S*/)?(?:"
    r"(?:uv run (?:--?\S+ (?:[^-\s]\S* )?)*|uvx |poetry run |pdm run |bundle exec |npx |pnpm |yarn |bun |bunx )?"
    r"(?:python3?(?:\.\d+)? -m )?"
    r"(?:pytest|unittest|tox|ruff check|mypy|pyright|jest|vitest|mocha|playwright test|eslint|tsc|prettier --check|shellcheck"
    r"|phpunit|rspec|rake|bats|ctest)\b"
    r"|cargo (?:test|check|clippy|build)\b|go (?:test|vet|build)\b|swift test\b|dotnet test\b|node --test\b|deno test\b"
    r"|mix test\b|dart test\b|flutter test\b|sbt (?:\S+ )*test\b"
    r"|(?:npm|pnpm|yarn|bun) (?:test|lint|run (?:test|lint|typecheck|check|build))\b"
    r"|(?:make|just) (?:-C \S+ )?(?:test|check|lint)\b|gradlew? (?:\S+ )*(?:test|check)\b|mvn (?:\S+ )*(?:test|verify)\b"
    r"|(?:(?:sh|bash) (?:-[eux]+ )?)?[^\s=]*tests?/[^\s=]+"  # tests/ 配下のスクリプトの実行（sh -n は構文チェックなので不可）
    r")"
)
# 宣言した検証コマンドの行と比べる前に取り除く、先頭の「cd <引数> && 」（比べるのは残りと行の完全一致。パイプ等を足した形は一致しない）
CD_PREFIX = re.compile(r"^cd\b[^&;|\n]*&&\s*")
CD_TARGET = re.compile(r"^cd(?:\s+([^&;|\n]*?))?\s*&&")  # その cd の行き先（無ければホーム）
# Bash で関門を迂回する代表的な形（シェル構文は解釈せず正規表現で見る。誤検知は許容。網羅はできない。ヒアドキュメントの本文は
# コマンド行にシェル等での実行があるときだけ見る）。--no-verify はその省略形も（--no-verbose は除く）。commit-tree は実行する形（コマンドの位置、
# git [オプション] の直後、git-commit-tree、alias の定義）、hooksPath は設定する形（hooksPath=、git config … core.hooksPath。
# 書き込む行の中の hooksPath は shell_bypass の writes で見る）。
# 環境変数は大文字の名前だけ: GIT_CONFIG* は指定する形（VAR=、export、env）、
# CLAUDECODE は消す・書き換える形（env -u、unset、export -n、CLAUDECODE=）だけを拒否する（読むだけの形は通す）
# コマンドの位置: 行頭、; & | ( ` の後、sh -c・bash -c・eval の引数の先頭（クォートの中も）。その後の VAR=val の前置は許す
CMD_AT = r"(?:^|[\n;&|(`]|\b(?:(?:ba|z|da)?sh\s+(?:-\w+\s+)*-\w*c|eval)\s+[\"']?)\s*(?:\w+=\S*\s+)*"
# 環境変数の代入（VAR=val の前置）を置ける位置: コマンドの位置、{ の後、シェルの予約語の後、前置のコマンド（nohup・time・command・
# exec・sudo・nice、そのオプション。timeout N）と変数の宣言（declare・typeset・local・readonly）の後
ASSIGN_AT = (r"(?:" + CMD_AT + r"|[{!]\s*|\b(?:then|do|else|elif|if|while|until|nohup|time|command|exec|sudo|nice"
             r"|declare|typeset|local|readonly)\s+(?:-\S+\s+)*|\btimeout\s+\S+\s+)(?:\w+=\S*\s+)*")
# git config の読むだけのオプション（--get・--get-all・--get-regexp・--list・-l）。設定の名前より前にあるときだけ読むだけ
# （名前の後の --get は、git が値として書き込む）
CONFIG_READ = r"\s(?:--get(?:-all|-regexp)?|--list|-l)(?![\w-])"
BYPASS = re.compile(
    CMD_AT + r"commit-tree\b|\bgit(?:\s+-\S+(?:\s+[^-\s]\S*)?)*\s+commit-tree\b|\bgit-commit-tree\b"
    r"|\balias\.[^|;&\n]*\bcommit-tree\b"
    # git config で core.hooksPath を設定する（名前の後に値がある）・消す（--unset などの書き換え）形。名前より前に --get・
    # --list などがある形と、config get・config list、値の無い git config core.hooksPath は読むだけ
    r"|\bhookspath\s*=|\bgit\b[^|;&\n]*\bconfig\b(?!\s+(?:get|list)(?![\w-]))(?:(?!" + CONFIG_READ + r")[^|;&\n])*?"
    r"\bcore\.hookspath[ \t]+[^\s|;&]"
    r"|\bgit\b[^|;&\n]*\bconfig\b[^|;&\n]*\s(?:--unset(?:-all)?|--replace-all|--add|--remove-section|--rename-section|-e|--edit|unset|set)"
    r"(?![\w-])[^|;&\n]*\bcore\.hookspath\b"
    r"|state/harness"
    # git の設定ファイルを直接書き換える形（sed -i・perl -i・tee・リダイレクト）。読むだけ（cat・grep・sed -n）は通す
    r"|(?:\bsed\b[^|;&\n]*\s(?:-\w*i|--in-place)|\bperl\b[^|;&\n]*\s-\w*i|\btee\b|>)[^|;&\n]*(?:\.gitconfig\b|\bgit/config\b)"
    r"|(?-i:\bGIT_CONFIG(?!_NOSYSTEM\b)\w*=|\b(?:export|env)\b[^|;&\n]*\bGIT_CONFIG(?!_NOSYSTEM\b)"
    r"|-u\s*CLAUDECODE\b|\b(?:unset|export\s+-n)\b[^|;&\n]*\bCLAUDECODE\b"
    r"|" + ASSIGN_AT + r"CLAUDECODE=|\b(?:export|env)\b[^|;&\n]*\bCLAUDECODE=)",  # 代入を置ける位置か export・env の後だけ（echo の引数は除く）
    re.I,
)
# --no-verify とその省略形（--no-verify-ssl・--no-verbose など別のオプションは除く）。検索の引数でも拒否する（検索は先頭の -- を付けずに書く）
NO_VERIFY_LONG = re.compile(r"--no-v(?:e(?:r(?:i(?:fy?)?)?)?)?(?![\w-])", re.I)
# 環境を差し替えて git の hook を外す形: HOME・XDG_CONFIG_HOME の代入・export・消去（unset・env -u）、env -i・env -。
# 同じコマンド行に、コミットを作りうる git（GIT_MAY_COMMIT: コミットを作らないと分かっているサブコマンド ENV_SAFE_GIT 以外。
# alias も作りうる側）があるときだけ拒否する（HOME=$PWD/tmp-home git init などは通す）
ENV_SWAP = re.compile(
    r"(?-i:" + ASSIGN_AT + r"(?:HOME|XDG_CONFIG_HOME)=|\b(?:export|env)\b[^|;&\n]*\b(?:HOME|XDG_CONFIG_HOME)="
    r"|\b(?:unset|export\s+-n)\b[^|;&\n]*\b(?:HOME|XDG_CONFIG_HOME)\b|-u\s*(?:HOME|XDG_CONFIG_HOME)\b)"
    r"|\benv\b[^|;&\n]*?\s(?:-\w*i|--ignore-environment|-)(?![\w-])", re.I)  # env - は env -i と同じ
ENV_SAFE_GIT = ("init", "clone", "status", "log", "diff", "show", "config", "rev-parse", "ls-files", "version", "fetch", "remote", "branch")
# git [全体オプション（値を取るものは値も）] <サブコマンド>と、ダッシュ形の git-<サブコマンド>（git-core の下のもの。パス付きも）。
# 安全とみなすのは、ENV_SAFE_GIT の語がそのまま（空白・行末・区切りの前で終わる）書かれたときだけ。それ以外の始まり
# （alias・展開・クォート・ブレース展開など）はすべて作りうる側
SAFE_SUB = r"(?!(?:" + "|".join(ENV_SAFE_GIT) + r")(?=\s|$|[;&|)]))"
GIT_MAY_COMMIT = re.compile(
    r"\bgit\b(?:\s+(?:-[cC]|--git-dir|--work-tree|--namespace|--config-env)\s+\S+"
    r"|\s+-(?!(?:[cC]|-git-dir|-work-tree|-namespace|-config-env)\s)\S+)*"
    r"\s+" + SAFE_SUB + r"[^\s-]|(?:^|[\s;&|(`\"'])(?:[^\s:;&|]*/)?git-" + SAFE_SUB + r"\w", re.I)
# 以下は shell_bypass で、コマンド行を字句に分けて見る形: git commit の -n（--no-verify の短縮。-anm のような連結も）、
# git のクォートを外した字句（commit-tree・設定・alias）、cp・mv・install・ln・rsync で git の設定を行き先にする形、
# hook を消す・差し替える形、hooksPath を含む行で書き込む形
GIT_WORD, COMMIT_WORD = re.compile(r"\bgit\b"), re.compile(r"\bcommit\b", re.I)
# 字句の先頭の、-n を含む短いオプションの束: 値を取らないオプション（a・e・i・o・p・q・s・v・z）の後の n（-anm・-nm1 も。-mn は -m の値）
NO_VERIFY_SHORT = re.compile(r"-[aeiopqsvz]*n")
# 次の字句を値に取る -m・--message と、値を取らない短いオプションとの連結（-am など。-Cm は -C が m を値に取るので違う）
MESSAGE_OPT = re.compile(r"-[aeinopqsvz]*m|--message")
MESSAGE_ATTACHED = re.compile(r"-[aeinopqsvz]*m.|--message=")  # 値を連結した -m… と --message=…（字句ごと値）
SUBSTITUTION = re.compile(r"\$\(|`")  # コマンド置換（字句にあれば実行されうる）
BACKQUOTE_ESCAPE = re.compile(r"\\([$`\\])")  # `…` の中で意味のあるエスケープ（外した後が中のコマンド行）
COMMAND_LIKE = re.compile(r"[\s;&|]")  # 空白や区切りを含む字句（sh -c・eval の引数など）は、1 つのコマンド行として見直す
BRACE, BRACE_LIMIT = re.compile(r"\{([^{}\s]*,[^{}\s]*)\}"), 256  # ブレース展開 {a,b}（入れ子は内側から 1 段ずつ）と、展開する語数の上限
# クォート・エスケープの中の { } , に付ける印（シェルはそこを展開しない。shell_commands の mark_quoted）と、印を外す表
MARK, UNMARK = str.maketrans("{},", ""), str.maketrans("", "{},")
BRACE_SEQ = re.compile(r"\{([A-Za-z])\.\.([A-Za-z])(?:\.\.(-?\d+))?\}")  # 文字の連番 {a..c}・{a..z..2}
NUM_SEQ = re.compile(r"\{-?\d+\.\.-?\d+(?:\.\.-?\d+)?\}")  # 数の連番 {1..300}（展開せず、代表の 1 桁に置き換える）
# ヒアドキュメントの始まり: <<（<<- も）と区切りの語（クォート・エスケープを含む 1 語。E"OF" のように一部だけのクォートも）
HEREDOC = re.compile(r"(?<!<)<<(?!<)(-?)[ \t]*((?:'[^'\n]*'|\"[^\"\n]*\"|\\.|[^\s;&|<>()'\"\\])+)")
DELIMITER_QUOTE = re.compile(r"'([^']*)'|\"([^\"]*)\"|\\(.)")  # 区切りの語のクォートとエスケープ（外して連結した語が区切り）
GIT_VALUE_OPTS = {"-c", "-C", "--git-dir", "--work-tree", "--namespace", "--config-env"}  # 次の字句を値に取る git の全体オプション
CONFIG_READ_WORDS = {"--get", "--get-all", "--get-regexp", "--list", "-l"}  # git config の読むだけのオプション（字句で見る側。名前より前だけ）
# git config の書き換えのオプション（値が無くても設定を変える）
CONFIG_MODIFY = {"--unset", "--unset-all", "--replace-all", "--add", "--remove-section", "--rename-section", "-e", "--edit"}
# 設定すると hook が外れうるキー: core.hooksPath と、別の設定ファイルを読み込ませる include.path・includeIf.<条件>.path
GUARDED_KEY, ALIAS_KEY = re.compile(r"core\.hookspath|include\.path|includeif\..*\.path", re.I), re.compile(r"alias\.", re.I)
COMMIT_TREE = re.compile(r"commit-tree")
COPY_COMMANDS = {"cp", "mv", "install", "ln", "rsync"}
COPY_TARGET_OPT = re.compile(r"(?:-[A-Za-z]*t|--target-directory=?)(.*)")  # 行き先のディレクトリを指定するオプション
HOME = r"(?:~|\$HOME|\$\{HOME\}|/home/[^/]+|/Users/[^/]+|/root)"
# git の設定の置き場所: ホーム（か相対）の .gitconfig、git/config（.git/config・~/.config/git/config）、.git、~/.config/git 以下
GIT_CONFIG_DEST = re.compile(
    r"^(?:" + HOME + r"/+|\./)?\.gitconfig$|(?:\bgit/config|(?:^|/)\.git|(?:^|/)\.config/git(?:/.*)?)/?$")
HOME_OR_CONFIG_DIR = re.compile(r"^" + HOME + r"/?$|(?:^|/)\.config/?$")
# hook: ~/.config/git/hooks（$XDG_CONFIG_HOME/git/hooks）とその下、hook の本体 ~/.local/bin/harness-hook と ~/.local/libexec/uv。
# プロジェクトの .git/hooks は、共通の pre-commit が関門を通した後に委譲する先なので含めない（hook の導入を止めない）
GLOBAL_GIT = r"(?:(?:" + HOME + r"/)?\.config|\$\{?XDG_CONFIG_HOME\}?)/git"
HOOK_PATH = re.compile(r"^" + GLOBAL_GIT + r"/hooks(?:/.*)?$|^(?:" + HOME + r"/)?\.local/(?:bin/harness-hook|libexec/uv)$")
# hook を含むディレクトリ（消す・動かすと hook も無くなる）: /、ホーム、~/.config、~/.config/git、~/.local とその bin・libexec、.git
HOOK_ANCESTOR = re.compile(r"^(?:/|" + HOME + r"|" + GLOBAL_GIT + r"|(?:" + HOME + r"/)?\.config|\$\{?XDG_CONFIG_HOME\}?"
                           r"|(?:" + HOME + r"/)?\.local(?:/bin|/libexec)?)$")
REPO_GIT_DIR = re.compile(r"(?:^|/)\.git$")
# 要件の写しとその版の置き場所（requirements-save だけで書く。消す・動かす・上書きすると、承認なしに条件を減らせる）
REQUIREMENTS_STORE = re.compile(r"(?:^|/)" + REQUIREMENTS + r"(?:/|$)|\brequirements-path\b")
REMOVERS = {"rm", "unlink", "shred", "truncate", "rmdir", "chmod", "chattr", "chflags"}  # 消す・権限を変える
WRITERS = {"tee", "sed", "perl", "find"}  # 書く（sed・perl は -i、find は -delete・-exec のときだけ）
IN_PLACE = re.compile(r"-\w*i\S*|--in-place\S*")
FIND_ACTIONS = {"-delete", "-exec", "-execdir", "-ok", "-okdir"}
REDIRECT = re.compile(r"\d*(?:>\||>>?|&>>?|<>)(?!&)")  # 書き込みのリダイレクト（>&2 などの複製は除く）
# hooksPath を含む行で書き込む形は、行き先を問わず拒否する（設定を消した写しを cd の後の相対パスや rsync・sponge で戻す形など）
HOOKSPATH = re.compile(r"hookspath", re.I)
PLACERS = COPY_COMMANDS | {"sponge", "tee", "dd"}  # ファイルを置く・書くコマンド
# ヒアドキュメントの本文をデータとみなせるコマンド（data_only）: 本文を実行しない既知のコマンド。行のコマンドがすべてこれなら、
# 本文の語では拒否しない（記憶の保存・コミットメッセージ・ファイルへの書き出し）。ほかのコマンドがあれば、本文もコマンド行として見る
DATA_COMMANDS = {"cat", "tee", "tinymemory", "harness-hook", "gh", "git", "cd", "mkdir", "echo", "printf", "true", "ls", "chmod", "wc"}
# git と gh は、本文をメッセージ・本文として読むサブコマンドだけ（ほかは alias で何でも実行でき、git apply は本文の中の先に書く）。
# git はオプションも許可リスト（GIT_SAFE_OPT）で見る（-e・-t・-c などは設定済みのエディタを起動する。全体の -p はページャを起動する）
GIT_DATA, GH_DATA = {"commit", "notes", "tag", "add"}, {"pr", "issue", "release", "gist"}
GIT_SAFE_OPT = re.compile(r"-[aqFmAu]+|--(?:file|message|cleanup)(?:=.*)?|--(?:quiet|all|signoff|no-edit|update|annotate)", re.S)
GIT_SAFE_GLOBAL = re.compile(r"-C|--no-pager|--(?:git-dir|work-tree)=.*", re.S)
# commit・tag・notes のメッセージの出どころ（無ければ git はエディタを起動し、エディタは本文を標準入力として受け継ぐ）
MESSAGE_SOURCE = re.compile(r"-[aqAu]*[Fm][aqFmAu]*|--(?:file|message)(?:=.*)?", re.S)
# メッセージ・本文の値として渡す $(cat <<'E' … E)（heredoc_value。本文を除いた後の形）と、その値を取るオプション（git の -m は MESSAGE_OPT）
CAT_HEREDOC = re.compile(r"\$\(\s*cat\s+<<-?[ \t]*(?:'[^'\n]+'|\"[^\"\n]+\"|\\[^\s'\";&|<>()]+)\s*\)")
VALUE_OPTS = {"--message", "-b", "--body", "-t", "--title", "-n", "--notes"}
# gh のエディタを起動するオプション（-e・--editor。束と --ed などの省略形も）
EDIT_OPT = re.compile(r"(?:--e(?:d(?:i(?:t(?:or)?)?)?)?|-[a-zA-Z]*e[a-zA-Z]*)(?:=.*)?", re.S)  # --editor=true などの値付きも
# Claude Code と git から呼ばれる hook のサブコマンド（Bash から直接呼ぶのは拒否する）
HOOK_SUBCOMMANDS = {"turn", "guard-branch", "guard-bash", "bash", "bash-failed", "review-done", "stop", "pre-commit", "post-commit"}
# コマンドを起動する語（この後の harness-hook は起動される）
LAUNCHERS = {"env", "command", "exec", "nohup", "sudo", "doas", "time", "nice", "timeout", "sh", "bash", "zsh", "dash", "ksh",
             "python", "python3", "uv", "uvx", "run"}
# 本文の hooksPath を見る書き込み先（git の設定になりうるもの: config という名前、.git の下、--git-dir・--git-path などで求めた場所）
CONFIG_TARGET = re.compile(r"(?:^|/)(?:config|\.gitconfig)$|(?:^|/)\.git(?:/|$)|git-(?:common-)?dir|git-path")
DOUBLE_QUOTE_ESCAPE = re.compile(r'\\(?:\n|([\\"$`]))')  # " の中で意味のあるエスケープ（\ と改行は行の継続）
# 字句に分けられないとき（クォートの閉じ忘れ等）に、文字列で保守的に見る語
NO_VERIFY_LOOSE = re.compile(r"\s-[aeiopqsvz]*n")
COPY_WORD = re.compile(r"\b(?:cp|mv|install|ln|rsync)\b")
GIT_CONFIG_LOOSE = re.compile(r"\.gitconfig|\bgit/config|\.config/git\b|(?:^|[\s/\"'=])\.git\b")
REVIEWER, ACCEPTOR = "reviewer", "acceptor"
HANDBACK = "SubagentHandback"  # サブエージェントが最終報告を返すツール（デスクトップアプリ）
# reviewer の出力の判定行「<軸>: <判定>」（行頭。箇条書き記号と強調記号は許す）
AXES = ("仕様適合", "テスト", "品質・保守性")
VERDICT_LINE = re.compile(r"^[\s\-*]*(" + "|".join(AXES) + r")\**[:：](.*)$", re.M)
# acceptor の出力の判定行「受け入れ: <判定>」と条件の行「[AC<n>] <状態> — …」（行頭。箇条書き記号と強調記号は許す。
# 「受け入れ検証した版:」の行は判定行ではない）
ACCEPT_LINE = re.compile(r"^[\s\-*]*受け入れ\**[:：](.*)$", re.M)
CRITERION_LINE = re.compile(r"^[\s\-*]*\[AC(\d+)\]\**(.*)$", re.M)
# 報告の版の行「レビューした版: <tree ID>」「受け入れ検証した版: <tree ID>」（skills/review/snapshot.sh の出力。7 桁以上）
REPORT_VERSION = re.compile(r"^[\s\-*]*(?:レビューした版|受け入れ検証した版)\**[:：]\s*`?([0-9a-f]{7,40})\b", re.M)
# 要件の写しの受け入れ条件の番号「AC<n>:」（行頭。箇条書き記号と強調記号は許す）。acceptor の報告の条件の行と突き合わせる
REQUIRED_AC = re.compile(r"^[\s\-*]*AC(\d+)\**[:：]", re.M)
# 受け入れ条件を減らす版の、ユーザーの承認の節（見出し「変更の承認」の直後に、見出しでない中身の行がある）
APPROVAL = re.compile(r"^#+[ \t]*変更の承認[ \t]*\n\s*[^#\s]", re.M)
CRITERIA_HEADING = "条件ごとの結果"  # acceptor の報告の、条件の行を置く節の見出し
HEADING = re.compile(r"^(#+)\s*(.*?)\s*$")
STATUS = re.compile(r"[^\s\-‐-―−]+")  # 条件の状態 = 空白かダッシュ類（- ‐ ‒ – — ― −）の手前まで
PROTECTED = {"main", "master"}
# テスト実行が作る生成物。名前は test_*.pyc でもテストではない（.gitignore が無いリポジトリで指紋に混ざらないようにする）
ARTIFACT = re.compile(r"(^|/)__pycache__/|\.py[co]$")
# テストのディレクトリにあっても、テストの集め方を変えうる設定（テストとして数えず、追加にも証拠を求める）
TEST_CONFIG = re.compile(r"(^|/)(conftest\.py|__init__\.py|pytest\.ini|[^/]*\.config\.[^/]+)$")
# 失敗を RED として記録する、テストを走らせるコマンド（VERIFY_CMD・宣言した行のほかに）: test・tests/・spec を含むもの。
# 読むだけのコマンド（READ_COMMANDS）の失敗は除く（grep の「見つからない」など）
RED_CMD = re.compile(r"(?:^|[\s/])(?:tests?|specs?)(?:[\s/:]|$)|[\w./-]*(?:_test|\.test|_spec|\.spec)\.\w+|\btest_[\w./-]+")
READ_COMMANDS = {"grep", "rg", "ag", "find", "ls", "cat", "head", "tail", "less", "git", "echo", "printf", "sed", "awk", "wc", "diff",
                 "file", "stat", "tree"}
# tinymemory への session の保存（/tinymemory:remember も /wrap-up もこの形）。この時点の使用量を「前回の保存」にする
SAVE_SESSION = re.compile(r"\btinymemory save\b[^\n]*--type[ =]session\b")
# remember させる、前回の保存からの増加（ウィンドウに対する割合）: コミットした（HEAD が動いた）ターンで / 区切りでなくても（同じ起点から 1 回だけ）
REMEMBER_AT_COMMIT, REMEMBER_ANYWAY = 0.3, 0.6
WINDOW = 1_000_000  # 既定のコンテキストウィンドウ（トークン）。環境変数 HARNESS_CONTEXT_WINDOW で変える


def snapshot(top):
    """作業ツリー全体（追跡・未追跡。無視は除く）の tree ID。skills/review/snapshot.sh と同じ求め方（index の複製に add -A して
    write-tree。実 index と作業ツリーは変えない）。求められなければ None"""
    index = git(top, "rev-parse", "--path-format=absolute", "--git-path", "index")
    with tempfile.TemporaryDirectory() as d:
        tmp = os.path.join(d, "index")
        if index and os.path.isfile(index.strip()):
            with open(index.strip(), "rb") as src, open(tmp, "wb") as dst:
                dst.write(src.read())
        env = dict(os.environ, GIT_INDEX_FILE=tmp)
        run = functools.partial(subprocess.run, capture_output=True, env=env, timeout=60)
        if run(["git", "-C", top, "add", "-A"]).returncode:
            return None
        out = run(["git", "-C", top, "write-tree"])
        return out.stdout.decode().strip() if out.returncode == 0 else None


def version_drift(top, report):
    """報告の最後の版の行と、今の作業ツリー全体の版（snapshot）との差のうち、証拠に関わるファイル（is_code か is_test）のパス。
    同じなら []（差がテスト実行の生成物・文書だけでも同じとみなす。検査を走らせた後の __pycache__ など）。
    版の行が無いか、版を比べられなければ None"""
    versions = REPORT_VERSION.findall(report or "")
    now = snapshot(top) if versions else None
    if not now:
        return None
    if now.startswith(versions[-1]):
        return []
    then = git(top, "rev-parse", "--verify", "-q", versions[-1] + "^{tree}")
    out = then and git(top, "diff-tree", "-r", "--name-only", "--no-renames", "-z", then.strip(), now)
    return None if out is None or not then else [p for p in out.split("\0") if p and (is_code(top, p) or is_test(p))]


def subagent_report(data, verdict):
    """reviewer・acceptor の最終報告の本文（verdict はその判定行の正規表現）。通常は SubagentStop の last_assistant_message。
    報告をツール呼び出し（ハンドバック）で返す環境ではそこに判定文が入らないので、その場合は
    サブエージェント自身の記録（agent_transcript_path）から、今回の依頼より後で判定行を含む最後の出力を探す。
    対象は本文とハンドバックだけ（調査中に実行したコマンドの文字列などに含まれる判定行は報告ではない）"""
    text = data.get("last_assistant_message") or ""
    if verdict.search(text):
        return text
    try:
        with open(data.get("agent_transcript_path") or "") as f:
            for line in f:
                try:
                    msg = json.loads(line)["message"]
                    role, blocks = msg["role"], msg["content"]
                except (ValueError, KeyError, TypeError):
                    continue
                blocks = [b for b in blocks if isinstance(b, dict)] if isinstance(blocks, list) else []
                if role == "user":
                    # 新しい依頼（ツール結果ではない user）より前の判定は今回の報告ではない（再開した reviewer の古い承認を拾わない）。
                    # 前提: 途中の注入（system-reminder 等）は user 形式では来ない。来た場合は承認を捨てる側（再レビューで回復）に倒れる
                    if not blocks or any(b.get("type") != "tool_result" for b in blocks):
                        text = ""
                    continue
                for block in blocks if role == "assistant" else []:
                    if block.get("type") == "text":
                        out = block.get("text") or ""
                    elif block.get("type") == "tool_use" and block.get("name") == HANDBACK:
                        args = block.get("input")  # 例: SubagentHandback の message
                        out = "\n".join(v for v in (args.values() if isinstance(args, dict) else []) if isinstance(v, str))
                    else:
                        continue
                    if verdict.search(out):
                        text = out
    except OSError:
        pass
    return text


def approved(text):
    """reviewer の出力が 3 軸とも承認か。fail-closed: 各軸の判定行が 1 行以上あり、そのすべてが「承認」だけであること。
    （「承認できない」、ひな型の「承認 | 修正が必要」、複数ブロックのうち 1 つでも「修正が必要」があれば不承認）"""
    verdicts = {axis: [] for axis in AXES}
    for axis, value in VERDICT_LINE.findall(text):
        verdicts[axis].append(value.strip(" \t\r*"))
    return all(v and all(x == "承認" for x in v) for v in verdicts.values())


def accepted(text, top):
    """acceptor の出力が合格か。fail-closed: 判定行と条件の行がそれぞれ 1 行以上あり、そのすべてが「合格」だけで、
    要件の写しの受け入れ条件の番号がすべて条件の行にあること（写しに無い番号が報告にあるのは構わない。写しに番号が無ければ不合格）。
    条件の行は「条件ごとの結果」の節の中だけを読み（ほかの節の [AC… の行は数えない）、状態は最初の語（空白・ダッシュまで）。
    「不合格」「未確認」「合格ただし…」、複数の判定行のうち 1 つでも「不合格」があれば不合格。
    (合格か, ログの注記: 報告に「合格」で出ていない写しの番号。写しに番号が無ければ unnumbered)"""
    required = required_criteria(top)
    if not required:
        return False, "unnumbered"
    verdicts = [v.strip(" \t\r*") for v in ACCEPT_LINE.findall(text)]
    criteria = []
    for n, rest in criterion_rows(text):
        m = STATUS.match(rest.strip(" \t\r*"))
        criteria.append((n, m.group(0).strip("*") if m else ""))
    lacking = sorted(required - {n for n, status in criteria if status == "合格"})
    ok = not lacking and all(v and all(x == "合格" for x in v) for v in (verdicts, [status for _, status in criteria]))
    return ok, ("lacking=" + ",".join(f"AC{n}" for n in lacking)) if lacking else ""


def criterion_rows(text):
    """「条件ごとの結果」の節（小見出しを含み、同じ深さ以上の見出しで終わる。複数あればすべて）にある、条件の行の
    [(番号, [ACn] より後)]"""
    rows, depth = [], None
    for line in text.splitlines():
        h = HEADING.match(line)
        if h:
            if depth is not None and len(h.group(1)) <= depth:
                depth = None
            if h.group(2) == CRITERIA_HEADING:
                depth = len(h.group(1))
            continue
        m = CRITERION_LINE.match(line) if depth is not None else None
        if m:
            rows.append((int(m.group(1)), m.group(2)))
    return rows


# 証拠を記録するサブエージェントの種類: (報告の判定行, 合格の判定（(報告, top) → (合否, ログの注記)）,
# 記録するキー（ログには <キー>=<合否> <注記>）, git-dir に保存する報告)
JUDGES = {
    REVIEWER: (VERDICT_LINE, lambda report, _top: (approved(report), ""), "reviewed", "harness-last-review"),
    ACCEPTOR: (ACCEPT_LINE, accepted, "accepted", "harness-last-accept"),
}


# ---- 状態 -------------------------------------------------------------------

def state_base():
    base = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    return os.path.join(base, "harness")


def state_dir(*parts):
    d = os.path.join(state_base(), *[re.sub(r"[^A-Za-z0-9_.-]", "_", p or "none") for p in parts])
    os.makedirs(d, exist_ok=True)
    return d


def repo_state(top):
    """キーごとの状態の置き場所。キーは作業ツリーの top（検証済み・受け入れ済み・レビュー済み）か、tracked_state の登録用キー"""
    return state_dir("repo", hashlib.sha1(top.encode()).hexdigest()[:16])


def tracked_state(top):
    """関門の対象かどうかの登録先。リポジトリ単位（worktree は本体と同じ）なので、
    セッションを開いたリポジトリから後で作った worktree も対象になる"""
    common = git(top, "rev-parse", "--path-format=absolute", "--git-common-dir")
    return repo_state("common:" + (common.strip() if common else top))


def put(d, name, value=""):
    with open(os.path.join(d, name), "w") as f:
        f.write(value)


def get(d, name):
    try:
        with open(os.path.join(d, name)) as f:
            return f.read()
    except FileNotFoundError:
        return None


@contextlib.contextmanager
def locked(d):
    """状態の置き場所 d の読み書きを、並列に動く hook（同時に実行した検証コマンドなど）の間で順番にする"""
    with open(os.path.join(d, ".lock"), "w") as f:
        fcntl.flock(f, fcntl.LOCK_EX)
        yield


def log(cmd, data, note=""):
    """呼び出しごとに 1 行（例外で終わったときは error= の行が加わる）。動作確認とデバッグ用（~/.local/state/harness/log）"""
    try:
        ti = data.get("tool_input")
        ti = ti if isinstance(ti, dict) else {}  # 想定外の形の入力でも、ログだけは残す
        what = (ti.get("file_path") or (ti.get("command") or "")[:60] or data.get("agent_type") or "").replace("\n", " ")
        with open(os.path.join(state_base(), "log"), "a") as f:
            f.write(f"{time.strftime('%H:%M:%S')} {(data.get('session_id') or '')[:8]} {cmd:<12} "
                    f"{data.get('tool_name') or data.get('hook_event_name') or ''} {what} {note}\n")
    except Exception:
        pass


def prune(days=7):
    """古いセッションの状態とログを消す（リポジトリ単位の状態は残す）"""
    base = state_base()
    cutoff = time.time() - days * 86400
    try:
        if os.path.getsize(os.path.join(base, "log")) > 1_000_000:
            os.remove(os.path.join(base, "log"))
    except OSError:
        pass
    sessions = os.path.join(base, "session")
    for name in os.listdir(sessions) if os.path.isdir(sessions) else []:
        d = os.path.join(sessions, name)
        start = os.path.join(d, "start")  # ターンごとに書き直すファイルで見る（無ければディレクトリ自体）
        try:
            if os.path.getmtime(start if os.path.exists(start) else d) < cutoff:
                for f in os.listdir(d):
                    os.remove(os.path.join(d, f))
                os.rmdir(d)
        except OSError:
            pass


# ---- git ---------------------------------------------------------------------

def git(cwd, *args, stdin=None, ok=(0,)):
    """git の標準出力。失敗（終了コードが ok に無い）・タイムアウトは None"""
    try:
        r = subprocess.run(["git", "-C", cwd, *args], capture_output=True, input=stdin, timeout=10)
        return r.stdout.decode("utf-8", "surrogateescape") if r.returncode in ok else None
    except Exception:
        return None


def must(out, what):
    """指紋の材料になる git の結果。取れなければ例外（証拠を記録しない／コミットを止める側に倒す）"""
    if out is None:
        raise RuntimeError(f"{what} に失敗")
    return out


def toplevel(path):
    """path を含む git リポジトリのトップレベル。まだ存在しないパスは存在する最も近い親から探す。git 外なら None"""
    while path and not os.path.isdir(path):
        path = os.path.dirname(path)
    out = git(path or ".", "rev-parse", "--show-toplevel")
    return out.strip() if out else None


def git_dir(top, common=False):
    """作業ツリーの git-dir（common=True は worktree で共通の git-common-dir）の絶対パス"""
    flags = ("--path-format=absolute", "--git-common-dir") if common else ("--absolute-git-dir",)
    return must(git(top, "rev-parse", *flags), "git rev-parse").strip()


def has_ref(top, ref):
    return git(top, "rev-parse", "-q", "--verify", ref) is not None


def head(top):
    """HEAD のコミット。git 外や最初のコミット前は空"""
    return (git(top, "rev-parse", "HEAD") or "") if top else ""


def protected_branch(top):
    """作業してはいけないブランチ（main/master）にいればその名前。最初のコミット前（git init 直後）は対象外"""
    out = git(top, "symbolic-ref", "--short", "-q", "HEAD")
    branch = out.strip() if out else None
    return branch if branch in PROTECTED and has_ref(top, "HEAD") else None


# rename 検出は切る（作業ツリー側は「削除 + 未追跡」、インデックス側は「rename」と見え方が変わり、指紋がずれるため）

def working_changes(top):
    """未コミットの変更 [(XY, トップレベル相対パス)]。未追跡は '??'、削除は 'D' を含む。マージ・cherry-pick・revert の途中は、
    自動の結果（auto_result）との差（競合の解消と、後から足した変更）と未追跡のファイル"""
    out = must(git(top, "status", "--porcelain", "-z", "--untracked-files=all", "--no-renames"), "git status")
    changes = [(f[:2], f[3:]) for f in out.split("\0") if len(f) > 3]
    auto = auto_result(top)
    if not auto:
        return changes
    return name_status(must(git(top, "diff", "--name-status", "-z", "--no-renames", auto), "git diff")) + [c for c in changes if c[0] == "??"]


def unstaged_wip(top):
    """未ステージの手元の変更 {パス: 作業ツリーの blob ID（無ければ 'gone'）}: 未追跡のファイルと、追跡済みのファイルの
    インデックスに入れていない変更（コード・テストだけ）"""
    rels = [p for s, p in working_changes(top) if s[0] in " ?" and (is_code(top, p) or is_test(p))]
    return blob_ids(top, rels, staged=False)


def baseline(top):
    """そのブランチで最初に要件の写しを保存したターンの開始時に既にあった、未ステージの手元の変更（写しの横の .baseline。
    利用者の作業中のファイル。Claude がそのターンに作ったもの・ステージ済みのものは入らない）{パス: blob ID}"""
    return dict(line.split("\t", 1)[::-1] for line in (read_bytes(requirements_path(top) + ".baseline") or b"").decode(
        "utf-8", "surrogateescape").splitlines() if "\t" in line)


def working_scope(top):
    """証拠の対象にする作業ツリーの変更: working_changes から、baseline のうち、未ステージのままその後に変えていないものを除く
    （利用者の作業中の変更を残したまま、タスクのファイルだけを部分コミットできるように）。ステージしたら除かない
    （コミット時の staged_changes も除かない）ので、そのファイルをコミットに含めるなら証拠が要る"""
    changes, base = working_changes(top), baseline(top)
    if not base:
        return changes
    ids = blob_ids(top, [p for s, p in changes if s[0] in " ?" and p in base], staged=False)
    return [(s, p) for s, p in changes if s[0] not in " ?" or p not in base or ids.get(p) != base[p]]


def staged_changes(top):
    """ステージ済み（これからコミットされる）変更 [(状態, パス)]。マージ・cherry-pick・revert の途中は、自動の結果との差"""
    return name_status(must(git(top, "diff", "--cached", "--name-status", "-z", "--no-renames", *filter(None, [auto_result(top)])),
                            "git diff --cached"))


def name_status(out):
    """git の --name-status -z の出力を [(状態, パス)] に"""
    fields = [x for x in out.split("\0") if x]
    return list(zip((s[0] for s in fields[0::2]), fields[1::2]))


@functools.lru_cache(maxsize=None)  # 1 回の起動の中で、マージの状態は変わらない
def auto_result(top):
    """マージ・cherry-pick・revert の途中なら、その自動の結果の tree（git merge-tree --write-tree。競合の箇所は印のまま）。
    途中でないか、求められなければ（3 つ以上のマージ、古い git）None（そのときは HEAD との差を変更とみなす）"""
    for ref, base, other in (("MERGE_HEAD", None, "MERGE_HEAD"), ("CHERRY_PICK_HEAD", "CHERRY_PICK_HEAD^", "CHERRY_PICK_HEAD"),
                             ("REVERT_HEAD", "REVERT_HEAD", "REVERT_HEAD^")):
        if has_ref(top, ref):
            if ref == "MERGE_HEAD" and len((read_bytes(os.path.join(git_dir(top), ref)) or b"").split()) != 1:
                return None
            out = git(top, "merge-tree", "--write-tree", *([f"--merge-base={base}"] if base else []), "HEAD", other, ok=(0, 1))
            return out.split()[0] if out else None
    return None


# ---- 内容の読み方（作業ツリー / インデックス）-------------------------------------

def is_test(rel):
    """テストのファイルか。テストのディレクトリにあっても、テストの集め方を変えうる設定（TEST_CONFIG）と生成物（ARTIFACT）は除く"""
    rel = rel.replace(os.sep, "/")
    return bool(TEST_PATH.search(rel)) and not ARTIFACT.search(rel) and not TEST_CONFIG.search(rel)


@functools.lru_cache(maxsize=None)  # ファイルごとの is_code から呼ばれるので、1 回の起動で 1 回だけ読む
def repo_lines(top, name, staged=False):
    """リポジトリのトップの関門の設定（CODE_FILE / VERIFY_FILE。top に git-common-dir を渡せば PRIVATE_VERIFY）の行。
    空行と # で始まる行は除く。無ければ空。staged=True はインデックスの内容（コミット時）"""
    text = (git(top, "show", f":{name}") if staged else get(top, name)) or ""
    return tuple(s for s in (line.strip() for line in text.splitlines()) if s and not s.startswith("#"))


def requirements_path(top):
    """承認済みの要件と受け入れ条件の写しのパス: <git-dir>/harness-requirements/<ブランチ名（/ は _。detached は HEAD）>.md"""
    branch = (git(top, "symbolic-ref", "--short", "-q", "HEAD") or "HEAD").strip()
    return os.path.join(git_dir(top), REQUIREMENTS, branch.replace("/", "_") + ".md")


def read_bytes(path):
    """ファイルの内容（bytes）。無ければ None"""
    try:
        with open(path, "rb") as f:
            return f.read()
    except FileNotFoundError:
        return None


def requirements(top):
    """要件の写しの内容（bytes）。無ければ None"""
    return read_bytes(requirements_path(top))


def requirements_fresh(top):
    """要件の写しを保存した後に、証拠を求める変更（コード）を含むコミットが無いか（requirements-save が写しの横の .head に、
    保存した時の HEAD を書く）。写しを使ったコミットの後の新しいコード変更に、前の依頼の写しを使い回さないため
    （ドキュメントだけのコミットでは古くならない。保存した時の HEAD が無くなっていれば古いとみなす）"""
    saved = read_bytes(requirements_path(top) + ".head")
    if saved is None:
        return False
    saved, now = saved.decode().strip(), head(top).strip()
    if saved == now:
        return True
    out = git(top, "rev-list", "--no-merges", now, *(["--not", saved] if saved else []))
    return out is not None and not any(needs_evidence(top, commit_changes(top, sha)) for sha in out.split())


def required_criteria(top):
    """要件の写しの受け入れ条件の番号（AC<n>: の n）の集合。写しが無いか番号が無ければ空"""
    return criteria_numbers((requirements(top) or b"").decode("utf-8", "replace"))


def criteria_numbers(text):
    """要件の本文 text の受け入れ条件の番号（行頭の AC<n>: の n）の集合"""
    return {int(n) for n in REQUIRED_AC.findall(text)}


def verify_lines(top, staged=False):
    """宣言した検証コマンド: .harness-verify（共有。staged=True はインデックスの版）と <git-common-dir>/harness-verify（自分だけ）の行"""
    return repo_lines(top, VERIFY_FILE, staged) + repo_lines(git_dir(top, common=True), PRIVATE_VERIFY)


def is_code(top, rel, staged=False):
    """関門の対象か: 文書・画像など（DOC_EXT の拡張子、拡張子が無ければ DOC_NAME の名前）と、テスト実行の生成物（ARTIFACT）以外は
    すべて対象。requirements*.txt などの CODE_TXT と、.harness-code のパターンに当たるパスは、文書の拡張子でも対象"""
    name = os.path.basename(rel).lower()
    if ARTIFACT.search(rel.replace(os.sep, "/")):
        return False
    if CODE_TXT.search(rel.replace(os.sep, "/")) or any(fnmatch.fnmatchcase(rel, p) for p in repo_lines(top, CODE_FILE, staged)):
        return True
    ext = os.path.splitext(name)[1]
    return not (ext in DOC_EXT if ext else name in DOC_NAME)


def blob_ids(top, rels, staged, rev=None):
    """{パス: git の blob ID}。作業ツリー側も git hash-object で求めるので、改行変換などの filter を通した
    「コミットされる内容」同士の比較になる。シンボリックリンクはリンク文字列、無いものは 'gone'。
    staged=True はインデックス、rev はそのコミットの内容"""
    ids = {rel: "gone" for rel in rels}
    if staged or rev:
        listing = git(top, "ls-tree", "-r", "-z", rev) if rev else git(top, "ls-files", "-s", "-z")
        for entry in must(listing, "git ls-tree" if rev else "git ls-files").split("\0"):
            meta, _, path = entry.partition("\t")
            if path in ids:
                ids[path] = meta.split()[2 if rev else 1]
        return ids
    files = []
    for rel in rels:
        full = os.path.join(top, rel)
        if os.path.islink(full):
            ids[rel] = must(git(top, "hash-object", "--stdin", stdin=os.readlink(full).encode()), "git hash-object").strip()
        elif os.path.isfile(full):
            files.append(rel)
    if files:
        out = must(git(top, "hash-object", "--stdin-paths", stdin="\n".join(files).encode("utf-8", "surrogateescape")), "git hash-object")
        blobs = out.split()
        if len(blobs) != len(files):
            raise RuntimeError("git hash-object の結果が足りない")
        ids.update(zip(files, blobs))
    return ids


def tree_hash(top, changes, staged=False, rev=None):
    """変更されたコード・テストの内容と、承認済みの要件の写し・自分だけの検証の宣言（<git-common-dir>/harness-verify）で決まる指紋。
    作業ツリー（検証・受け入れ・レビュー時）とインデックス（コミット時）とコミット rev の内容で、同じ内容なら同じ値になる（要件の写しと
    自分だけの宣言は git の外にあるので、どれでも同じファイルを読む）。あとから編集すれば、要件や自分だけの宣言を書き換えても変わる。
    HEAD は含めない（ドキュメントだけ先にコミットしても証拠は有効）"""
    rels = sorted({rel for _, rel in changes if is_code(top, rel, staged) or is_test(rel)})
    ids = blob_ids(top, rels, staged, rev)
    h = hashlib.sha1()
    for rel in rels:
        h.update(f"\0{rel}\0{ids[rel]}".encode("utf-8", "surrogateescape"))
    outside = ((REQUIREMENTS, requirements(top)),
               (PRIVATE_VERIFY, read_bytes(os.path.join(git_dir(top, common=True), PRIVATE_VERIFY))))
    for name, data in outside:  # パスは空にならないので区別できる
        h.update(f"\0\0{name}\0{hashlib.sha1(data).hexdigest() if data is not None else 'missing'}".encode())
    return h.hexdigest()


# ---- 証拠の判定 --------------------------------------------------------------

TEXT = {  # {private} は <git-common-dir>/harness-verify、{requirements} は要件の写しのパス
    "requirements": "承認済みの要件の写しが無いか空 → 承認済みの要件と受け入れ条件の写しを `harness-hook requirements-save` に"
                    "標準入力で渡して保存する（場所: {requirements}。S は依頼の原文と受け入れ条件 1 行）→ /issue",
    "stale": "要件の写しを保存した後にコミット（HEAD の移動）があったので、写しは古い → 同じ依頼の続きなら、同じ内容のままでも "
             "`harness-hook requirements-save` で保存し直す（場所: {requirements}）。新しい依頼なら、新しい要件と受け入れ条件を合意して保存する",
    "undeclared": "検証コマンドを宣言していない（宣言したコマンドの成功だけが検証の証拠になる）→ "
                  "全体の検証コマンドを .harness-verify（共有）か {private}（自分だけ）に 1 行 1 つ書く → /verify",
    "verified": "この内容に対して、宣言した検証コマンド（.harness-verify か {private} に書いたもの）のすべてを単独で成功させていない → /verify",
    "accepted": "この内容に対して受け入れ検証（acceptor が成果物を実際に動かし、要件の写しの受け入れ条件をすべて確かめる）で合格していない → /accept",
    "unnumbered": "要件の写しの受け入れ条件に番号が無い（受け入れは、写しの番号がすべて acceptor の報告に「合格」で出ていることを求める）→ "
                  "受け入れ条件に AC1, AC2 … の番号を付ける（行頭に `AC1: …`）。写しを `harness-hook requirements-save` で保存し直して /accept",
    "reviewed": "この内容に対して reviewer の敵対的レビューで 3 軸（仕様適合・テスト・品質・保守性）とも承認されていない → /review",
}


def at_top(top, cwd, command):
    """command をリポジトリのトップで実行したか: 先頭に cd <行き先> && があればその行き先（cwd から解決。変数などで
    決められなければ違うとみなす）、無ければ cwd がトップか"""
    m = CD_TARGET.match(command.strip())
    where = cwd
    if m:
        target = (m.group(1) or "~").strip().strip("'\"")
        if not target or target == "-" or "$" in target or "`" in target:
            return False
        where = os.path.join(cwd, os.path.expanduser(target))
    return os.path.realpath(where) == os.path.realpath(top)


def verified_runs(top, now):
    """指紋 now の内容に対して成功した検証コマンドの集合。指紋が違えば None。
    verified は 1 行目が指紋、2 行目以降がその指紋で成功したコマンド（指紋が変われば置き換える）"""
    fp, *runs = (get(repo_state(top), "verified") or "").split("\n")
    return set(runs) if fp == now else None


def needs_evidence(top, changed, staged=False):
    """変更 changed [(状態, パス)] に証拠を求めるか: テスト以外のコードと、既存のテストの変更・削除（テストを弱めうる。
    追加 A・未追跡 ?? は除く）。状態は作業ツリーなら XY、ステージ済み・コミットなら 1 文字"""
    return any(("A" not in s and ("M" in s or "D" in s)) if is_test(p) else is_code(top, p, staged) for s, p in changed)


def evidence(top, staged=False):
    """(コード変更があるか, 足りない証拠の一覧, main/master 上か)。
    staged=True はコミット時: これからコミットされる内容（インデックス）で判定する。
    テストが十分か（TDD）は reviewer が内容を読んで判定する。ここではファイル名から推測しない"""
    changed = staged_changes(top) if staged else working_scope(top)
    if not needs_evidence(top, changed, staged):
        return False, [], False
    now = tree_hash(top, changed, staged)
    runs = verified_runs(top, now)
    declared = set(verify_lines(top, staged))
    numbered = bool(required_criteria(top))
    saved = bool((requirements(top) or b"").strip())
    # 宣言が無ければ、何を成功させても検証の証拠にならない（理由には宣言の置き場所を出す）。
    # 写しの受け入れ条件に番号が無ければ、受け入れの証拠にならない（理由には番号の付け方を出す）。
    # 写しを保存した後にコミットがあれば、写しは古い（理由には保存し直すことを出す）
    ok = {("stale" if saved else "requirements"): saved and requirements_fresh(top),
          ("verified" if declared else "undeclared"): bool(declared) and runs is not None and declared <= runs,
          ("accepted" if numbered else "unnumbered"): numbered and get(repo_state(top), "accepted") == now,
          "reviewed": get(repo_state(top), "reviewed") == now}
    return True, [k for k, v in ok.items() if not v], bool(protected_branch(top))


def red_log(top, data, command):
    """失敗した検証コマンドを <git-dir>/harness-red-log に足す。1 件は見出しの行（時刻・その時点の指紋・サブエージェントなら agent_type）と、
    字下げしたコマンドと出力（PostToolUseFailure の error。無ければ tool_response の中身）の先頭 RED_LINES 行。
    直近 RED_KEEP 件・RED_BYTES バイトまでに、古い側から切り詰める"""
    out = data.get("error")
    if not out:
        resp = data.get("tool_response")
        out = "\n".join(v for v in resp.values() if isinstance(v, str)) if isinstance(resp, dict) else resp
    header = f"{time.strftime('%Y-%m-%d %H:%M:%S')} tree={tree_hash(top, working_scope(top))}"
    if data.get("agent_id"):
        header += f" agent={data.get('agent_type')}"
    lines = ("$ " + command).splitlines() + str(out or "").splitlines()[:RED_LINES]
    entry = header + "".join(f"\n  {line}" for line in lines) + "\n"
    d = git_dir(top)
    # 見出しの行だけが字下げなしで始まるので、そこで件に分ける
    entries = ([e for e in re.split(r"(?m)^(?=\S)", get(d, RED_LOG) or "") if e] + [entry])[-RED_KEEP:]
    while len(entries) > 1 and len("".join(entries).encode()) > RED_BYTES:
        entries.pop(0)
    put(d, RED_LOG, "".join(entries))


def reason_text(top, missing, on_main):
    paths = {"private": os.path.join(git_dir(top, common=True), PRIVATE_VERIFY), "requirements": requirements_path(top)}
    parts = [TEXT[k].format(**paths) + drift_note(top, k) for k in missing]
    if on_main:
        parts.insert(0, "main/master 上で変更している → git switch -c <種別>/<名前> で作業ブランチに移す")
    return "コードを変更したが完了条件を満たしていない: " + "／".join(parts) + "。対応してから進める（省略しない）。"


def drift_note(top, key):
    """前回の合格の報告（key: accepted・reviewed）を、報告の版が合わずに記録しなかったときの注記（review-done が <key>-drift に残す）"""
    drift = get(repo_state(top), key + "-drift") if key in ("accepted", "reviewed") else None
    if not drift:
        return ""
    if drift == "?":
        return "（前回の合格の報告は、版の行が無いか版を比べられなかったので記録しなかった → 報告に snapshot.sh の版を書かせる）"
    return f"（前回の合格の報告は、報告の版の後に {drift} が変わっていたので記録しなかった → 変え終えてから、その内容でやり直す）"


def gate_reason(session, top):
    """このターンに関門を通らないコミットがあったか、コードが変わって証拠が足りなければ差し戻しの理由。(理由 or None, ログの注記)"""
    try:
        unguarded = unguarded_commits(session, top)
        if unguarded:
            d = tracked_state(top)  # push の前に見る（次のターンでも、リモートに無い間は push を拒否する）
            with locked(d):
                put(d, UNGATED, "\n".join(dict.fromkeys(((get(d, UNGATED) or "").split() + unguarded)[-GATED_KEEP:])))
            start = (get(session, "head") or "").strip()
            undo = f"`git reset --soft {start[:12]}` で" if start else "最初のコミットを `git update-ref -d HEAD` で取り消して"
            return (f"このターンのコミット {short(unguarded)} は、コミットの関門（pre-commit）を通っていない（リポジトリ側の "
                    "core.hooksPath、HOME・XDG_CONFIG_HOME の差し替え、rebase・cherry-pick などで git の hook が呼ばれなかった）。"
                    f"証拠を確かめていないコード変更のコミットになっている → {undo}変更をステージに戻し、/accept → /verify → /review を"
                    "通してからコミットし直す（作業ツリーの内容が証拠を取った内容と同じなら、既存の証拠のままコミットし直せる。証拠は内容で決まる）。"
                    "戻せない（push 済みなど）なら、その旨をユーザーに報告して終える。"), f"unguarded={unguarded}"
        # このターンでコード・テストの未コミット変更が変わっていなければ何もしない（以前からの変更で差し戻さない）
        if get(session, "start") == tree_hash(top, working_scope(top)):
            return None, "unchanged"
        changed, missing, on_main = evidence(top)
        # ターンを終えてよい場合の一文は Stop だけに付ける（pre-commit の拒否文には出さない）
        reason = (reason_text(top, missing, on_main) + "ユーザーの判断を待つ（質問・裁定・相談）か、バックグラウンドのサブエージェントの"
                  "完了を待つなら、その旨を書いて終えてよい（コミットは pre-commit が止める）。") if changed and (missing or on_main) else None
    except RuntimeError as e:  # 指紋を作れない（読めないファイル等）。証拠を確認できないので一度差し戻す
        missing, on_main, reason = ["?"], False, f"変更の証拠を確認できない（{e}）。読めないファイルなどを解消してから /verify・/accept・/review をやり直す。"
    return reason, f"missing={missing} on_main={on_main}"


# ---- コンテキストの使用量（区切りでの保存）-------------------------------------------

def context_used(path):
    """今のコンテキストの使用量（トークン）: transcript の最後の assistant の usage の input + cache_read + cache_creation。
    サブエージェントの分（isSidechain）と、usage が 0 の合成メッセージは除く。読めなければ None"""
    try:
        with open(path or "", "rb") as f:
            lines = f.read().splitlines()
    except OSError:
        return None
    for line in reversed(lines):
        try:
            d = json.loads(line)
            u = d["message"]["usage"] if d.get("type") == "assistant" and not d.get("isSidechain") else {}
            n = sum(u.get(k) or 0 for k in ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens"))
        except (ValueError, KeyError, TypeError, AttributeError):
            continue
        if n:
            return n
    return None


def remember_reason(data, session, top):
    """前回の tinymemory への保存からコンテキストが溜まっていれば、remember させる理由。(理由 or None, ログの注記)"""
    used = context_used(data.get("transcript_path"))
    if not used:
        return None, "used=?"
    saved = min(int(get(session, "saved") or 0), used)  # compact で縮んだら、縮んだ値から数え直す
    put(session, "saved", str(saved))
    grown = (used - saved) / int(os.environ.get("HARNESS_CONTEXT_WINDOW") or WINDOW)
    committed = head(top) != (get(session, "head") or "")
    note = f"used={used} grown={grown:.0%} committed={committed}"
    if committed and grown >= REMEMBER_AT_COMMIT:
        why = "コミットした区切り"
    elif grown >= REMEMBER_ANYWAY and get(session, "alerted") != str(saved):
        put(session, "alerted", str(saved))
        why = "区切りを待たずに 1 回だけ知らせる"
    else:
        return None, note
    return (f"前回の tinymemory への保存から、コンテキストがウィンドウの {grown:.0%} 増えた（{why}）。"
            "/tinymemory:remember で session だけを保存する（fact と CLAUDE.md への振り分けは /wrap-up で行う）。"
            "このセッションで前に保存した session があれば `tinymemory archive <id>` で外す。"
            "起点の issue があれば、状態と次の手順を 1〜2 行コメントする（tinymemory は端末ごと）。"
            "M/L を締めるところなら、代わりに /wrap-up（session の保存を含む）。"), note


# ---- Bash の迂回の判定 ----------------------------------------------------------

def bypass(command):
    """関門を迂回しうる形の一致（無ければ None）"""
    try:
        return shell_bypass(command)
    except RecursionError:  # 入れ子が深すぎて判定できない。拒否側に倒す
        return re.match(r".{0,60}", command, re.S)


def string_bypass(text):
    """文字列で見る迂回の一致（無ければ None）: BYPASS、--no-verify、コミットを作る git と同じ行での環境の差し替え"""
    return BYPASS.search(text) or NO_VERIFY_LONG.search(text) or (GIT_MAY_COMMIT.search(text) and ENV_SWAP.search(text)) or None


def shell_bypass(text):
    """コマンド行 text の迂回の一致（無ければ None）: string_bypass（文字列で見る形）、コマンドごとの迂回（command_bypass）、
    hooksPath を含む行での書き込み。ヒアドキュメントの本文は抜き出して、コマンド行にシェル等での実行があるときだけ別のコマンド行と
    して見る（split_heredocs。データの本文の語では拒否しない）。字句に分けられなければ（クォートの閉じ忘れ等）、文字列で保守的に見る"""
    main, bodies = split_heredocs(text)
    seen = "\n".join([main, *bodies])  # データの本文を除いた、実行されうる部分
    m = string_bypass(seen)
    if m:
        return m
    try:
        commands = shell_commands(main, mark_quoted=True)
    except (ValueError, IndexError):
        return fallback_bypass(seen)
    for m in (command_bypass(words, text) or (writes(plain(words)) and hookspath_written(plain(words), seen, text))
              for words in commands):
        if m:
            return m
    return next(filter(None, map(shell_bypass, bodies)), None)


def hookspath_written(words, seen, text):
    """書き込むコマンド words の行の hooksPath の一致: 実行されうる部分（seen）にあるか、書き込み先が git の設定になりうる
    （CONFIG_TARGET。cd .git && cat >> config <<E など）なら、データのヒアドキュメントの本文（text）も含めて探す"""
    return HOOKSPATH.search(seen) or (any(map(CONFIG_TARGET.search, words)) and HOOKSPATH.search(text))


def data_only(text):
    """コマンド行 text（ヒアドキュメントの本文を除いたもの）のコマンドが、すべて本文を実行しない既知のコマンド（DATA_COMMANDS。
    git は GIT_DATA のサブコマンドで、全体とサブコマンドのオプションが許可リスト（GIT_SAFE_GLOBAL・GIT_SAFE_OPT）にあるもの、
    gh は GH_DATA のサブコマンドでエディタを起動しないもの）で、環境変数の前置（GIT_EDITOR=… など、プログラムを差し替えうる）と
    コマンド置換（置換の中のヒアドキュメントの出力は、引数や値になる）が無いか。字句に分けられなければ False（本文も見る）"""
    try:
        commands = shell_commands(text)
    except (ValueError, IndexError):
        return False
    for words in commands:
        name = os.path.basename(words[0]) if words else ""
        if name not in DATA_COMMANDS or any(SUBSTITUTION.search(w) and not heredoc_value(words, i) for i, w in enumerate(words)):
            return False
        if name == "git":
            _, _, sub = git_parts(words)
            if (sub >= len(words) or words[sub] not in GIT_DATA
                    or not all(not w.startswith("-") or GIT_SAFE_GLOBAL.fullmatch(w) for w in words[1:sub])
                    or not all(w == "-" or not w.startswith("-") or GIT_SAFE_OPT.fullmatch(w) for w in words[sub + 1:])
                    or (words[sub] != "add" and not any(map(MESSAGE_SOURCE.fullmatch, words[sub + 1:])))):
                return False
        if name == "gh" and (next((w for w in words[1:] if not w.startswith("-")), "") not in GH_DATA
                             or any(map(EDIT_OPT.fullmatch, words[1:]))):
            return False
    return True


def heredoc_value(words, i):
    """words[i]（本文を除いた後の字句）が、メッセージ・本文のオプション（VALUE_OPTS。--message= の形も）の値として渡す
    $(cat <<'E' … E) か（区切りをクォートしたヒアドキュメントの本文は展開されず、そのまま値になるのでデータ）"""
    opt, eq, value = words[i].partition("=")
    if eq and opt.startswith("--"):
        return opt in VALUE_OPTS and bool(CAT_HEREDOC.fullmatch(value))
    return i > 0 and (words[i - 1] in VALUE_OPTS or bool(MESSAGE_OPT.fullmatch(words[i - 1]))) and bool(CAT_HEREDOC.fullmatch(words[i]))


def split_heredocs(text):
    """(ヒアドキュメントの本文を除いたコマンド行, 実行されうる本文のリスト)。<< の後の区切りの語だけの行までが本文
    （<<- は行頭のタブを除いて比べる。区切りの語はシェルと同じく、クォートとエスケープを外して連結した語）。本文を除いたコマンド行が、
    本文を実行しない既知のコマンドだけ（data_only。tinymemory save・git commit -F -・cat > f など）なら本文はデータ。ほかのコマンド
    （sh <<E、cat <<E | sh、read、ファイルに書いて次の行で sh f・./f・make など）やコマンド置換があれば、すべての本文を実行されうると
    みなす。データでも、区切りの語をクォートしていない本文のコマンド置換はシェルが実行するので、その本文は実行されうるとみなす。
    クォートの中の << も本文の始まりとみなす"""
    kept, bodies, expanded = [], [], []  # 本文と区切りの語だけの行は除く（区切りの語はコマンドではない）
    lines = iter(text.split("\n"))
    for line in lines:
        kept.append(line)
        for m in HEREDOC.finditer(line):
            raw = m.group(2)
            delimiter = DELIMITER_QUOTE.sub(lambda q: next(g for g in q.groups() if g is not None), raw)
            body = []
            for b in lines:
                if (b.lstrip("\t") if m.group(1) else b) == delimiter:
                    break
                body.append(b)
            bodies.append("\n".join(body))
            if not DELIMITER_QUOTE.search(raw):  # シェルが展開する本文: コマンド置換の中身だけがコマンド行（# はただの文字）
                expanded += substitutions(bodies[-1])
    main = "\n".join(kept)
    return main, expanded if data_only(main) else bodies


def substitutions(text):
    """text（展開される本文）の中のコマンド置換 $(…)・`…` の中身。`…` の中は \\` \\$ \\\\ のエスケープを外す（\\` は入れ子の置換）。
    閉じていなければ、そこから後をそのまま返す（保守的に見る）"""
    found, i = [], 0
    while True:
        m = SUBSTITUTION.search(text, i)
        if not m:
            return found
        try:
            end = substitution_end(text, m.start())
        except (ValueError, IndexError):
            return found + [text[m.start():]]
        inner = text[m.start() + len(m.group(0)):end - 1]
        found.append(BACKQUOTE_ESCAPE.sub(r"\1", inner) if m.group(0) == "`" else inner)
        i = end


def shell_commands(text, mark_quoted=False):
    """コマンド行を、コマンドごとの字句のリストに分ける。区切りはクォートの外の ; | & 改行と、サブシェルの ( )
    （>& <& &> の & はリダイレクト）。クォートとエスケープは外し（$'…' も）、コマンド置換 $(…)・`…` は中のクォート・入れ子を
    含めてそのまま字句に残す。字句の始まりの # から行末まではコメント。クォートや括弧が閉じていなければ ValueError か IndexError。
    mark_quoted なら、クォート・エスケープの中の { } , に印（MARK）を付ける（ブレース展開されない部分。plain で外す）"""
    commands, words, word, i = [], [], None, 0
    while i < len(text):
        c = text[i]
        separator = c in ";|\n()" or (c == "&" and not (i and text[i - 1] in "<>") and text[i + 1:i + 2] != ">")
        if separator or c in " \t\r":
            if word is not None:
                words.append("".join(word))
                word = None
            if separator and words:
                commands.append(words)
                words = []
            i += 1
            continue
        if c == "#" and word is None:
            end = text.find("\n", i)
            i = end if end >= 0 else len(text)
            continue
        if c == "\\":
            j, piece = i + 2, text[i + 1:i + 2].replace("\n", "")  # \ と改行は行の継続
        elif c == "'":
            j = text.index("'", i + 1) + 1
            piece = text[i + 1:j - 1]
        elif text.startswith("$'", i):
            j = escaped_end(text, i + 2, "'")
            piece = text[i + 2:j - 1]
        elif c == '"':
            j = double_quote_end(text, i)
            piece = DOUBLE_QUOTE_ESCAPE.sub(r"\1", text[i + 1:j - 1])
        elif c == "`" or text.startswith("$(", i):
            j = substitution_end(text, i)
            piece = text[i:j]
        else:
            j, piece = i + 1, c
        if mark_quoted and c in "\\'\"$" and not (c == "$" and text.startswith("$(", i)):
            piece = piece.translate(MARK)
        word = word if word is not None else []  # 空のクォート（-m ""）も 1 字句
        word.append(piece)
        i = j
    if word is not None:
        words.append("".join(word))
    return commands + [words] if words else commands


def escaped_end(text, i, close):
    """text[i] から \\ のエスケープを飛ばして close の文字まで読み、その次の位置"""
    while text[i] != close:
        i += 2 if text[i] == "\\" else 1
    return i + 1


def double_quote_end(text, i):
    """text[i] の " と対になる " の次の位置。中のエスケープとコマンド置換（その中のクォートを含む）を飛ばす"""
    i += 1
    while text[i] != '"':
        if text[i] == "\\":
            i += 2
        elif text[i] == "`" or text.startswith("$(", i):
            i = substitution_end(text, i)
        else:
            i += 1
    return i + 1


def substitution_end(text, i):
    """text[i] から始まるコマンド置換（$(…) か `…`）の終わりの次の位置。中のクォート・エスケープ・入れ子の括弧を飛ばす"""
    if text[i] == "`":
        return escaped_end(text, i + 1, "`")
    depth, i = 0, i + 1
    while True:
        c = text[i]
        if c == "\\":
            i += 2
        elif c == "'":
            i = text.index("'", i + 1) + 1
        elif c == '"':
            i = double_quote_end(text, i)
        elif c == "`" or text.startswith("$(", i):
            i = substitution_end(text, i)
        else:
            depth += {"(": 1, ")": -1}.get(c, 0)
            i += 1
            if not depth:
                return i


def command_bypass(words, line):
    """1 つのコマンドの字句 words（line は元のコマンド行）の迂回の一致（無ければ None）:
    git commit の -n（git のサブコマンドが commit か、-c で commit にした alias のときの、その後。git-commit の後も。
    -m・--message の値はメッセージなので見ない。ただしコマンド置換を含む値は除かない）と、その後の、メッセージの値でない
    コマンド置換（出力が -n などのオプションに展開されうる）、
    空白や区切りを含む字句の中（sh -c・eval の引数、コマンド置換。1 つのコマンド行として同じく見る）、
    クォートを外したコマンドへの string_bypass（--"no-verify" のようにクォートで語を割る形）、git_bypass、
    git の設定を行き先にする cp・mv・install・ln・rsync、tampers_hooks、forges_evidence。
    words は shell_commands(mark_quoted=True) の字句（クォートの中の { } , に印がある）。そのままと、クォートの外のブレースを展開した後
    （git {commit,-n,-m,x}・-{n,m} のように、展開で -n やサブコマンドになる形）の両方で見て、どちらかで当たれば迂回とみなす"""
    expanded = plain([x for w in words for x in brace_words(w)])
    words = plain(words)
    return words_bypass(words, line) or (expanded != words and words_bypass(expanded, line)) or None


def plain(words):
    """shell_commands(mark_quoted=True) の字句から、クォートの中の { } , の印を外す"""
    return [w.translate(UNMARK) for w in words]


def words_bypass(words, line):
    """command_bypass の、字句の並び words 1 通りについての判定"""
    start, parts = len(words), git_parts(words)
    if parts:
        _, settings, sub = parts
        commits = {"commit"} | {k[len("alias."):].lower() for k, v in settings if ALIAS_KEY.match(k) and v.split()[:1] == ["commit"]}
        if sub < len(words) and words[sub].lower() in commits:
            start = sub + 1
    start = min(start, next((i + 1 for i, w in enumerate(words) if os.path.basename(w) == "git-commit"), start))
    is_value = False  # 直前の字句が -m・--message（この字句はメッセージ）
    for i, w in enumerate(words):
        # 値の字句（-m の次）は、それ自体が -m でも次の字句を値にしない（git commit -m -m -n の -n はオプション）
        value = is_value
        is_value = not value and i >= start and bool(MESSAGE_OPT.fullmatch(w))
        if value and not SUBSTITUTION.search(w):
            continue
        inner = SUBSTITUTION.sub(";", w)
        m = ((i >= start and not w.startswith("--") and NO_VERIFY_SHORT.match(w))
             or (i >= start and not value and not MESSAGE_ATTACHED.match(w) and SUBSTITUTION.search(w))
             or (inner != line and COMMAND_LIKE.search(inner) and shell_bypass(inner))
             # コマンド置換の中身（`…` はエスケープを外す。入れ子の置換も、中身をたどって見る）
             or next(filter(None, map(shell_bypass, (s for s in substitutions(w) if s != line))), None))
        if m:
            return m
    return (string_bypass(" ".join(words)) or git_bypass(words) or overwrites_git_config(words) or tampers_hooks(words)
            or forges_evidence(words))


def brace_words(word):
    """字句 word のブレース展開（{a,b} と文字の連番 {a..c}・{a..z..2} を 1 段ずつ。数の連番は -n やサブコマンドの文字を作れないので
    代表の 1 桁 0 に置き換える。外側のブレースは展開する）。空白や区切りを含む字句（クォートの中）は展開しない。展開が BRACE_LIMIT
    語を超えるとき、字句に - が無ければオプションを作れないので展開せずに返し、あれば判定できないので RecursionError（bypass が
    拒否側に倒す）"""
    if COMMAND_LIKE.search(word):
        return [word]
    done, todo = [], [NUM_SEQ.sub("0", word)]
    while todo:
        w = todo.pop()
        m = BRACE.search(w) or BRACE_SEQ.search(w)
        if not m:
            done.append(w)
            continue
        todo += [w[:m.start()] + part + w[m.end():] for part in reversed(brace_parts(m))]
        if len(done) + len(todo) > BRACE_LIMIT:
            if "-" not in word:
                return [word]
            raise RecursionError("ブレース展開が多すぎる")
    return done


def brace_parts(m):
    """ブレース展開の一致 m（BRACE か BRACE_SEQ）の要素。連番は 1 文字の範囲（増分は絶対値）"""
    if m.re is BRACE:
        return m.group(1).split(",")
    a, b, step = ord(m.group(1)), ord(m.group(2)), abs(int(m.group(3) or 1)) or 1
    return [chr(x) for x in range(a, b + (1 if b >= a else -1), step if b >= a else -step)]


def forges_evidence(words):
    """harness-hook の、証拠や状態を記録するサブコマンド（HOOK_SUBCOMMANDS）を直接呼ぶ一致（偽の hook の入力で証拠を作れる。
    Claude Code と git からだけ呼ばれる）。harness-hook がコマンドとして起動される位置（前に代入・オプション・LAUNCHERS だけ）の
    ときだけ見る（echo・grep の引数は通す）。requirements-path・requirements-save は通す"""
    for i, (w, n) in enumerate(zip(words, words[1:])):
        if (os.path.basename(w) == "harness-hook" and n in HOOK_SUBCOMMANDS
                and all(os.path.basename(p) in LAUNCHERS or p.startswith("-") or re.fullmatch(r"\w+=.*", p, re.S) for p in words[:i])):
            return re.match(".+", f"{w} {n}")
    return None


def git_parts(words):
    """git のコマンドの (git の字句の位置, 全体オプション -c・--config-env の設定 [(キー, 値)], サブコマンドの字句の位置)。
    git が無ければ None"""
    at = next((i for i, w in enumerate(words) if os.path.basename(w) == "git"), None)
    if at is None:
        return None
    settings, i = [], at + 1
    while i < len(words) and words[i].startswith("-"):
        option, eq, inline = words[i].partition("=")
        if option in ("-c", "--config-env"):
            settings.append(tuple((inline if eq else (words[i + 1:] or [""])[0]).partition("=")[::2]))
        i += 2 if option in GIT_VALUE_OPTS and not eq else 1
    return at, settings, i


def git_bypass(words):
    """git のコマンドの、クォートを外した字句で見る迂回の一致（無ければ None）: サブコマンドの commit-tree、GUARDED_KEY の設定、
    迂回になる alias の定義（値を git のコマンドとして見る。! のシェルの alias も）。設定は -c・--config-env の値と、
    git config の引数（--get・--list・config get などの読むだけの形は除く）"""
    parts = git_parts(words)
    if not parts:
        return None
    _, options, i = parts
    settings = [(k, v, True) for k, v in options]  # (キー, 値, 書き込むか)。-c・--config-env は値が空でも設定する
    sub, rest = (words[i], words[i + 1:]) if i < len(words) else ("", [])
    before_name = set(itertools.takewhile(lambda w: w.startswith("-"), rest))  # 設定の名前より前のオプション
    if sub == "config" and not (CONFIG_READ_WORDS & before_name or rest[:1] in (["get"], ["list"])):
        # 引数を並びのまま「キーと次の字句（値）」とみなす（--file などの値が混ざってもキーは見落とさない）。値が無く、
        # --unset などの書き換えのオプションも無ければ、読むだけ（git config core.hooksPath）
        modifies = bool(CONFIG_MODIFY & set(rest)) or rest[:1] in (["set"], ["unset"])
        settings += [(w, rest[j + 1] if j + 1 < len(rest) else "", j + 1 < len(rest) or modifies)
                     for j, w in enumerate(rest) if not w.startswith("-")]
    for key, value, writing in settings:
        # alias の値: ! で始まればシェルのコマンド行、それ以外は git のサブコマンドとその引数
        m = ((writing and GUARDED_KEY.fullmatch(key))
             or (ALIAS_KEY.match(key) and shell_bypass(value[1:] if value.startswith("!") else "git " + value)))
        if m:
            return m
    return COMMIT_TREE.fullmatch(sub)


def operands_of(words, at):
    """words[at] のコマンドの (-t・--target-directory の値, オプションでない引数)。-- の後はすべて引数。
    rsync の -t は時刻を保つオプションなので、行き先としては読まない"""
    targets, operands, options, rest = [], [], True, iter(words[at + 1:])
    takes_target = os.path.basename(words[at]) != "rsync"
    for w in rest:
        m = COPY_TARGET_OPT.fullmatch(w) if options and takes_target else None
        if options and w == "--":
            options = False
        elif m:
            targets.append(m.group(1) or next(rest, ""))
        elif not (options and w.startswith("-")):
            operands.append(w)
    return targets, operands


def joined(dirs, sources):
    """行き先がディレクトリのときに書かれる先（行き先 / 元の名前）"""
    return [d.rstrip("/") + "/" + os.path.basename(s.rstrip("/")) for d in dirs for s in sources]


def overwrites_git_config(words):
    """cp・mv・install・ln・rsync で git の設定を行き先にする一致（無ければ None）。行き先は -t・--target-directory の値か、
    それが無ければ最初より後の引数のどれも（後ろに値を取るオプションがあっても見落とさないように）。
    行き先がホームか .config のディレクトリなら、元の名前をつなげた先（~/.gitconfig・~/.config/git）も見る"""
    at = next((i for i, w in enumerate(words) if os.path.basename(w) in COPY_COMMANDS), None)
    if at is None:
        return None
    targets, operands = operands_of(words, at)
    targets = targets or operands[1:]
    candidates = targets + joined([t for t in targets if HOME_OR_CONFIG_DIR.search(t)], operands)
    return next(filter(None, map(GIT_CONFIG_DEST.search, candidates)), None)


def tampers_hooks(words):
    """hook（HOOK_PATH）と git の設定を消す・動かす・権限を変える一致と、hook を差し替える・書き換える一致（無ければ None）:
    rm・unlink・shred・truncate・rmdir・chmod・chattr・chflags の引数、mv の元（hook を含むディレクトリも）、
    mv・cp・install・ln・rsync の行き先（行き先 / 元の名前も）、リダイレクト・tee・sed -i・perl -i・find -delete の先。
    読むだけ（cat・ls・grep・sh -n・test など）と、hook を元にした cp（写しを作る）は通す"""
    for i, w in enumerate(words):
        for m in REDIRECT.finditer(w):
            target = os.path.normpath(w[m.end():] or (words[i + 1:] or [""])[0])
            hit = HOOK_PATH.search(target) or REQUIREMENTS_STORE.search(target)
            if hit:
                return hit
    at = next((i for i, w in enumerate(words) if os.path.basename(w) in REMOVERS | COPY_COMMANDS | WRITERS), None)
    if at is None:
        return None
    name, (targets, operands) = os.path.basename(words[at]), operands_of(words, at)
    removed, written, into = [], [], []
    if name in REMOVERS:
        removed = targets + operands
    elif name in COPY_COMMANDS:
        written = targets or operands[1:]
        into = joined(written, operands)
        if name == "mv":
            removed = operands if targets else operands[:-1]
    elif (name == "tee" or (name == "find" and FIND_ACTIONS & set(words))
          or (name in ("sed", "perl") and any(map(IN_PLACE.fullmatch, words[at + 1:])))):
        written = operands
    checks = ([(p, (HOOK_PATH, HOOK_ANCESTOR, REPO_GIT_DIR, GIT_CONFIG_DEST, REQUIREMENTS_STORE)) for p in removed]
              + [(p, (HOOK_PATH, REQUIREMENTS_STORE)) for p in written] + [(p, (HOOK_PATH, HOOK_ANCESTOR, REQUIREMENTS_STORE)) for p in into])
    return next((m for p, patterns in checks for m in (r.search(os.path.normpath(p)) for r in patterns) if m), None)


def writes(words):
    """字句 words のコマンドが書き込むか: 書き込みのリダイレクト（/dev/null へは除く。空白や区切りを含む字句はクォートの中なので見ない）、
    ファイルを置く・書くコマンド（PLACERS）、sed -i・perl -i"""
    targets = [w[m.end():] or (words[i + 1:] or [""])[0]
               for i, w in enumerate(words) if not COMMAND_LIKE.search(w) for m in REDIRECT.finditer(w)]
    names = {os.path.basename(w) for w in words}
    return (any(t != "/dev/null" for t in targets) or bool(names & PLACERS)
            or bool(names & {"sed", "perl"} and any(map(IN_PLACE.fullmatch, words))))


def fallback_bypass(text):
    """字句に分けられないときの、文字列での保守的な判定（行をまたいでも見る）: git の語より後の commit の語より後の -n、
    cp・mv・install・ln・rsync の語より後の git の設定。最初の語から順に探す（正規表現の後戻りで遅くならないように）"""
    text = text.replace("\\\n", "")
    git = GIT_WORD.search(text)
    commit = git and COMMIT_WORD.search(text, git.end())
    copy = COPY_WORD.search(text)
    return (commit and NO_VERIFY_LOOSE.search(text, commit.end())) or (copy and GIT_CONFIG_LOOSE.search(text, copy.end()))


def deny(reason):
    """PreToolUse でツールの実行を拒否する"""
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PreToolUse", "permissionDecision": "deny", "permissionDecisionReason": reason,
    }}, ensure_ascii=False))


# ---- 本体 --------------------------------------------------------------------

def pre_commit():
    """git の pre-commit hook から。exit 1 でコミットを止める"""
    if not os.environ.get("CLAUDECODE"):
        return 0  # 人の手動コミット、GUI クライアントなどは対象外
    top = toplevel(os.getcwd())
    if not top:
        return 0
    # 対象に登録していない（Claude が cwd にしていない）リポジトリでも、一時ディレクトリの外なら関門を掛ける
    # （親ディレクトリから git -C でコミットした場合など）。一時ディレクトリの中の未登録のもの（テストが作るリポジトリ）は対象外
    if get(tracked_state(top), "tracked") is None and in_temp(top):
        return 0
    # マージ・cherry-pick・revert の途中は、自動の結果との差（競合の解消、後から足した変更）だけが変更（staged_changes）
    changed, missing, on_main = evidence(top, staged=True)
    if changed and (missing or on_main):
        hint = "（レビューした内容と、ステージした内容が一致している必要がある。未ステージ・未追跡のコードやテストがあれば一致しない）"
        wip = sorted(p for _, p in staged_changes(top) if p in baseline(top))
        if wip:
            hint += (f"写しを保存する前からあった手元の変更 {', '.join(wip)} をステージしている → コミットに含めないなら "
                     "`git restore --staged <ファイル>`。含めるなら、ステージしたまま /accept → /verify → /review をやり直す")
        sys.stderr.write("harness: コミットできない。" + reason_text(top, missing, on_main) + hint + "\n")
        return 1
    # 関門を通した。コミットされる tree は post-commit で記録する（リポジトリ自身の pre-commit が、この後でインデックスを書き換えうる）。
    # 判定した時の HEAD も渡す（--amend なら、できたコミットの親はそれと違う）
    put(tracked_state(top), PENDING, f"{os.environ.get('HARNESS_GIT_PID', '')} {head(top).strip()}")
    return 0


def post_commit():
    """git の post-commit hook から（Claude Code からのコミットだけ）。同じ git commit（HARNESS_GIT_PID）の pre-commit が関門を
    通していれば、実際にコミットされた内容を記録する（Stop の突き合わせ用）。-n で pre-commit を飛ばしたコミットは記録しない。
    pre-commit が見たのは判定した時の HEAD との差なので、できたコミットの親がそれと違う（--amend）ときは、付け直したコミットが
    関門を通っていたか、コミットの変更全体に証拠があるか、証拠が要らないときだけ記録する（関門を通っていないコミットを、
    変更なしの --amend で関門を通ったことにしない）"""
    top, pid = toplevel(os.getcwd()), os.environ.get("HARNESS_GIT_PID")
    if not top or not pid:
        return 0
    d = tracked_state(top)
    with locked(d):
        passed_pid, _, before = (get(d, PENDING) or "").partition(" ")
        put(d, PENDING, "")
    if passed_pid != pid:
        return 0
    parent = (git(top, "rev-parse", "-q", "--verify", "HEAD^") or "").strip()
    before_tree = (git(top, "rev-parse", "-q", "--verify", before + "^{tree}") or "").strip() if before else ""
    if (parent == before or before_tree in set((get(d, GATED) or "").split())
            or committed_with_evidence(top, "HEAD") or not needs_evidence(top, commit_changes(top, "HEAD"))):
        record_gated(top)
    return 0


def commit_guard(session, cwd, command):
    """Bash の git commit・git push の前（PreToolUse）の関門の判定。拒否の理由か None。
    commit: そのリポジトリでは共通の pre-commit が呼ばれない（リポジトリ側の core.hooksPath。husky など）なら、ここで作業ツリーの
    変更の証拠を確かめる（git add は同じコマンドの中にありうるので、ステージではなく作業ツリーで見る）。通したコマンドが git の
    SIMPLE_GIT（add・commit と読むだけのもの）だけなら、実行の後（PostToolUse の bash）にできたコミットを、内容が証拠と同じときだけ
    関門を通ったものとして記録する（GUARD_PENDING・record_guarded）。
    push: 関門を通っていないコード変更のコミット（このターンの unguarded_commits と、前のターンに Stop が見つけた UNGATED）が
    リモートに無いまま残っていれば拒否する。merge: main・master の上で（同じコマンド行で前に switch・checkout で移った先も見る）、
    取り込むブランチにそれがあれば拒否する（fast-forward も）"""
    put(session, GUARD_PENDING, "")
    try:
        commands = shell_commands(split_heredocs(command)[0])
    except (ValueError, IndexError):
        return None
    simple = all(w and os.path.basename(w[0]) == "git" and git_parts(w)[2] < len(w) and w[git_parts(w)[2]] in SIMPLE_GIT
                 for w in commands)
    cd = CD_TARGET.match(command.strip())
    base = os.path.join(cwd, os.path.expanduser((cd.group(1) or "~").strip().strip("'\""))) if cd else cwd
    switched = {}  # {top: 同じコマンド行で前に switch・checkout で移った先のブランチ}（merge の取り込み先）
    for words in commands:
        parts = git_parts(words)
        if not parts or parts[2] >= len(words) or words[parts[2]] not in ("commit", "push", "merge", "switch", "checkout"):
            continue
        at, _, sub = parts
        where = next((os.path.join(base, os.path.expanduser(words[i + 1])) for i in range(at + 1, sub - 1) if words[i] == "-C"), base)
        top = toplevel(where)
        if not top:
            continue
        if words[sub] in ("switch", "checkout"):
            target = switch_target(top, words[sub + 1:])
            if target is not None:
                switched[top] = target
        elif words[sub] in ("push", "merge"):
            ungated = set(unguarded_commits(session, top)) | set((get(tracked_state(top), UNGATED) or "").split())
            into = switched.get(top, protected_branch(top))
            if words[sub] == "push":  # どのローカルブランチ（と HEAD）の履歴に残っていても（git push --all・別のブランチから push する形も）
                found = (git(top, "rev-list", "--branches", "HEAD", "--not", "--remotes") or "").split()
            elif into in PROTECTED:  # 取り込む側（オプションとその値以外の引数）にあって、取り込み先に無いもの
                revs = merge_sources(words[sub + 1:])
                if top in switched and any("@{" in r for r in revs):
                    # 移った後の @{-1}・HEAD@{n} は、移る前のこの時点では解決できない → どのブランチにあるものも見る
                    revs = ["--branches", "--remotes", "HEAD"]
                found = [s for rev in revs for s in (git(top, "rev-list", rev, "--not", into) or "").split()]
            else:
                continue
            found = [s for s in dict.fromkeys(found) if s in ungated]
            if found:
                return (f"コミット {short(found)} は、コミットの関門（pre-commit）を通っていないので "
                        f"{'push' if words[sub] == 'push' else into + ' に merge'} しない → "
                        "Stop の差し戻しの手順で戻して証拠をそろえ直すか、ユーザーに報告する")
        elif hooks_overridden(top):
            changed, missing, on_main = evidence(top)
            if changed and (missing or on_main):
                return ("このリポジトリでは共通の pre-commit が呼ばれない（リポジトリ側の core.hooksPath）ので、コミットの前にここで"
                        "確かめた: " + reason_text(top, missing, on_main))
            if simple:
                put(session, GUARD_PENDING, f"{top}\t{head(top).strip()}")
    return None


def merge_sources(args):
    """git merge の引数のうち、取り込むコミットの指定（オプションと、値を取るオプションの値を除いたもの。- は直前のブランチ @{-1}）"""
    revs, skip = [], False
    for a in args:
        if skip or a == "--":
            skip = False
            continue
        if a in MERGE_VALUE_OPTS:
            skip = True
        elif a == "-":
            revs.append("@{-1}")
        elif not a.startswith("-"):
            revs.append(a)
    return revs


def switch_target(top, args):
    """git switch・checkout の引数 args で移る先のブランチ名: 作る形（-c・-b など）はその名前、--detach は ""（どのブランチでもない）、
    - は直前のブランチ。ブランチを移らない形（-- の後のパス、既存のブランチでない引数）は None"""
    if "--" in args:
        return None
    rest = iter(args)
    for a in rest:
        if a in ("-c", "-C", "-b", "-B", "--orphan"):
            return next(rest, None)
        if a in ("--detach", "-d"):
            return ""
        if a == "-":
            return (git(top, "rev-parse", "--abbrev-ref", "@{-1}") or "").strip() or None
        if not a.startswith("-"):
            return a if git(top, "rev-parse", "--verify", "-q", f"refs/heads/{a}") else None
    return None


def record_guarded(session):
    """commit_guard が通した git commit の実行の後（PostToolUse）: HEAD が進んでいれば、そのコミットを関門を通ったものとして記録する"""
    pending = get(session, GUARD_PENDING) or ""
    put(session, GUARD_PENDING, "")
    top, _, before = pending.partition("\t")
    if top and head(top).strip() not in ("", before) and committed_with_evidence(top, "HEAD"):
        record_gated(top)


def committed_with_evidence(top, rev):
    """コミット rev の内容（親との差）が、記録した証拠（宣言した検証すべての成功・受け入れ・レビュー）と同じ指紋か
    （ステージだけ違う内容や、証拠の付いた作業ツリーの一部だけのコミットは違う指紋になる）"""
    now = tree_hash(top, commit_changes(top, rev), rev=rev)
    runs, declared, state = verified_runs(top, now), set(verify_lines(top)), repo_state(top)
    return (bool(declared) and runs is not None and declared <= runs
            and get(state, "accepted") == now and get(state, "reviewed") == now)


def hooks_overridden(top):
    """リポジトリ側（--local・--worktree）の core.hooksPath が、共通の hooks（--global）と違う場所を指しているか"""
    local = (git(top, "config", "--local", "--get", "core.hooksPath") or git(top, "config", "--worktree", "--get", "core.hooksPath")
             or "").strip()
    common = (git(top, "config", "--global", "--get", "core.hooksPath") or "").strip()

    def real(p):
        return os.path.realpath(os.path.join(top, os.path.expanduser(p)))
    return bool(local) and (not common or real(local) != real(common))


def in_temp(path):
    """path が一時ディレクトリ（TMPDIR）の下か"""
    tmp, real = os.path.realpath(tempfile.gettempdir()), os.path.realpath(path)
    return real == tmp or real.startswith(tmp + os.sep)


def record_gated(top):
    """関門を通ってコミットされた HEAD の tree と patch-id を、リポジトリ単位でそれぞれ直近 GATED_KEEP 件まで覚える。
    Stop が、このターンのコミットのうち関門を通らなかったもの（git の hook が呼ばれなかったもの）を見つけるため"""
    d = tracked_state(top)
    for name, value in ((GATED, (git(top, "rev-parse", "HEAD^{tree}") or "").strip()), (GATED_PATCH, patch_id(top, "HEAD"))):
        if value:
            with locked(d):
                put(d, name, "\n".join(((get(d, name) or "").split() + [value])[-GATED_KEEP:]))


def patch_id(top, rev):
    """コミット rev の patch-id（git patch-id --verbatim。空白の違いも別の変更とみなす）。マージ・空の差分・求められなければ None。
    rebase・cherry-pick で付け替えたコミットは、変更が同じなら同じ値になる"""
    diff = git(top, "diff-tree", "-p", "--root", "--no-renames", "--full-index", rev)
    out = diff and git(top, "patch-id", "--verbatim", stdin=diff.encode("utf-8", "surrogateescape"))
    return out.split()[0] if out else None


def unguarded_commits(session, top):
    """このターンに作られたコミット（どのブランチでも、ターン開始時の HEAD とローカルブランチの先端から届かず、コミット時刻が
    ターン開始以降のもの。fetch・pull で取り込んだ他人のコミットは、時刻と、取り込んだ先端（fetched_since）から届くもののうち
    このリポジトリで作っていないもの（created_since）として除く）
    のうち、関門を通ってコミットされた内容（tree）にも、
    関門を通ったコミットの変更（patch-id。rebase・cherry-pick で付け替えたもの）にも無く、証拠を求める変更を含むものの ID。
    マージコミットは、2 つの親の自動の結果（git merge-tree）との差を変更とみなす（自動の結果のままなら対象外）。
    3 つ以上の親のマージは自動の結果を求められないので、最初の親との差を変更とみなす（--no-commit の後に手を加えた形も見落とさない）"""
    since, tips = get(session, "since"), (get(session, "tips") or "").split()
    not_tips = ["--not", *tips] if tips else []
    out = since and git(top, "log", f"--max-age={since}", "--format=%H %T %P", "--branches", "HEAD", *not_tips)
    if not out:
        return []
    # 取り込んだ他人のコミット: ターンの間に fetch・pull で動いたリモート追跡ブランチから届くもののうち、このリポジトリで作っていないもの
    fetched = fetched_since(top, int(since))
    foreign = (set((git(top, "rev-list", f"--max-age={since}", *fetched, *not_tips) or "").split()) - created_since(top, int(since))
               if fetched else set())
    state, found = tracked_state(top), []
    gated, patches = (set((get(state, name) or "").split()) for name in (GATED, GATED_PATCH))
    for sha, tree, *parents in (line.split() for line in out.splitlines()):
        if tree in gated or sha in foreign:
            continue
        changes = None
        if len(parents) >= 2:  # マージ: 自動の結果を求められなければ（3 つ以上の親、merge-tree の無い古い git）最初の親との差
            auto = git(top, "merge-tree", "--write-tree", *parents, ok=(0, 1)) if len(parents) == 2 else None
            base = auto.split()[0] if auto else parents[0]
            changes = name_status(git(top, "diff-tree", "-r", "--name-status", "-z", "--no-renames", base, tree) or "")
        if needs_evidence(top, commit_changes(top, sha) if changes is None else changes) and (changes is not None or patch_id(top, sha) not in patches):
            found.append(sha)
    return found


def fetched_since(top, since):
    """時刻 since（UNIX 時刻）以降に取り込んだコミットの先端: push 以外（fetch・pull など）で動いたリモート追跡ブランチの値と、
    その後に書かれた FETCH_HEAD の値（URL からの fetch・pull はリモート追跡ブランチを動かさない）"""
    found = [sha for ref in (git(top, "for-each-ref", "--format=%(refname)", "refs/remotes") or "").split()
             for sha, message in reflog_since(top, ref, since) if not message.startswith("update by push")]
    path = (git(top, "rev-parse", "--path-format=absolute", "--git-path", "FETCH_HEAD") or "").strip()
    with contextlib.suppress(OSError):
        if path and os.path.getmtime(path) >= since:
            with open(path) as f:
                found += [line.split()[0] for line in f if line.strip()]
    return found


def created_since(top, since):
    """時刻 since 以降にこのリポジトリで作ったコミット: すべての worktree の HEAD とローカルブランチの reflog のうち、コミットを作る
    操作（CREATED。commit・amend・merge・rebase と pull --rebase の pick など・cherry-pick・revert・am）の記録の値"""
    worktrees = [line[len("worktree "):] for line in (git(top, "worktree", "list", "--porcelain") or "").splitlines()
                 if line.startswith("worktree ")] or [top]
    logs = [(w, "HEAD") for w in worktrees] + [(top, ref) for ref in (git(top, "for-each-ref", "--format=%(refname)", "refs/heads") or "").split()]
    return {sha for where, ref in logs for sha, message in reflog_since(where, ref, since) if CREATED.search(message)}


def reflog_since(top, ref, since):
    """ref の reflog のうち、時刻 since 以降の記録 [(値, メッセージ)]（新しい順）"""
    entries = []
    for line in (git(top, "reflog", "show", "--date=unix", "--format=%H %gd %gs", ref) or "").splitlines():
        sha, selector, message = (line.split(" ", 2) + ["", ""])[:3]
        when = selector.rpartition("@{")[2].rstrip("}")
        if not when.isdigit() or int(when) < since:  # reflog は新しい順
            break
        entries.append((sha, message))
    return entries


def short(shas):
    return ", ".join(s[:7] for s in shas)


def commit_changes(top, sha):
    """コミット sha の変更 [(状態, パス)]（最初のコミットは全ファイルの追加）"""
    return name_status(must(git(top, "diff-tree", "-r", "--root", "--no-commit-id", "--name-status", "--no-renames", "-z", sha),
                            "git diff-tree"))


def print_requirements_path():
    """cwd のリポジトリの要件の写しのパスを出す（ディレクトリは作る。ファイルは作らない）。git 外なら exit 1"""
    top = toplevel(os.getcwd())
    if not top:
        sys.stderr.write("harness: git リポジトリの中で実行する\n")
        return 1
    path = requirements_path(top)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    print(path)
    return 0


def save_requirements():
    """標準入力を、cwd のリポジトリの要件の写しとして保存し、パスを出す。.git の下は Claude Code の Write ツールでは
    書けない（保護される）ので、この口から書く。git 外か、入力が空なら何も書かずに exit 1（写しを空で上書きしない）。
    写しはブランチごとなので、main/master の上でも保存しない（ブランチを切った後に保存する）。
    同じ依頼の前の版（.history の最後の版）にあった受け入れ条件の番号が無ければ、「## 変更の承認」の節（ユーザーの承認の引用）が
    無いかぎり保存しない（条件を黙って減らさない）。保存した版はすべて写しの横の .history/<番号>.md に残す（reviewer が最初の版と比べる）。
    前の写しが古い（その後にコード変更のコミットがある）なら新しい依頼とみなし、前の依頼の版は .history.prev に移す。
    保存した時の HEAD を写しの横（.head）に書く（コミットの後は写しが古いとみなす。requirements_fresh）"""
    top = toplevel(os.getcwd())
    text = sys.stdin.read()
    if not top or not text.strip():
        sys.stderr.write("harness: git リポジトリの中で、空でない要件を標準入力で渡す\n")
        return 1
    branch = protected_branch(top)
    if branch:
        sys.stderr.write(f"harness: {branch} の上では要件の写しを保存しない（写しはブランチごと）。"
                         "作業ブランチを切ってから保存する: git switch -c <種別>/<短い名前>\n")
        return 1
    path = requirements_path(top)
    history = path + ".history"
    versions = sorted(os.listdir(history)) if os.path.isdir(history) else []
    previous = read_bytes(os.path.join(history, versions[-1])) if versions else requirements(top)
    if previous is not None and requirements_fresh(top):
        removed = sorted(criteria_numbers(previous.decode("utf-8", "replace")) - criteria_numbers(text))
        if removed and not APPROVAL.search(text):
            sys.stderr.write(f"harness: 前の版にあった受け入れ条件 {', '.join(f'AC{n}' for n in removed)} が無いので保存しない。"
                             "条件を減らす・緩めるにはユーザーの承認が要る → 承認を得て、本文に「## 変更の承認」の節を書き、"
                             "ユーザーの承認の言葉を引用してから保存し直す（条件を足すだけなら要らない）\n")
            return 1
    elif os.path.isdir(history):
        shutil.rmtree(history + ".prev", ignore_errors=True)
        os.rename(history, history + ".prev")
        versions = []
    os.makedirs(history, exist_ok=True)
    put(history, f"{len(versions) + 1:03d}.md", text)
    with open(path, "w") as f:
        f.write(text)
    put(os.path.dirname(path), os.path.basename(path) + ".head", head(top).strip())
    if not os.path.exists(path + ".baseline"):  # 最初の保存のターンの開始時に既にあった手元の変更（working_scope が除く）
        put(os.path.dirname(path), os.path.basename(path) + ".baseline", get(repo_state(top), "turn-wip") or "")
    print(path)
    return 0


def hook(cmd):
    try:
        data = json.load(sys.stdin)
    except Exception:
        return
    try:
        handle(cmd, data)
    except Exception as e:  # hook としては止めない（exit 0）。指紋を作れない（証拠を記録しない）場合などの原因をログに残す
        log(cmd, data, f"error={type(e).__name__}: {e}".replace("\n", " "))


def handle(cmd, data):
    session = state_dir("session", data.get("session_id"))
    cwd = data.get("cwd") or "."
    if cmd not in ("review-done", "stop"):  # この 2 つは結果を添えて 1 行だけ書く
        log(cmd, data)

    # Claude が cwd にして作業しているリポジトリを関門の対象に登録する（ターン開始時だけでなく、途中で cd した場合も）
    top = toplevel(cwd) if cmd in ("turn", "bash", "bash-failed", "review-done", "stop") else None
    if top:
        put(tracked_state(top), "tracked")

    if cmd == "turn":
        put(session, "start", tree_hash(top, working_scope(top)) if top else "")
        if top:  # ターンの開始時に既にある未ステージの手元の変更（写しの最初の保存が .baseline にする）
            put(repo_state(top), "turn-wip", "".join(f"{blob}\t{rel}\n" for rel, blob in unstaged_wip(top).items()))
        put(session, "head", head(top))
        # このターンに作られたコミットを見分ける（unguarded_commits）: 開始の時刻と、HEAD とローカルブランチの先端
        put(session, "since", str(int(time.time())))
        put(session, "tips", " ".join(filter(None, [head(top).strip()] + ((git(top, "for-each-ref", "--format=%(objectname)", "refs/heads")
                                                                         or "").split() if top else []))))
        prune()
    elif cmd == "guard-branch":
        ti = data.get("tool_input") or {}
        top = toplevel(os.path.realpath(ti.get("file_path") or ti.get("notebook_path") or cwd))  # リンク先の実体で判定する
        branch = top and protected_branch(top)
        if branch:
            deny(f"{branch} 上では編集しない。作業別のブランチを切ってから編集する: "
                 "git switch -c <種別>/<短い名前>（大きな作業は claude -w / cw で worktree）")
    elif cmd == "guard-bash":
        command = (data.get("tool_input") or {}).get("command") or ""
        m = bypass(command)
        if m:
            deny(f"コミットの関門を迂回しうる語（一致: {m.group(0)!r}）を含むコマンドは実行しない。"
                 "証拠（/verify の成功、/accept の合格、/review の承認）をそろえてからコミットする。閲覧目的なら語を含まない形に言い換える"
                 "（harness のログは Read ツールで読む）")
        else:
            reason = commit_guard(session, cwd, command)
            if reason:
                deny(reason)
    elif cmd == "bash":
        ti = data.get("tool_input") or {}
        command = ti.get("command") or ""
        resp = data.get("tool_response") or {}
        record_guarded(session)  # Bash の前の判定が通した git commit が、コミットを作っていれば記録する
        # 実際の tool_response は {stdout, stderr, interrupted, …} で exit_code は無い（2.1.285 で確認）。
        # 失敗したコマンドは PostToolUseFailure になるので、ここに来た時点で成功している。
        # 証拠として数えるのは、宣言した行との完全一致だけ（パイプ等を足した形は、終了コードが検証コマンドのものとは限らないので一致させない）
        # 数えるのは、リポジトリのトップで実行したときだけ（下位のディレクトリでは pytest・go test などは下位しか走らない）
        run = CD_PREFIX.sub("", command.strip())
        passed = top and run in verify_lines(top) and at_top(top, cwd, command)
        # サブエージェント内（agent_id あり）の実行は記録しない（検証はセッション自身が行う）
        if (passed and not data.get("agent_id")
                and not ti.get("run_in_background") and not resp.get("backgroundTaskId") and not resp.get("interrupted")):
            with locked(repo_state(top)):  # 並列に実行した検証の記録が、読み書きの競合で落ちないように
                now = tree_hash(top, working_scope(top))
                put(repo_state(top), "verified", "\n".join([now, *sorted((verified_runs(top, now) or set()) | {run})]))
        used = context_used(data.get("transcript_path")) if SAVE_SESSION.search(command) else None
        if used:
            put(session, "saved", str(used))
    elif cmd == "bash-failed":
        # 検証コマンド（パイプ等の形でも、宣言した行でも）が失敗したら、それまでの「検証済み」を消し、RED として記録する
        # （サブエージェント内でも。implementer の RED を観測できるように）
        put(session, GUARD_PENDING, "")  # 失敗したコマンドのコミットは記録しない
        command = (data.get("tool_input") or {}).get("command") or ""
        if top and (VERIFY_CMD.search(command) or CD_PREFIX.sub("", command.strip()) in verify_lines(top)):
            put(repo_state(top), "verified")
            red_log(top, data, command)
        elif top and RED_CMD.search(command) and os.path.basename(CD_PREFIX.sub("", command.strip()).split(" ")[0]) not in READ_COMMANDS:
            red_log(top, data, command)  # テストを走らせるほかのコマンド（manage.py test など）: RED として残すだけ（検証済みは消さない）
    elif cmd == "review-done":
        # reviewer の報告はレビュー、acceptor の報告は受け入れの証拠。ほかの種類は（報告の形が合っていても）記録しない
        judge = JUDGES.get(data.get("agent_type"))
        if not judge:
            log(cmd, data, "skip")
            return
        verdict, passed, key, saved = judge
        report = subagent_report(data, verdict)
        # fail-closed: 判定行がすべて「承認」「合格」のときだけ（空・中断・質問で終わった場合は記録しない）。
        # さらに、報告の版が今の作業ツリー全体の版と同じときだけ（レビュー・受け入れ検証の後に編集した内容には付けない）
        ok, note = passed(report, top) if top else (False, "")
        drift = version_drift(top, report) if ok else []
        if drift != []:  # 合格の報告が記録されない理由を、次の差し戻しの理由に出す（drift_note）
            ok, note = False, (note + " version-mismatch").strip()
            put(repo_state(top), key + "-drift", ", ".join(drift) if drift else "?")
        log(cmd, data, f"{key}={ok} report_chars={len(report)} {note}".rstrip())  # 記録されない時の切り分け用
        # 報告は合否に関わらず、作業ツリーごとの git-dir に保存する（/review fix などで前回の報告として読む）
        gitdir = git(top, "rev-parse", "--absolute-git-dir") if top and report else None
        if gitdir:
            put(gitdir.strip(), saved, report)
        if ok:
            put(repo_state(top), key, tree_hash(top, working_scope(top)))
            put(repo_state(top), key + "-drift")
    elif cmd == "stop":
        if data.get("stop_hook_active"):
            log(cmd, data, "skip")
            return
        reason, note = gate_reason(session, top) if top else (None, "no-repo")
        if not reason:  # 関門の差し戻しが先（remember の判定で例外になっても、関門の差し戻しは消えない）
            reason, more = remember_reason(data, session, top)
            note += " " + more
        log(cmd, data, note)
        if reason:
            print(json.dumps({"decision": "block", "reason": reason}, ensure_ascii=False))


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "pre-commit":
        try:
            sys.exit(pre_commit())
        except Exception as e:  # 判定できない時は止める側に倒す
            sys.stderr.write(f"harness: 判定できないのでコミットを止めた（{e}）\n")
            sys.exit(1)
    if cmd == "post-commit":
        try:
            post_commit()
        except Exception as e:  # コミットは済んでいる。記録できなければ、Stop が関門を通っていないとして 1 回差し戻す
            sys.stderr.write(f"harness: 関門を通ったコミットを記録できなかった（{e}）\n")
        sys.exit(0)
    if cmd == "requirements-path":
        sys.exit(print_requirements_path())
    if cmd == "requirements-save":
        sys.exit(save_requirements())
    try:
        hook(cmd)
    except Exception:
        pass
    sys.exit(0)
