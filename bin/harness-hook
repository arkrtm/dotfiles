#!/bin/sh
"""true"
# sh としての起動部（Python から見ると、ここは何もしない文字列）: uv で自分自身を Python として実行し直す。
# hook を起動する側の PATH の並びや、mise の shim（cwd の mise 設定で壊れうる）に左右されないよう、
# install.sh が置く ~/.local/libexec/uv を直接使う（無ければ exit 127。PATH の uv には落とさない）
exec "$HOME/.local/libexec/uv" run --script --quiet "$0" "$@"
"""
# /// script
# requires-python = ">=3.9"
# ///
"""Claude Code の自作ハーネス: コードを変えたら、承認済みの要件の写しと、検証・受け入れ・レビュー（TDD を含む）の証拠がそろうまで
コミットも完了もさせない。
あわせて、コンテキストが溜まったら区切りで tinymemory に session を保存させる（compact や clear で流れが落ちないように）。

これは「うっかり・手抜きを止めるガードレール」であり、セキュリティ境界ではない。Bash を使えるエージェントが
意図的に迂回すること（commit-tree、git 設定の差し替え、証拠ファイルの書き換え等）は原理的に防ぎ切れない。
代表的な迂回語は拒否するが、最終的には CLAUDE.md の規則（迂回しない）に依る。

Claude Code の hooks から:
  harness-hook turn          UserPromptSubmit  ターン開始。開始時点の作業ツリーの指紋と HEAD を記録する
  harness-hook guard-branch  PreToolUse        Edit/Write。git の main/master 上なら編集を拒否（作業別ブランチの強制）
  harness-hook guard-bash    PreToolUse        Bash。関門を迂回する語（--no-verify 等）を含めば拒否
  harness-hook bash          PostToolUse       Bash。宣言した検証コマンド（.harness-verify と <git-common-dir>/harness-verify の行）が
                                               単独で成功したら、その時点の作業ツリーに「検証済み」（宣言した行がすべて同じ内容で成功した
                                               ときだけ証拠になる。宣言が無ければ何を成功させても証拠にならない。サブエージェント内の実行は記録しない）。
                                               tinymemory に session を保存したら、その時点のコンテキストの使用量を「前回の保存」に
  harness-hook bash-failed   PostToolUseFailure Bash。検証コマンド（VERIFY_CMD の形はパイプ等の形でも、宣言した行も）が失敗したら、
                                               その作業ツリーの「検証済み」を消し、出力の先頭を <git-dir>/harness-red-log に残す
                                               （サブエージェント内も。implementer の RED を観測できるように）
  harness-hook review-done   SubagentStop      reviewer / acceptor の報告を <git-dir>/harness-last-review / harness-last-accept に保存する（合否に関わらず）。
                                               reviewer が 3 軸（仕様適合・テスト・品質・保守性）とも「承認」で終了したら、その時点の作業ツリーに「レビュー済み」。
                                               acceptor が受け入れ条件（[AC<n>]）と判定のすべてを「合格」で終了したら「受け入れ済み」
  harness-hook stop          Stop              このターンにコード（既存のテストの変更・削除を含む）が変わり、証拠が足りなければ 1 回だけ差し戻す。
                                               差し戻さないときは、前回の保存からコンテキストが溜まっていれば 1 回だけ差し戻して remember させる
  （turn / bash / bash-failed / review-done / stop は、cwd のリポジトリを関門の対象に登録する）
git から（core.hooksPath = ~/.config/git/hooks の pre-commit → run-hook）:
  harness-hook pre-commit    Claude Code からのコミット（環境変数 CLAUDECODE あり）で、対象に登録済みのリポジトリのとき、
                             ステージ済みの内容に証拠が足りなければ exit 1。人の手動コミットや、テストが作る一時リポジトリは対象外
skill・手元から:
  harness-hook requirements-path  cwd のリポジトリの、承認済みの要件と受け入れ条件の写しの置き場所
                             （<git-dir>/harness-requirements/<ブランチ名>.md）を出す。ディレクトリは作り、ファイルは作らない
  harness-hook requirements-save  標準入力をその写しとして保存し、パスを出す（.git の下は Write ツールでは書けないため。
                             空の入力では上書きしない）

コードかどうかは拡張子・ファイル名・shebang と、リポジトリのトップの .harness-code（fnmatch のパターン）で決める
（.harness-code と .harness-verify 自体もコード）。
判定は git の状態に基づく（Edit ツールでも sed -i でも同じ）。検証・受け入れ・レビューは「どの内容に対して行ったか」を
変更ファイルの blob ID と要件の写しの指紋で覚える（git add の前後や改行変換で変わらない。あとから編集すれば、要件を書き換えても無効になる）。
コードを変えているのに要件の写しが無い（空）か、検証コマンドの宣言が無ければ、それだけで証拠は足りない。
証拠は作業ツリー単位、対象の登録はリポジトリ単位（worktree は本体と共通）で ~/.local/state/harness/repo/<id>/ に、ターンの開始状態と前回の保存はセッション単位で持つ。
依存は uv だけ（先頭の起動部が uv で Python を用意する。uv が無いと起動できず exit 127）。
起動できれば、hook としては失敗しても常に exit 0（pre-commit だけが exit 1 を返す）。
"""
import fnmatch
import functools
import hashlib
import json
import os
import re
import subprocess
import sys
import time

# 「コード」とみなす拡張子（これ以外で拡張子が無いものは shebang で判定）。ここにも CODE_NAME・.harness-code にも無いファイルは関門の対象外
CODE_EXT = {
    ".py", ".ipynb", ".js", ".mjs", ".cjs", ".ts", ".tsx", ".jsx", ".vue", ".svelte", ".rs", ".go", ".rb", ".java",
    ".kt", ".scala", ".swift", ".c", ".cc", ".cpp", ".h", ".hpp", ".cs", ".php", ".lua", ".ex", ".exs", ".dart",
    ".sh", ".zsh", ".sql", ".mts", ".cts", ".bash", ".json", ".toml", ".yaml", ".yml", ".ini", ".cfg",
}
# 拡張子に関わらずコードとみなすファイル名（大文字小文字は区別しない）
CODE_NAME = {"dockerfile", "makefile", "justfile"}
# リポジトリのトップに置く関門の設定（1 行 1 項目。空行と # で始まる行は無視）。関門を黙って弱められないよう、これ自体もコード
#   .harness-code    コードとみなすパスの fnmatch パターン（* は / にも当たる。例: config/claude/*）
#   .harness-verify  検証コマンドの宣言（共有）。<git-common-dir>/harness-verify（自分だけ。リポジトリに置けないとき。書式は同じ）の行と
#                    合わせて、すべてが同じ内容で成功したときだけ「検証済み」（宣言に無いコマンドは証拠にならない。宣言が無ければ検証済みにならない）
CODE_FILE, VERIFY_FILE, PRIVATE_VERIFY = ".harness-code", ".harness-verify", "harness-verify"
# <git-dir> の下に残す、失敗した検証コマンドの記録（RED の観測用）: 1 件の出力の行数、残す件数、全体の上限（バイト）
RED_LOG, RED_LINES, RED_KEEP, RED_BYTES = "harness-red-log", 15, 50, 100_000
# <git-dir> の下の、承認済みの要件と受け入れ条件の写しの置き場所（中に <ブランチ名>.md）
REQUIREMENTS = "harness-requirements"
# テストとみなすパス（テストだけの変更は関門の対象外にする。指紋には含める）
TEST_PATH = re.compile(
    r"(^|/)(?i:tests?|spec|__tests__)/|(^|/)[^/]*\.(?i:tests?)/"  # tests/、Tests/、Foo.Tests/
    r"|(^|/)(test_[^/]+|[^/]+_test\.[^/]+|[^/]+\.(test|spec)\.[^/]+|[^/]+_spec\.[^/]+|[^/]*[a-z0-9]Tests?\.[^/]+)$"  # FooTest.java 等
)
# コマンド位置: 行頭か && の直後。その後に command/exec/sudo/time/nice/env/timeout N の前置と VAR=val の前置を許す
CMD_POS = r"(?:^|&&\s*)(?:(?:command|exec|sudo|time|nice|env|timeout \S+)\s+)*(?:\w+=\S*\s+)*"
# 検証コマンドの形。失敗したら「検証済み」を消し、RED として記録する（成功は証拠にしない。証拠は宣言したコマンドの成功だけ）
VERIFY_CMD = re.compile(
    CMD_POS + r"(?:\S*/)?(?:"
    r"(?:uv run (?:--?\S+ (?:[^-\s]\S* )?)*|uvx |poetry run |pdm run |bundle exec |npx |pnpm |yarn |bun |bunx )?"
    r"(?:python3?(?:\.\d+)? -m )?"
    r"(?:pytest|unittest|tox|ruff check|mypy|pyright|jest|vitest|eslint|tsc|prettier --check|shellcheck|phpunit|rspec)\b"
    r"|cargo (?:test|check|clippy|build)\b|go (?:test|vet|build)\b|swift test\b|dotnet test\b|node --test\b"
    r"|mix test\b|dart test\b|flutter test\b|sbt (?:\S+ )*test\b"
    r"|(?:npm|pnpm|yarn|bun) (?:test|lint|run (?:test|lint|typecheck|check|build))\b"
    r"|(?:make|just) (?:-C \S+ )?(?:test|check|lint)\b|gradlew? (?:\S+ )*(?:test|check)\b|mvn (?:\S+ )*(?:test|verify)\b"
    r"|(?:(?:sh|bash) (?:-[eux]+ )?)?[^\s=]*tests?/[^\s=]+"  # tests/ 配下のスクリプトの実行（sh -n は構文チェックなので不可）
    r")"
)
# 宣言した検証コマンドの行と比べる前に取り除く、先頭の「cd <引数> && 」（比べるのは残りと行の完全一致。パイプ等を足した形は一致しない）
CD_PREFIX = re.compile(r"^cd\b[^&;|\n]*&&\s*")
# Bash で関門を迂回する代表的な語（シェル構文は解釈せず部分文字列で見る。誤検知は許容。網羅はできない）。
# --no-verify はその省略形も（--no-verbose は除く）。環境変数は大文字の名前だけ: GIT_CONFIG* は指定する形（VAR=、export、env）、
# CLAUDECODE は消す・書き換える形（env -u、unset、export -n、CLAUDECODE=）だけを拒否する（読むだけの形は通す）
BYPASS = re.compile(
    r"--no-v(?:e(?:r(?:i(?:fy?)?)?)?)?\b|\bgit\b[^|;&\n]*\bcommit\b[^|;&\n]*\s-[a-z]*n[a-z]*\b|commit-tree|hookspath|state/harness"
    r"|(?-i:\bGIT_CONFIG\w*=|\b(?:export|env)\b[^|;&\n]*\bGIT_CONFIG"
    r"|-u\s*CLAUDECODE\b|\b(?:unset|export\s+-n)\b[^|;&\n]*\bCLAUDECODE\b|\bCLAUDECODE=)",
    re.I,
)
REVIEWER, ACCEPTOR = "reviewer", "acceptor"
HANDBACK = "SubagentHandback"  # サブエージェントが最終報告を返すツール（デスクトップアプリ）
# reviewer の出力の判定行「<軸>: <判定>」（行頭。箇条書き記号と強調記号は許す）
AXES = ("仕様適合", "テスト", "品質・保守性")
VERDICT_LINE = re.compile(r"^[\s\-*]*(" + "|".join(AXES) + r")\**[:：](.*)$", re.M)
# acceptor の出力の判定行「受け入れ: <判定>」と条件の行「[AC<n>] <状態> — …」（行頭。箇条書き記号と強調記号は許す。
# 「受け入れ検証した版:」の行は判定行ではない）
ACCEPT_LINE = re.compile(r"^[\s\-*]*受け入れ\**[:：](.*)$", re.M)
CRITERION_LINE = re.compile(r"^[\s\-*]*\[AC\d+\]\**(.*)$", re.M)
CRITERIA_HEADING = "条件ごとの結果"  # acceptor の報告の、条件の行を置く節の見出し
HEADING = re.compile(r"^(#+)\s*(.*?)\s*$")
STATUS = re.compile(r"[^\s\-‐-―−]+")  # 条件の状態 = 空白かダッシュ類（- ‐ ‒ – — ― −）の手前まで
PROTECTED = {"main", "master"}
# テスト実行が作る生成物。名前は test_*.pyc でもテストではない（.gitignore が無いリポジトリで指紋に混ざらないようにする）
ARTIFACT = re.compile(r"(^|/)__pycache__/|\.py[co]$")
# tinymemory への session の保存（/tinymemory:remember も /wrap-up もこの形）。この時点の使用量を「前回の保存」にする
SAVE_SESSION = re.compile(r"\btinymemory save\b[^\n]*--type[ =]session\b")
# remember させる、前回の保存からの増加（ウィンドウに対する割合）: コミットした（HEAD が動いた）ターンで / 区切りでなくても（同じ起点から 1 回だけ）
REMEMBER_AT_COMMIT, REMEMBER_ANYWAY = 0.3, 0.6
WINDOW = 1_000_000  # 既定のコンテキストウィンドウ（トークン）。環境変数 HARNESS_CONTEXT_WINDOW で変える


def subagent_report(data, verdict):
    """reviewer・acceptor の最終報告の本文（verdict はその判定行の正規表現）。通常は SubagentStop の last_assistant_message。
    報告をツール呼び出し（ハンドバック）で返す環境ではそこに判定文が入らないので、その場合は
    サブエージェント自身の記録（agent_transcript_path）から、今回の依頼より後で判定行を含む最後の出力を探す。
    対象は本文とハンドバックだけ（調査中に実行したコマンドの文字列などに含まれる判定行は報告ではない）"""
    text = data.get("last_assistant_message") or ""
    if verdict.search(text):
        return text
    try:
        with open(data.get("agent_transcript_path") or "") as f:
            for line in f:
                try:
                    msg = json.loads(line)["message"]
                    role, blocks = msg["role"], msg["content"]
                except (ValueError, KeyError, TypeError):
                    continue
                blocks = [b for b in blocks if isinstance(b, dict)] if isinstance(blocks, list) else []
                if role == "user":
                    # 新しい依頼（ツール結果ではない user）より前の判定は今回の報告ではない（再開した reviewer の古い承認を拾わない）。
                    # 前提: 途中の注入（system-reminder 等）は user 形式では来ない。来た場合は承認を捨てる側（再レビューで回復）に倒れる
                    if not blocks or any(b.get("type") != "tool_result" for b in blocks):
                        text = ""
                    continue
                for block in blocks if role == "assistant" else []:
                    if block.get("type") == "text":
                        out = block.get("text") or ""
                    elif block.get("type") == "tool_use" and block.get("name") == HANDBACK:
                        args = block.get("input")  # 例: SubagentHandback の message
                        out = "\n".join(v for v in (args.values() if isinstance(args, dict) else []) if isinstance(v, str))
                    else:
                        continue
                    if verdict.search(out):
                        text = out
    except OSError:
        pass
    return text


def approved(text):
    """reviewer の出力が 3 軸とも承認か。fail-closed: 各軸の判定行が 1 行以上あり、そのすべてが「承認」だけであること。
    （「承認できない」、ひな型の「承認 | 修正が必要」、複数ブロックのうち 1 つでも「修正が必要」があれば不承認）"""
    verdicts = {axis: [] for axis in AXES}
    for axis, value in VERDICT_LINE.findall(text):
        verdicts[axis].append(value.strip(" \t\r*"))
    return all(v and all(x == "承認" for x in v) for v in verdicts.values())


def accepted(text):
    """acceptor の出力が合格か。fail-closed: 判定行と条件の行がそれぞれ 1 行以上あり、そのすべてが「合格」だけであること。
    条件の行は「条件ごとの結果」の節の中だけを読み（ほかの節の [AC… の行は数えない）、状態は最初の語（空白・ダッシュまで）。
    「不合格」「未確認」「合格ただし…」、複数の判定行のうち 1 つでも「不合格」があれば不合格"""
    verdicts = [v.strip(" \t\r*") for v in ACCEPT_LINE.findall(text)]
    criteria = []
    for rest in criterion_rows(text):
        m = STATUS.match(rest.strip(" \t\r*"))
        criteria.append(m.group(0).strip("*") if m else "")
    return all(v and all(x == "合格" for x in v) for v in (verdicts, criteria))


def criterion_rows(text):
    """「条件ごとの結果」の節（小見出しを含み、同じ深さ以上の見出しで終わる。複数あればすべて）にある、条件の行の [ACn] より後"""
    rows, depth = [], None
    for line in text.splitlines():
        h = HEADING.match(line)
        if h:
            if depth is not None and len(h.group(1)) <= depth:
                depth = None
            if h.group(2) == CRITERIA_HEADING:
                depth = len(h.group(1))
            continue
        m = CRITERION_LINE.match(line) if depth is not None else None
        if m:
            rows.append(m.group(1))
    return rows


# 証拠を記録するサブエージェントの種類: (報告の判定行, 合格の判定（ログには <関数名>=<結果>）, 記録するキー, git-dir に保存する報告)
JUDGES = {
    REVIEWER: (VERDICT_LINE, approved, "reviewed", "harness-last-review"),
    ACCEPTOR: (ACCEPT_LINE, accepted, "accepted", "harness-last-accept"),
}


# ---- 状態 -------------------------------------------------------------------

def state_base():
    base = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    return os.path.join(base, "harness")


def state_dir(*parts):
    d = os.path.join(state_base(), *[re.sub(r"[^A-Za-z0-9_.-]", "_", p or "none") for p in parts])
    os.makedirs(d, exist_ok=True)
    return d


def repo_state(top):
    """キーごとの状態の置き場所。キーは作業ツリーの top（検証済み・受け入れ済み・レビュー済み）か、tracked_state の登録用キー"""
    return state_dir("repo", hashlib.sha1(top.encode()).hexdigest()[:16])


def tracked_state(top):
    """関門の対象かどうかの登録先。リポジトリ単位（worktree は本体と同じ）なので、
    セッションを開いたリポジトリから後で作った worktree も対象になる"""
    common = git(top, "rev-parse", "--path-format=absolute", "--git-common-dir")
    return repo_state("common:" + (common.strip() if common else top))


def put(d, name, value=""):
    with open(os.path.join(d, name), "w") as f:
        f.write(value)


def get(d, name):
    try:
        with open(os.path.join(d, name)) as f:
            return f.read()
    except FileNotFoundError:
        return None


def log(cmd, data, note=""):
    """呼び出しごとに 1 行（例外で終わったときは error= の行が加わる）。動作確認とデバッグ用（~/.local/state/harness/log）"""
    try:
        ti = data.get("tool_input")
        ti = ti if isinstance(ti, dict) else {}  # 想定外の形の入力でも、ログだけは残す
        what = (ti.get("file_path") or (ti.get("command") or "")[:60] or data.get("agent_type") or "").replace("\n", " ")
        with open(os.path.join(state_base(), "log"), "a") as f:
            f.write(f"{time.strftime('%H:%M:%S')} {(data.get('session_id') or '')[:8]} {cmd:<12} "
                    f"{data.get('tool_name') or data.get('hook_event_name') or ''} {what} {note}\n")
    except Exception:
        pass


def prune(days=7):
    """古いセッションの状態とログを消す（リポジトリ単位の状態は残す）"""
    base = state_base()
    cutoff = time.time() - days * 86400
    try:
        if os.path.getsize(os.path.join(base, "log")) > 1_000_000:
            os.remove(os.path.join(base, "log"))
    except OSError:
        pass
    sessions = os.path.join(base, "session")
    for name in os.listdir(sessions) if os.path.isdir(sessions) else []:
        d = os.path.join(sessions, name)
        start = os.path.join(d, "start")  # ターンごとに書き直すファイルで見る（無ければディレクトリ自体）
        try:
            if os.path.getmtime(start if os.path.exists(start) else d) < cutoff:
                for f in os.listdir(d):
                    os.remove(os.path.join(d, f))
                os.rmdir(d)
        except OSError:
            pass


# ---- git ---------------------------------------------------------------------

def git(cwd, *args, stdin=None):
    """git の標準出力。失敗・タイムアウトは None"""
    try:
        r = subprocess.run(["git", "-C", cwd, *args], capture_output=True, input=stdin, timeout=10)
        return r.stdout.decode("utf-8", "surrogateescape") if r.returncode == 0 else None
    except Exception:
        return None


def must(out, what):
    """指紋の材料になる git の結果。取れなければ例外（証拠を記録しない／コミットを止める側に倒す）"""
    if out is None:
        raise RuntimeError(f"{what} に失敗")
    return out


def toplevel(path):
    """path を含む git リポジトリのトップレベル。まだ存在しないパスは存在する最も近い親から探す。git 外なら None"""
    while path and not os.path.isdir(path):
        path = os.path.dirname(path)
    out = git(path or ".", "rev-parse", "--show-toplevel")
    return out.strip() if out else None


def git_dir(top, common=False):
    """作業ツリーの git-dir（common=True は worktree で共通の git-common-dir）の絶対パス"""
    flags = ("--path-format=absolute", "--git-common-dir") if common else ("--absolute-git-dir",)
    return must(git(top, "rev-parse", *flags), "git rev-parse").strip()


def has_ref(top, ref):
    return git(top, "rev-parse", "-q", "--verify", ref) is not None


def head(top):
    """HEAD のコミット。git 外や最初のコミット前は空"""
    return (git(top, "rev-parse", "HEAD") or "") if top else ""


def protected_branch(top):
    """作業してはいけないブランチ（main/master）にいればその名前。最初のコミット前（git init 直後）は対象外"""
    out = git(top, "symbolic-ref", "--short", "-q", "HEAD")
    branch = out.strip() if out else None
    return branch if branch in PROTECTED and has_ref(top, "HEAD") else None


# rename 検出は切る（作業ツリー側は「削除 + 未追跡」、インデックス側は「rename」と見え方が変わり、指紋がずれるため）

def working_changes(top):
    """未コミットの変更 [(XY, トップレベル相対パス)]。未追跡は '??'、削除は 'D' を含む"""
    out = must(git(top, "status", "--porcelain", "-z", "--untracked-files=all", "--no-renames"), "git status")
    return [(f[:2], f[3:]) for f in out.split("\0") if len(f) > 3]


def staged_changes(top):
    """ステージ済み（これからコミットされる）変更 [(状態, パス)]"""
    out = must(git(top, "diff", "--cached", "--name-status", "-z", "--no-renames"), "git diff --cached")
    fields = [x for x in out.split("\0") if x]
    return list(zip((s[0] for s in fields[0::2]), fields[1::2]))


# ---- 内容の読み方（作業ツリー / インデックス）-------------------------------------

def head_bytes(top, rel, staged, n=2):
    """ファイル先頭の n バイト。シンボリックリンクはリンクそのもの（git が記録する内容）として扱う"""
    if staged:
        out = git(top, "show", f":{rel}")
        return out.encode("utf-8", "surrogateescape")[:n] if out is not None else b""
    full = os.path.join(top, rel)
    if os.path.islink(full):
        return os.readlink(full).encode()[:n]
    try:
        with open(full, "rb") as f:
            return f.read(n)
    except OSError:
        return b""


def is_test(rel):
    rel = rel.replace(os.sep, "/")
    return bool(TEST_PATH.search(rel)) and not ARTIFACT.search(rel)


@functools.lru_cache(maxsize=None)  # ファイルごとの is_code から呼ばれるので、1 回の起動で 1 回だけ読む
def repo_lines(top, name, staged=False):
    """リポジトリのトップの関門の設定（CODE_FILE / VERIFY_FILE。top に git-common-dir を渡せば PRIVATE_VERIFY）の行。
    空行と # で始まる行は除く。無ければ空。staged=True はインデックスの内容（コミット時）"""
    text = (git(top, "show", f":{name}") if staged else get(top, name)) or ""
    return tuple(s for s in (line.strip() for line in text.splitlines()) if s and not s.startswith("#"))


def requirements_path(top):
    """承認済みの要件と受け入れ条件の写しのパス: <git-dir>/harness-requirements/<ブランチ名（/ は _。detached は HEAD）>.md"""
    branch = (git(top, "symbolic-ref", "--short", "-q", "HEAD") or "HEAD").strip()
    return os.path.join(git_dir(top), REQUIREMENTS, branch.replace("/", "_") + ".md")


def requirements(top):
    """要件の写しの内容（bytes）。無ければ None"""
    try:
        with open(requirements_path(top), "rb") as f:
            return f.read()
    except FileNotFoundError:
        return None


def verify_lines(top, staged=False):
    """宣言した検証コマンド: .harness-verify（共有。staged=True はインデックスの版）と <git-common-dir>/harness-verify（自分だけ）の行"""
    return repo_lines(top, VERIFY_FILE, staged) + repo_lines(git_dir(top, common=True), PRIVATE_VERIFY)


def is_code(top, rel, staged=False):
    """関門の設定ファイル自体、CODE_NAME のファイル名、.harness-code のパターン、拡張子で判定。
    拡張子が無いファイルは先頭の shebang（#!）でスクリプトとみなす。
    削除や shebang の書き換えも検出できるよう、変更後だけでなく HEAD 側の内容も見る"""
    if (rel in (CODE_FILE, VERIFY_FILE) or os.path.basename(rel).lower() in CODE_NAME
            or any(fnmatch.fnmatchcase(rel, p) for p in repo_lines(top, CODE_FILE, staged))):
        return True
    _, ext = os.path.splitext(rel)
    if ext:
        return ext.lower() in CODE_EXT
    if head_bytes(top, rel, staged) == b"#!":
        return True
    before = git(top, "show", f"HEAD:{rel}")
    return before is not None and before[:2] == "#!"


def blob_ids(top, rels, staged):
    """{パス: git の blob ID}。作業ツリー側も git hash-object で求めるので、改行変換などの filter を通した
    「コミットされる内容」同士の比較になる。シンボリックリンクはリンク文字列、無いものは 'gone'"""
    ids = {rel: "gone" for rel in rels}
    if staged:
        for entry in must(git(top, "ls-files", "-s", "-z"), "git ls-files").split("\0"):
            meta, _, path = entry.partition("\t")
            if path in ids:
                ids[path] = meta.split()[1]
        return ids
    files = []
    for rel in rels:
        full = os.path.join(top, rel)
        if os.path.islink(full):
            ids[rel] = must(git(top, "hash-object", "--stdin", stdin=os.readlink(full).encode()), "git hash-object").strip()
        elif os.path.isfile(full):
            files.append(rel)
    if files:
        out = must(git(top, "hash-object", "--stdin-paths", stdin="\n".join(files).encode("utf-8", "surrogateescape")), "git hash-object")
        blobs = out.split()
        if len(blobs) != len(files):
            raise RuntimeError("git hash-object の結果が足りない")
        ids.update(zip(files, blobs))
    return ids


def tree_hash(top, changes, staged=False):
    """変更されたコード・テストの内容と、承認済みの要件の写しで決まる指紋。作業ツリー（検証・受け入れ・レビュー時）とインデックス（コミット時）で、
    同じ内容なら同じ値になる（要件の写しは git の外にあるので、どちらでも同じファイルを読む）。あとから編集すれば、要件を書き換えても変わる。
    HEAD は含めない（ドキュメントだけ先にコミットしても証拠は有効）"""
    rels = sorted({rel for _, rel in changes if is_code(top, rel, staged) or is_test(rel)})
    ids = blob_ids(top, rels, staged)
    req = requirements(top)
    h = hashlib.sha1()
    for rel in rels:
        h.update(f"\0{rel}\0{ids[rel]}".encode("utf-8", "surrogateescape"))
    h.update(f"\0\0{REQUIREMENTS}\0{hashlib.sha1(req).hexdigest() if req is not None else 'missing'}".encode())  # パスは空にならないので区別できる
    return h.hexdigest()


# ---- 証拠の判定 --------------------------------------------------------------

TEXT = {  # {private} は <git-common-dir>/harness-verify、{requirements} は要件の写しのパス
    "requirements": "承認済みの要件の写しが無いか空 → 承認済みの要件と受け入れ条件の写しを `harness-hook requirements-save` に"
                    "標準入力で渡して保存する（場所: {requirements}。S は依頼の原文と受け入れ条件 1 行）→ /issue",
    "undeclared": "検証コマンドを宣言していない（宣言したコマンドの成功だけが検証の証拠になる）→ "
                  "全体の検証コマンドを .harness-verify（共有）か {private}（自分だけ）に 1 行 1 つ書く → /verify",
    "verified": "この内容に対して、宣言した検証コマンド（.harness-verify か {private} に書いたもの）のすべてを単独で成功させていない → /verify",
    "accepted": "この内容に対して受け入れ検証（acceptor が成果物を実際に動かし、受け入れ条件を確かめる）で合格していない → /accept",
    "reviewed": "この内容に対して reviewer の敵対的レビューで 3 軸（仕様適合・テスト・品質・保守性）とも承認されていない → /review",
}


def verified_runs(top, now):
    """指紋 now の内容に対して成功した検証コマンドの集合。指紋が違えば None。
    verified は 1 行目が指紋、2 行目以降がその指紋で成功したコマンド（指紋が変われば置き換える）"""
    fp, *runs = (get(repo_state(top), "verified") or "").split("\n")
    return set(runs) if fp == now else None


def evidence(top, staged=False):
    """(コード変更があるか, 足りない証拠の一覧, main/master 上か)。
    staged=True はコミット時: これからコミットされる内容（インデックス）で判定する。
    テストが十分か（TDD）は reviewer が内容を読んで判定する。ここではファイル名から推測しない"""
    changed = staged_changes(top) if staged else working_changes(top)
    # 証拠を求める変更: テスト以外のコードと、既存のテストの変更・削除（テストを弱めうる。追加 A・未追跡 ?? は除く）。
    # 状態 s は作業ツリーなら XY、ステージ済みなら 1 文字
    if not any(("A" not in s and ("M" in s or "D" in s)) if is_test(p) else is_code(top, p, staged) for s, p in changed):
        return False, [], False
    now = tree_hash(top, changed, staged)
    runs = verified_runs(top, now)
    declared = set(verify_lines(top, staged))
    # 宣言が無ければ、何を成功させても検証の証拠にならない（理由には宣言の置き場所を出す）
    ok = {"requirements": bool((requirements(top) or b"").strip()),
          ("verified" if declared else "undeclared"): bool(declared) and runs is not None and declared <= runs,
          "accepted": get(repo_state(top), "accepted") == now,
          "reviewed": get(repo_state(top), "reviewed") == now}
    return True, [k for k, v in ok.items() if not v], bool(protected_branch(top))


def red_log(top, data, command):
    """失敗した検証コマンドを <git-dir>/harness-red-log に足す。1 件は見出しの行（時刻・その時点の指紋・サブエージェントなら agent_type）と、
    字下げしたコマンドと出力（PostToolUseFailure の error。無ければ tool_response の中身）の先頭 RED_LINES 行。
    直近 RED_KEEP 件・RED_BYTES バイトまでに、古い側から切り詰める"""
    out = data.get("error")
    if not out:
        resp = data.get("tool_response")
        out = "\n".join(v for v in resp.values() if isinstance(v, str)) if isinstance(resp, dict) else resp
    header = f"{time.strftime('%Y-%m-%d %H:%M:%S')} tree={tree_hash(top, working_changes(top))}"
    if data.get("agent_id"):
        header += f" agent={data.get('agent_type')}"
    lines = ("$ " + command).splitlines() + str(out or "").splitlines()[:RED_LINES]
    entry = header + "".join(f"\n  {line}" for line in lines) + "\n"
    d = git_dir(top)
    # 見出しの行だけが字下げなしで始まるので、そこで件に分ける
    entries = ([e for e in re.split(r"(?m)^(?=\S)", get(d, RED_LOG) or "") if e] + [entry])[-RED_KEEP:]
    while len(entries) > 1 and len("".join(entries).encode()) > RED_BYTES:
        entries.pop(0)
    put(d, RED_LOG, "".join(entries))


def reason_text(top, missing, on_main):
    paths = {"private": os.path.join(git_dir(top, common=True), PRIVATE_VERIFY), "requirements": requirements_path(top)}
    parts = [TEXT[k].format(**paths) for k in missing]
    if on_main:
        parts.insert(0, "main/master 上で変更している → git switch -c <種別>/<名前> で作業ブランチに移す")
    return "コードを変更したが完了条件を満たしていない: " + "／".join(parts) + "。対応してから進める（省略しない）。"


def gate_reason(session, top):
    """このターンにコードが変わり、証拠が足りなければ差し戻しの理由。(理由 or None, ログの注記)"""
    try:
        # このターンでコード・テストの未コミット変更が変わっていなければ何もしない（以前からの変更で差し戻さない）
        if get(session, "start") == tree_hash(top, working_changes(top)):
            return None, "unchanged"
        changed, missing, on_main = evidence(top)
        # ターンを終えてよい場合の一文は Stop だけに付ける（pre-commit の拒否文には出さない）
        reason = (reason_text(top, missing, on_main) + "ユーザーの判断を待つ（質問・裁定・相談）か、バックグラウンドのサブエージェントの"
                  "完了を待つなら、その旨を書いて終えてよい（コミットは pre-commit が止める）。") if changed and (missing or on_main) else None
    except RuntimeError as e:  # 指紋を作れない（読めないファイル等）。証拠を確認できないので一度差し戻す
        missing, on_main, reason = ["?"], False, f"変更の証拠を確認できない（{e}）。読めないファイルなどを解消してから /verify・/accept・/review をやり直す。"
    return reason, f"missing={missing} on_main={on_main}"


# ---- コンテキストの使用量（区切りでの保存）-------------------------------------------

def context_used(path):
    """今のコンテキストの使用量（トークン）: transcript の最後の assistant の usage の input + cache_read + cache_creation。
    サブエージェントの分（isSidechain）と、usage が 0 の合成メッセージは除く。読めなければ None"""
    try:
        with open(path or "", "rb") as f:
            lines = f.read().splitlines()
    except OSError:
        return None
    for line in reversed(lines):
        try:
            d = json.loads(line)
            u = d["message"]["usage"] if d.get("type") == "assistant" and not d.get("isSidechain") else {}
            n = sum(u.get(k) or 0 for k in ("input_tokens", "cache_read_input_tokens", "cache_creation_input_tokens"))
        except (ValueError, KeyError, TypeError, AttributeError):
            continue
        if n:
            return n
    return None


def remember_reason(data, session, top):
    """前回の tinymemory への保存からコンテキストが溜まっていれば、remember させる理由。(理由 or None, ログの注記)"""
    used = context_used(data.get("transcript_path"))
    if not used:
        return None, "used=?"
    saved = min(int(get(session, "saved") or 0), used)  # compact で縮んだら、縮んだ値から数え直す
    put(session, "saved", str(saved))
    grown = (used - saved) / int(os.environ.get("HARNESS_CONTEXT_WINDOW") or WINDOW)
    committed = head(top) != (get(session, "head") or "")
    note = f"used={used} grown={grown:.0%} committed={committed}"
    if committed and grown >= REMEMBER_AT_COMMIT:
        why = "コミットした区切り"
    elif grown >= REMEMBER_ANYWAY and get(session, "alerted") != str(saved):
        put(session, "alerted", str(saved))
        why = "区切りを待たずに 1 回だけ知らせる"
    else:
        return None, note
    return (f"前回の tinymemory への保存から、コンテキストがウィンドウの {grown:.0%} 増えた（{why}）。"
            "/tinymemory:remember で session だけを保存する（fact と CLAUDE.md への振り分けは /wrap-up で行う）。"
            "このセッションで前に保存した session があれば `tinymemory archive <id>` で外す。"
            "起点の issue があれば、状態と次の手順を 1〜2 行コメントする（tinymemory は端末ごと）。"
            "M/L を締めるところなら、代わりに /wrap-up（session の保存を含む）。"), note


def deny(reason):
    """PreToolUse でツールの実行を拒否する"""
    print(json.dumps({"hookSpecificOutput": {
        "hookEventName": "PreToolUse", "permissionDecision": "deny", "permissionDecisionReason": reason,
    }}, ensure_ascii=False))


# ---- 本体 --------------------------------------------------------------------

def pre_commit():
    """git の pre-commit hook から。exit 1 でコミットを止める"""
    if not os.environ.get("CLAUDECODE"):
        return 0  # 人の手動コミット、GUI クライアントなどは対象外
    top = toplevel(os.getcwd())
    if not top or get(tracked_state(top), "tracked") is None:
        return 0  # Claude が作業していないリポジトリ（テストが作る一時リポジトリなど）は対象外
    if any(has_ref(top, ref) for ref in ("MERGE_HEAD", "CHERRY_PICK_HEAD", "REVERT_HEAD")):
        return 0  # 競合解消の締めのコミットは対象外（取り込む側の差分全体に証拠を求めない）
    changed, missing, on_main = evidence(top, staged=True)
    if changed and (missing or on_main):
        hint = "（レビューした内容と、ステージした内容が一致している必要がある。未ステージ・未追跡のコードやテストがあれば一致しない）"
        sys.stderr.write("harness: コミットできない。" + reason_text(top, missing, on_main) + hint + "\n")
        return 1
    return 0


def print_requirements_path():
    """cwd のリポジトリの要件の写しのパスを出す（ディレクトリは作る。ファイルは作らない）。git 外なら exit 1"""
    top = toplevel(os.getcwd())
    if not top:
        sys.stderr.write("harness: git リポジトリの中で実行する\n")
        return 1
    path = requirements_path(top)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    print(path)
    return 0


def save_requirements():
    """標準入力を、cwd のリポジトリの要件の写しとして保存し、パスを出す。.git の下は Claude Code の Write ツールでは
    書けない（保護される）ので、この口から書く。git 外か、入力が空なら何も書かずに exit 1（写しを空で上書きしない）"""
    top = toplevel(os.getcwd())
    text = sys.stdin.read()
    if not top or not text.strip():
        sys.stderr.write("harness: git リポジトリの中で、空でない要件を標準入力で渡す\n")
        return 1
    path = requirements_path(top)
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write(text)
    print(path)
    return 0


def hook(cmd):
    try:
        data = json.load(sys.stdin)
    except Exception:
        return
    try:
        handle(cmd, data)
    except Exception as e:  # hook としては止めない（exit 0）。指紋を作れない（証拠を記録しない）場合などの原因をログに残す
        log(cmd, data, f"error={type(e).__name__}: {e}".replace("\n", " "))


def handle(cmd, data):
    session = state_dir("session", data.get("session_id"))
    cwd = data.get("cwd") or "."
    if cmd not in ("review-done", "stop"):  # この 2 つは結果を添えて 1 行だけ書く
        log(cmd, data)

    # Claude が cwd にして作業しているリポジトリを関門の対象に登録する（ターン開始時だけでなく、途中で cd した場合も）
    top = toplevel(cwd) if cmd in ("turn", "bash", "bash-failed", "review-done", "stop") else None
    if top:
        put(tracked_state(top), "tracked")

    if cmd == "turn":
        put(session, "start", tree_hash(top, working_changes(top)) if top else "")
        put(session, "head", head(top))
        prune()
    elif cmd == "guard-branch":
        ti = data.get("tool_input") or {}
        top = toplevel(os.path.realpath(ti.get("file_path") or ti.get("notebook_path") or cwd))  # リンク先の実体で判定する
        branch = top and protected_branch(top)
        if branch:
            deny(f"{branch} 上では編集しない。作業別のブランチを切ってから編集する: "
                 "git switch -c <種別>/<短い名前>（大きな作業は claude -w / cw で worktree）")
    elif cmd == "guard-bash":
        m = BYPASS.search((data.get("tool_input") or {}).get("command") or "")
        if m:
            deny(f"コミットの関門を迂回しうる語（一致: {m.group(0)!r}）を含むコマンドは実行しない。"
                 "証拠（/verify の成功、/accept の合格、/review の承認）をそろえてからコミットする。閲覧目的なら語を含まない形に言い換える"
                 "（harness のログは Read ツールで読む）")
    elif cmd == "bash":
        ti = data.get("tool_input") or {}
        command = ti.get("command") or ""
        resp = data.get("tool_response") or {}
        # 実際の tool_response は {stdout, stderr, interrupted, …} で exit_code は無い（2.1.285 で確認）。
        # 失敗したコマンドは PostToolUseFailure になるので、ここに来た時点で成功している。
        # 証拠として数えるのは、宣言した行との完全一致だけ（パイプ等を足した形は、終了コードが検証コマンドのものとは限らないので一致させない）
        run = CD_PREFIX.sub("", command.strip())
        passed = top and run in verify_lines(top)
        # サブエージェント内（agent_id あり）の実行は記録しない（検証はセッション自身が行う）
        if (passed and not data.get("agent_id")
                and not ti.get("run_in_background") and not resp.get("backgroundTaskId") and not resp.get("interrupted")):
            now = tree_hash(top, working_changes(top))
            put(repo_state(top), "verified", "\n".join([now, *sorted((verified_runs(top, now) or set()) | {run})]))
        used = context_used(data.get("transcript_path")) if SAVE_SESSION.search(command) else None
        if used:
            put(session, "saved", str(used))
    elif cmd == "bash-failed":
        # 検証コマンド（パイプ等の形でも、宣言した行でも）が失敗したら、それまでの「検証済み」を消し、RED として記録する
        # （サブエージェント内でも。implementer の RED を観測できるように）
        command = (data.get("tool_input") or {}).get("command") or ""
        if top and (VERIFY_CMD.search(command) or CD_PREFIX.sub("", command.strip()) in verify_lines(top)):
            put(repo_state(top), "verified")
            red_log(top, data, command)
    elif cmd == "review-done":
        # reviewer の報告はレビュー、acceptor の報告は受け入れの証拠。ほかの種類は（報告の形が合っていても）記録しない
        judge = JUDGES.get(data.get("agent_type"))
        if not judge:
            log(cmd, data, "skip")
            return
        verdict, passed, key, saved = judge
        report = subagent_report(data, verdict)
        # fail-closed: 判定行がすべて「承認」「合格」のときだけ（空・中断・質問で終わった場合は記録しない）
        ok = bool(top) and passed(report)
        log(cmd, data, f"{passed.__name__}={ok} report_chars={len(report)}")  # 記録されない時の切り分け用
        # 報告は合否に関わらず、作業ツリーごとの git-dir に保存する（/review fix などで前回の報告として読む）
        gitdir = git(top, "rev-parse", "--absolute-git-dir") if top and report else None
        if gitdir:
            put(gitdir.strip(), saved, report)
        if ok:
            put(repo_state(top), key, tree_hash(top, working_changes(top)))
    elif cmd == "stop":
        if data.get("stop_hook_active"):
            log(cmd, data, "skip")
            return
        reason, note = gate_reason(session, top) if top else (None, "no-repo")
        if not reason:  # 関門の差し戻しが先（remember の判定で例外になっても、関門の差し戻しは消えない）
            reason, more = remember_reason(data, session, top)
            note += " " + more
        log(cmd, data, note)
        if reason:
            print(json.dumps({"decision": "block", "reason": reason}, ensure_ascii=False))


if __name__ == "__main__":
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    if cmd == "pre-commit":
        try:
            sys.exit(pre_commit())
        except Exception as e:  # 判定できない時は止める側に倒す
            sys.stderr.write(f"harness: 判定できないのでコミットを止めた（{e}）\n")
            sys.exit(1)
    if cmd == "requirements-path":
        sys.exit(print_requirements_path())
    if cmd == "requirements-save":
        sys.exit(save_requirements())
    try:
        hook(cmd)
    except Exception:
        pass
    sys.exit(0)
