#!/usr/bin/env python3
"""Claude Code hooks: コードを変えたターンは TDD・検証・レビューの証拠がそろうまで完了させない。

  harness-hook turn         UserPromptSubmit  ターン開始。このターンの活動記録を消す
  harness-hook guard-branch PreToolUse        Edit/Write。git の main/master 上なら編集を拒否（作業別ブランチの強制）
  harness-hook guard-commit PreToolUse        Bash。git commit なのに証拠が足りなければ拒否（未検証コードをリポジトリに入れない）
  harness-hook edit         PostToolUse       Edit/Write。活動あり
  harness-hook bash         PostToolUse       Bash。活動あり。検証コマンドが成功したら、その時点の差分に対して「検証済み」
  harness-hook review-done  SubagentStop      reviewer が終了したら、その時点の差分に対して「レビュー済み」
  harness-hook stop         Stop              このターンに活動があり、git 上にコード変更があるのに証拠が足りなければ 1 回だけ差し戻す

判定は git の状態に基づく（Edit ツールでも sed -i でも同じ）。検証・レビューは「どの差分に対して行ったか」を
ハッシュで覚え、あとから編集すれば自動で無効になる。状態は ~/.local/state/harness/<session_id>/。
依存なし、失敗しても常に exit 0。
"""
import hashlib
import json
import os
import re
import subprocess
import sys
import time

CODE_EXT = {
    ".py", ".js", ".mjs", ".cjs", ".ts", ".tsx", ".jsx", ".rs", ".go", ".rb", ".java", ".kt",
    ".swift", ".c", ".cc", ".cpp", ".h", ".hpp", ".cs", ".php", ".lua", ".sh", ".zsh", ".sql",
}
TEST_PATH = re.compile(r"(^|/)(tests?|spec|__tests__)/|(^|/)(test_[^/]+|[^/]+_test\.[^/]+|[^/]+\.(test|spec)\.[^/]+|[^/]+_spec\.[^/]+)$")
# 「証拠」とみなす検証コマンド。ls tests のような閲覧は含めない
VERIFY_CMD = re.compile(
    r"(^|[;&|]\s*)("
    r"(uv run |poetry run |pdm run |npx |pnpm |yarn |bun |bunx |python3? -m |\.venv/bin/python -m )?"
    r"(pytest|unittest|ruff|mypy|pyright|jest|vitest|eslint|tsc|prettier --check|shellcheck)\b"
    r"|cargo (test|check|clippy|build)\b|go (test|vet|build)\b"
    r"|(npm|pnpm|yarn|bun) (test|run (test|lint|typecheck|check|build))\b"
    r"|make (test|check|lint)\b|dotnet test\b|rspec\b|(sh|bash|zsh) -n\b"
    r"|(sh|bash) \S*tests?/|nvim --headless\b"
    r")"
)
REVIEWER = "reviewer"
PROTECTED = {"main", "master"}


# ---- 状態 -------------------------------------------------------------------

def state_base():
    base = os.environ.get("XDG_STATE_HOME") or os.path.expanduser("~/.local/state")
    return os.path.join(base, "harness")


def state_dir(session):
    d = os.path.join(state_base(), re.sub(r"[^A-Za-z0-9_.-]", "_", session or "nosession"))
    os.makedirs(d, exist_ok=True)
    return d


def put(d, name, value=""):
    with open(os.path.join(d, name), "w") as f:
        f.write(value)


def get(d, name):
    try:
        with open(os.path.join(d, name)) as f:
            return f.read()
    except FileNotFoundError:
        return None


def unmark(d, name):
    try:
        os.remove(os.path.join(d, name))
    except FileNotFoundError:
        pass


def log(cmd, data, note=""):
    """呼び出しごとに 1 行。動作確認とデバッグ用（~/.local/state/harness/log）"""
    try:
        ti = data.get("tool_input") or {}
        what = ti.get("file_path") or (ti.get("command") or "")[:60] or data.get("agent_type") or ""
        with open(os.path.join(state_base(), "log"), "a") as f:
            f.write(f"{time.strftime('%H:%M:%S')} {(data.get('session_id') or '')[:8]} {cmd:<12} "
                    f"{data.get('tool_name') or data.get('hook_event_name') or ''} {what} {note}\n")
    except Exception:
        pass


def prune(base_days=7):
    base = state_base()
    cutoff = time.time() - base_days * 86400
    for name in os.listdir(base):
        p = os.path.join(base, name)
        try:
            if name == "log":
                if os.path.getsize(p) > 1_000_000:
                    os.remove(p)
            elif os.path.getmtime(p) < cutoff:
                for f in os.listdir(p):
                    os.remove(os.path.join(p, f))
                os.rmdir(p)
        except OSError:
            pass


# ---- git ---------------------------------------------------------------------

def git(cwd, *args):
    try:
        r = subprocess.run(["git", "-C", cwd, *args], capture_output=True, text=True, timeout=10)
        return r.stdout if r.returncode == 0 else None
    except Exception:
        return None


def is_test(path):
    return bool(TEST_PATH.search(path.replace(os.sep, "/")))


def is_code(path):
    return os.path.splitext(path)[1].lower() in CODE_EXT


def current_branch(path):
    """path を含む git リポジトリのブランチ名。リポジトリ外・detached なら None。
    まだ存在しないディレクトリへの新規ファイルもあるので、存在する最も近い親から探す"""
    while path and not os.path.isdir(path):
        path = os.path.dirname(path)
    out = git(path or ".", "symbolic-ref", "--short", "-q", "HEAD")
    return out.strip() if out else None


def working_changes(cwd):
    """未コミットの変更（変更・追加・未追跡）のパス一覧。git 外なら空"""
    out = git(cwd, "status", "--porcelain", "--untracked-files=all")
    if not out:
        return []
    return [line[3:].strip().split(" -> ")[-1] for line in out.splitlines() if len(line) > 3]


def branch_changes(cwd):
    """main/master から分岐して以降にコミットした変更のパス一覧（テストを先にコミットした場合用）"""
    for base in ("main", "master"):
        out = git(cwd, "diff", "--name-only", f"{base}...HEAD")
        if out is not None:
            return out.split()
    return []


def diff_hash(cwd):
    """作業ツリーの状態の指紋。検証・レビューが「どの状態に対して」行われたかを覚える"""
    h = hashlib.sha1()
    h.update((git(cwd, "diff", "HEAD") or "").encode())
    for p in working_changes(cwd):
        full = os.path.join(cwd, p)
        try:
            st = os.stat(full)
            h.update(f"{p}:{st.st_size}:{st.st_mtime_ns}\n".encode())
        except OSError:
            h.update(f"{p}:gone\n".encode())
    return h.hexdigest()


# ---- 証拠の判定 --------------------------------------------------------------

def evidence(d, cwd):
    """(コード変更があるか, 足りない証拠の一覧, main/master 上か)"""
    changed = working_changes(cwd)
    if not any(is_code(p) and not is_test(p) for p in changed):
        return False, [], False
    now = diff_hash(cwd)
    ok = {
        "tests": any(is_test(p) for p in changed + branch_changes(cwd)),
        "verified": get(d, "verified") == now,
        "reviewed": get(d, "reviewed") == now,
    }
    return True, [k for k, v in ok.items() if not v], current_branch(cwd) in PROTECTED


TEXT = {
    "tests": "テストが追加・変更されていない（TDD: 先にテストを書く）",
    "verified": "変更後に検証コマンド（テスト・型チェック・ビルド）を成功させていない → /verify",
    "reviewed": "変更後に reviewer の敵対的レビューを通していない → /review",
}


def reason_text(missing, on_main):
    parts = [TEXT[k] for k in missing]
    if on_main:
        parts.insert(0, "main/master 上で変更している → git switch -c <種別>/<名前> で作業ブランチに移す")
    return "コードを変更したが完了条件を満たしていない: " + "／".join(parts) + "。対応してから進める（省略はできない）。"


# git [-C dir] [-c k=v] commit …（サブコマンドの前に来るのはオプションだけ。git log --grep commit は対象外）
COMMIT_CMD = re.compile(r"(^|[;&|]\s*)git\s+(-\S+\s+(\S+\s+)?)*commit\b")


# ---- 本体 --------------------------------------------------------------------

def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else ""
    try:
        data = json.load(sys.stdin)
    except Exception:
        return
    d = state_dir(data.get("session_id"))
    cwd = data.get("cwd") or "."
    log(cmd, data)

    if cmd == "turn":
        unmark(d, "active")
        prune()
    elif cmd == "guard-branch":
        path = (data.get("tool_input") or {}).get("file_path") or ""
        branch = current_branch(os.path.dirname(path) or cwd)
        if branch in PROTECTED:
            print(json.dumps({
                "hookSpecificOutput": {
                    "hookEventName": "PreToolUse",
                    "permissionDecision": "deny",
                    "permissionDecisionReason": (
                        f"{branch} 上では編集しない。作業別のブランチを切ってから編集する: "
                        "git switch -c <種別>/<短い名前>（大きな作業は claude -w / cw で worktree）"
                    ),
                }
            }, ensure_ascii=False))
    elif cmd == "guard-commit":
        command = (data.get("tool_input") or {}).get("command") or ""
        if COMMIT_CMD.search(command):
            changed, missing, on_main = evidence(d, cwd)
            log(cmd, data, f"missing={missing} on_main={on_main}")
            if changed and (missing or on_main):
                print(json.dumps({
                    "hookSpecificOutput": {
                        "hookEventName": "PreToolUse",
                        "permissionDecision": "deny",
                        "permissionDecisionReason": "コミットできない。" + reason_text(missing, on_main),
                    }
                }, ensure_ascii=False))
    elif cmd == "edit":
        put(d, "active")
    elif cmd == "bash":
        put(d, "active")
        command = (data.get("tool_input") or {}).get("command") or ""
        code = (data.get("tool_response") or {}).get("exit_code", 0)
        if VERIFY_CMD.search(command) and code in (0, None):
            put(d, "verified", diff_hash(cwd))
    elif cmd == "review-done":
        if data.get("agent_type") == REVIEWER:
            put(d, "reviewed", diff_hash(cwd))
    elif cmd == "stop":
        if data.get("stop_hook_active") or get(d, "active") is None:
            return
        changed, missing, on_main = evidence(d, cwd)
        log(cmd, data, f"missing={missing} on_main={on_main}")
        if changed and (missing or on_main):
            print(json.dumps({"decision": "block", "reason": reason_text(missing, on_main)}, ensure_ascii=False))

if __name__ == "__main__":
    try:
        main()
    except Exception:
        pass
    sys.exit(0)
