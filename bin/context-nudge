#!/bin/sh
# 文脈の合図（PostToolUse のフック）: ステータスラインが書いた文脈の使用率（claude-context/<session_id>）が 60% 以上なら、
# 10% 刻みに 1 回だけ additionalContext で handoff を促す。サブエージェントの中（入力に agent_id）・値が無い・数字でないときは何もしない
in="$(cat)"
command -v jq >/dev/null 2>&1 || exit 0
[ -z "$(printf '%s' "$in" | jq -r '.agent_id // empty' 2>/dev/null)" ] || exit 0
id="$(printf '%s' "$in" | jq -r '.session_id // empty' 2>/dev/null)"
case "$id" in ''|.|..|*/*) exit 0 ;; esac
f="${XDG_STATE_HOME:-$HOME/.local/state}/claude-context/$id"
# lockfd: fd 9 のファイルを排他でロックする（最大 5 秒待つ。flock が無ければ perl の flock）
lockfd() {
  if command -v flock >/dev/null 2>&1; then flock -w 5 9
  else perl -MFcntl=:flock -e 'open(my $f, ">&=", 9) or exit 2; for (1 .. 50) { exit 0 if flock($f, LOCK_EX | LOCK_NB); select(undef, undef, undef, 0.1) } exit 1'; fi
}
# 判定と更新を排他にする（並行する PostToolUse で二重に出さない）
[ -f "$f" ] || exit 0 # ステータスラインがまだ書いていない（置き場が無いとロックも作れず、シェルが 2 で終わってしまう）
exec 9>>"$f.lock"
lockfd || exit 0
p="$(cat "$f" 2>/dev/null)" # 使用率もロックの中で読む（古い値で刻みを戻さない）
case "$p" in ''|*[!0-9]*) exit 0 ;; esac
b=$((p / 10 * 10))
last="$(cat "$f.nudged" 2>/dev/null)"
case "$last" in ''|*[!0-9]*) last=0 ;; esac
# compact などで下がったら刻みを戻す（また埋まったときに促す）
if [ "$b" -lt "$last" ]; then echo "$b" > "$f.nudged"; exit 0; fi
[ "$p" -ge 60 ] && [ "$b" -gt "$last" ] || exit 0
echo "$b" > "$f.nudged"
jq -n --arg c "文脈が ${p}% 使われている。区切りのよいところで handoff skill の手順で引き継ぐ（herdr の中なら clear して自動で続く）" \
  '{hookSpecificOutput: {hookEventName: "PostToolUse", additionalContext: $c}}'
