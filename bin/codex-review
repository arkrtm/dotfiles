#!/bin/sh
# Codex にレビューさせる（読み取り専用の sandbox。ファイルは変えない）
#   usage: codex-review plan <計画書> | codex-review branch [ベースブランチ]
# branch の最後の行は、直すべき指摘がなければ「VERDICT: PASS」、あれば「VERDICT: FAIL」。
# branch の結果は <git の共通ディレクトリ>/codex-review/<日時>-branch-<merge-base>-<HEAD>.md にも保存する（integrate が読む。
# 比較元を名前に入れるのは、別の差分へのレビューで統合させないため）
set -eu
skip=""
out=""
usage() { echo "usage: codex-review plan <file> | branch [base]" >&2; exit 2; }
case "${1:-}" in
  plan)
    [ -f "${2:-}" ] || usage
    skip=--skip-git-repo-check # 計画書はリポジトリの外にあってもよい
    prompt="厳しいレビュアーとして、計画書 $2 を読んでください。方針の誤り、見落としている要件、もっと単純な代替案を重要度順に挙げてください。問題がなければ「指摘なし」とだけ書いてください。" ;;
  branch)
    base="${2:-main}"
    dir="$(git rev-parse --path-format=absolute --git-common-dir)/codex-review"
    mkdir -p "$dir"
    out="$dir/$(date +%Y%m%d-%H%M%S)-branch-$(git merge-base "$base" HEAD)-$(git rev-parse HEAD).md"
    prompt="厳しいレビュアーとして、git diff $base...HEAD の変更をレビューしてください。バグ、壊れやすい箇所、不要な複雑さ、テストの不足を、重要度順にファイルと行を添えて挙げてください。
テストを削除・無効化して検査を通していないかも確かめてください。最後の行には、直すべき指摘がなければ「VERDICT: PASS」、あれば「VERDICT: FAIL」とだけ書いてください。" ;;
  *) usage ;;
esac
# フックは止める（tinymemory の記憶を入れず、差分と計画書だけでレビューさせる。ponytail のフックも止まる）。
# codex exec は標準入力が端末でないと入力の終わりを待って止まるので、標準入力は渡さない
exec codex exec $skip ${out:+-o "$out"} --sandbox read-only -c model_reasoning_effort=xhigh -c features.hooks=false "$prompt" </dev/null
