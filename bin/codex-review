#!/bin/sh
# Codex にレビューさせる（読み取り専用の sandbox。ファイルは変えない）
#   usage: codex-review plan <計画書> | codex-review branch [ベースブランチ]（ベースの既定は origin/<integrate setup の base>。設定が無ければ使い方の誤り）
# 指摘は「直す」と「参考」に分けさせ（規則は rule）、branch の最後の行は、「直す」がなければ「VERDICT: PASS」、あれば「VERDICT: FAIL」。
# branch の結果は <git の共通ディレクトリ>/codex-review/<日時>-branch-<merge-base>-<HEAD>.md にも保存する（integrate が読む。
# 比較元を名前に入れるのは、別の差分へのレビューで統合させないため）。
# 同じ merge-base への結果（最後の行が VERDICT: PASS/FAIL のもの）が今の HEAD の祖先にあれば、2 回目からはその本文と <その HEAD>...<HEAD> で再レビューを依頼し、無ければ全体。前回を読めなければ止まる
set -eu
skip=""
out=""
tmp=""
usage() { echo "usage: codex-review plan <file> | branch [base]" >&2; exit 2; }
rule='指摘は「直す」と「参考」に分けてください。「直す」は次の 4 つだけです: (1) 実際の使い方で起こる不具合 (2) テスト・検査・手順を弱める変更（テストが実際には確かめていない場合を含む） (3) 設計の誤り（もっと単純で壊れにくい方法があるのに、壊れやすい作りを選んでいる場合を含む） (4) 既存の振る舞いの退行（変更の前は動いていた使い方（呼び方・入力・ファイルの指定）が、変更の後に壊れる、または黙って違う結果になる。入力が珍しくても「直す」。ただし、要件で変えると決めた振る舞いと、対象の環境の外で起きるものは「参考」。対象の環境は README・設定・CI・要件に書かれたもので、書かれていなければ検査が動く環境とする。書かれていない OS、ほかのユーザーと共有する権限、ファイル名の長さなどの上限は対象の外）。(4) の退行を除き、仕様の上ではありうるが実際には起こりにくい入力や環境は「参考」に書き、「直す」に入れないでください。'
case "${1:-}" in
  plan)
    [ -f "${2:-}" ] || usage
    skip=--skip-git-repo-check # 計画書はリポジトリの外にあってもよい
    prompt="厳しいレビュアーとして、計画書 $2 を読んでください。方針の誤り、見落としている要件、もっと単純な代替案を重要度順に挙げてください。${rule}問題がなければ「指摘なし」とだけ書いてください。" ;;
  branch)
    # ベースの既定は integrate が探す比較元（origin/<base>）。fetch はしない（呼ぶ側が済ませる。進んでいれば integrate が止める）
    base="${2:-}"
    if [ -z "$base" ]; then
      b="$("$(dirname "$0")/integrate" setup --show 2>/dev/null | sed -n 's/^base=//p')" || b=""
      [ -n "$b" ] || { echo "ベースの既定は integrate setup の base（origin/<base>）。このリポジトリには設定が無いので、codex-review branch <ベース> で指定する" >&2; usage; }
      base="origin/$b"
    fi
    # 比較する 2 つのコミットは SHA で固定する（レビューの途中で参照が動いても、保存名と同じ差分を見る）
    # 未コミットの変更があると、Codex が読む作業ツリーとコミットが違う
    clean() { st="$(git status --porcelain --untracked-files=all)" && [ -z "$st" ]; }
    clean || { echo "未コミットの変更がある（または git status が失敗した）ので、レビューしません。コミットしてから実行してください" >&2; exit 1; }
    from="$(git merge-base "$base" HEAD)"
    head="$(git rev-parse HEAD)"
    dir="$(git rev-parse --path-format=absolute --git-common-dir)/codex-review"
    mkdir -p "$dir"
    out="$dir/$(date +%Y%m%d-%H%M%S)-branch-$from-$head.md"
    # Codex には一時ファイルに書かせ、正常に終わって作業ツリーも確かめた後でだけ正式な名前にする
    tmp="$out.partial"
    trap 'rm -f "$tmp"' EXIT
    # 2 回目からは、同じ比較元への結果のうち HEAD が今の HEAD の祖先（今の HEAD は除く）で、最後の行が VERDICT: PASS/FAIL の最新のものを前回とする。
    # 共通ディレクトリはほかの worktree のブランチと共有するので、祖先かどうかで自分の履歴の結果を選ぶ
    prev=""; phead=""
    for f in "$dir"/*-branch-"$from"-*.md; do
      [ -e "$f" ] || continue
      h="${f##*-}"; h="${h%.md}"
      [ "$h" != "$head" ] && git merge-base --is-ancestor "$h" "$head" 2>/dev/null || continue
      # 最後の行が VERDICT でない結果（空・途中で終わった本文）は前回にしない。読めない結果は止まる
      last="$(tail -n 1 -- "$f")" || { echo "前回のレビューの結果（$f）を読めないので、レビューしません" >&2; exit 1; }
      case "$last" in "VERDICT: PASS"|"VERDICT: FAIL") prev="$f"; phead="$h" ;; esac
    done
    if [ -n "$prev" ]; then
      # 前回の本文はここで読んで渡す（Codex に読みに行かせると、読めなかった結果が次の回の前回になり、直っていない指摘が消える）
      pbody="$(cat -- "$prev")" || { echo "前回のレビューの結果（$prev）を読めないので、レビューしません" >&2; exit 1; }
      prompt="レビュアーとして、再レビューをしてください。前回のレビュー（コミット $phead の時点）の結果を、次の「前回の結果（ここから）」と「前回の結果（ここまで）」の行の間に示します。
前回の結果（ここから）
$pbody
前回の結果（ここまで）
見るのは次の 2 つだけです: (a) 前回の「直す」の指摘が、git diff $phead...$head の修正で直っているか (b) その修正が新しい「直す」に当たる問題を入れていないか。修正の差分の外を新しく探さないでください。前回の結果に「直す」と「参考」の分けが無ければ、前回の指摘をすべて下の規則で仕分け直してから (a) を確かめてください。直っていない前回の「直す」は、今回の「直す」にもう一度書いてください。${rule}最後の行には、「直す」の指摘が残っていなければ「VERDICT: PASS」、あれば「VERDICT: FAIL」とだけ書いてください。"
    else
      prompt="厳しいレビュアーとして、git diff $from...$head（$base との差分）の変更をレビューしてください。バグ、壊れやすい箇所、不要な複雑さ、テストの不足を、重要度順にファイルと行を添えて挙げてください。
テストを削除・無効化して検査を通していないかも確かめてください。${rule}最後の行には、「直す」の指摘がなければ「VERDICT: PASS」、あれば「VERDICT: FAIL」とだけ書いてください。"
    fi ;;
  *) usage ;;
esac
# フックは止める（tinymemory の記憶を入れず、差分と計画書だけでレビューさせる。ponytail のフックも止まる）。
# codex exec は標準入力が端末でないと入力の終わりを待って止まるので、標準入力は渡さない
codex exec $skip ${tmp:+-o "$tmp"} --sandbox read-only -c model_reasoning_effort=xhigh -c features.hooks=false "$prompt" </dev/null || exit
# レビューの途中で HEAD か作業ツリーが変わったら、レビューした内容とコミットが合わないので保存しない
if [ -n "$out" ]; then
  if [ "$(git rev-parse HEAD)" != "$head" ] || ! clean; then
    echo "レビューの途中で HEAD か作業ツリーが変わったので、結果を保存しません。やり直してください" >&2
    exit 1
  fi
  mv "$tmp" "$out"
fi
