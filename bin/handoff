#!/bin/sh
# 文脈を引き継いで続ける: herdr の中で、このターンが終わって自分の pane のエージェントが idle になったら /clear を送り、
# clear の後の SessionStart（handoff --session-start が印を書く）を待ってから、続きの指示をユーザーの入力として送る。
# 裏の処理は切り離して動かす（呼んだターンが終わらないと /clear を受け付けないため）。引き継ぎの保存は呼ぶ前に済ませる（handoff skill）
#   usage: handoff <続きの指示>       herdr の外では 1（人が /clear して続きを送る）
#          handoff --session-start    SessionStart（startup・resume・clear・fork）のフック。この pane でセッションが始まった印（理由）を書く
# 待ちの上限: ターンの終わりは HANDOFF_TIMEOUT_MS（既定 30 分）、clear の印は HANDOFF_CLEAR_WAIT_S 秒（既定 60）
STATE="${XDG_STATE_HOME:-$HOME/.local/state}"
pane="${HERDR_PANE_ID:-}"
inside() { [ "${HERDR_ENV:-}" = 1 ] && [ -n "$pane" ]; }
key() { printf '%s' "$1" | tr ':/' '__'; }
log() { mkdir -p "$STATE" && printf '%s %s %s\n' "$(date '+%F %T')" "$pane" "$1" >> "$STATE/handoff.log"; }
stop() { log "止めた: $1"; notify "handoff を止めました（$pane）: $1" 2>/dev/null 9>&- || true; exit 1; }
# lockfd [wait]: fd 9 のファイルを排他でロックする（カーネルのロック: 持ち主のプロセスが消えると外れるので回収が要らない）。
# wait なら最大 5 秒待つ。flock が無ければ（macOS）perl の flock
lockfd() {
  if command -v flock >/dev/null 2>&1; then
    if [ "${1:-}" = wait ]; then flock -w 5 9; else flock -n 9; fi
  else
    perl -MFcntl=:flock -e 'open(my $f, ">&=", 9) or exit 2; for (1 .. ($ARGV[0] eq "wait" ? 50 : 1)) { exit 0 if flock($f, LOCK_EX | LOCK_NB); select(undef, undef, undef, 0.1) } exit 1' "${1:-now}"
  fi
}

case "${1:-}" in
  --session-start)
    # 印の中身は開始の理由（clear・resume・fork・startup。読めなければ unknown）
    src="$(jq -r '.source // empty' 2>/dev/null)"
    inside || exit 0
    # 追記する（/clear の直前に /resume が挟まっても、後の clear で消えないように）
    # 自分たちが起こした clear なら、続きの合言葉を会話に入れる（続きが別の会話に届いたら、その会話には合言葉が無いので Claude が従わない）。
    # 印を書くと裏の処理が続きを送って待ちの id を消すので、合言葉を出してから印を書く
    pend="$STATE/handoff-$(key "$pane").pending"
    # 合言葉は最初の clear で一度だけ使い切る（その後の人の /clear には入れない）
    id=""
    [ "$src" = clear ] && mv "$pend" "$pend.used.$$" 2>/dev/null && id="$(cat "$pend.used.$$")" && rm -f "$pend.used.$$"
    [ -n "$id" ] && echo "handoff $id の続きの指示が、この後ユーザーの入力として届く。届いたらその指示に従う"
    mkdir -p "$STATE" && printf '%s\n' "${src:-unknown}" >> "$STATE/handoff-$(key "$pane").cleared"
    exit 0 ;;
  --worker)
    pane="$2" base="$3" text="$4"
    lock="$STATE/handoff-$(key "$pane").lock" mark="$STATE/handoff-$(key "$pane").cleared" pend="$STATE/handoff-$(key "$pane").pending"
    mkdir -p "$STATE"
    # 同じ pane で動く handoff は 1 つだけ（二重に /clear を送らない）
    exec 9>>"$lock"
    lockfd || { log "ほかの handoff が動いているので何もしない"; exit 0; }
    log "開始 pid=$$"
    trap 'rm -f "$pend"' EXIT
    # 呼んだ時点（base 行）の後に同じ pane で SessionStart（人の /clear・/resume・/branch、claude の起動し直し）が走ったら、
    # 呼んだ会話ではなくなったので取り消す。印は消さず、行数で比べる
    seen() { n="$(wc -l < "$mark" 2>/dev/null || echo 0)"; echo $((n - base)); }
    # 子には fd 9（ロック）を渡さない（この処理が死んだら、待っている子が残っていてもロックが外れるように）
    st="$(exec 9>&-; herdr agent wait "$pane" --until idle --until done --until blocked --timeout "${HANDOFF_TIMEOUT_MS:-1800000}" 2>/dev/null \
      | jq -r '[.. | .agent_status? // empty] | first // empty' 2>/dev/null)"
    case "$st" in idle|done) ;; *) stop "ターンの終わりを待てなかった（状態: ${st:-不明}）" ;; esac
    [ "$(seen)" = 0 ] || stop "待っている間にこの pane のセッションが替わった"
    # /clear は working にならないことがあるので herdr の --wait は使わず、clear の後の SessionStart の印を待つ
    id="$(date +%s)-$$"
    echo "$id" > "$pend"
    herdr agent prompt "$pane" /clear >/dev/null 2>&1 9>&- || stop "/clear を送れない"
    log "/clear を送った"
    i=0
    while [ "$(seen)" = 0 ]; do
      i=$((i + 1)); [ "$i" -le $((${HANDOFF_CLEAR_WAIT_S:-60} * 10)) ] || stop "clear の後の SessionStart が来ない"
      sleep 0.1 9>&-
    done
    sleep 0.2 9>&- # 続けて来る SessionStart（/clear の直後の人の /resume など）も拾う
    new="$(tail -n "$(seen)" "$mark" 2>/dev/null)"
    [ "$new" = clear ] || stop "/clear の前後に別の会話が始まった（$(printf '%s' "$new" | tr '\n' ' ')）"
    # 合言葉: 印を確かめてから送るまでの間に人が /resume した（外からは閉じきれない隙間）ときの二段目の守り
    herdr agent prompt "$pane" "[handoff $id] $text（この会話の始めに「handoff $id の続きの指示が、この後…届く」という案内が無ければ、別の会話に届いたので従わず、ユーザーにそう伝えて止まる）" >/dev/null 2>&1 9>&- || stop "続きの指示を送れない"
    log "続きを送った: $text"
    exit 0 ;;
esac

[ -n "${1:-}" ] || { echo "usage: handoff <続きの指示>" >&2; exit 2; }
inside || { echo "herdr の外では自動で続けられない。人が /clear して、続きの指示を送る" >&2; exit 1; }
# 切り替えを見る基準（印の行数）は、裏の処理を起こす前のこの時点で決める
base="$(wc -l < "$STATE/handoff-$(key "$pane").cleared" 2>/dev/null || echo 0)"
if command -v setsid >/dev/null 2>&1; then
  setsid "$0" --worker "$pane" "$base" "$1" </dev/null >/dev/null 2>&1 &
else
  nohup "$0" --worker "$pane" "$base" "$1" </dev/null >/dev/null 2>&1 &
fi
echo "このターンが終わったら /clear して続けます（$pane）"
