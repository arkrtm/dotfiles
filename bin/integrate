#!/bin/sh
# 関門をすべて満たしたときだけ統合する。1 つでも欠けたら統合せず、notify で知らせて止まる（終了コード 1）
#   usage: integrate [--human-approved] | integrate setup [--force] [--kind K] [--base B] [--test CMD] | integrate setup --show
#   --human-approved  テストや検査を無効にする記述の追加・テストの削除を、人が確認したうえで通す（人用。Claude には settings.json で禁止）
# 関門: setup の設定がある・最上位のブランチ（base）の上でない・未コミットの変更が無い・origin/<base> を含む・設定の test が通る・
#       今のコミットの origin/<base> との差分への codex-review branch の結果が VERDICT: PASS・テストや検査を弱めていない
# 統合: kind=bare・github は base へ push（早送りだけ）。kind=pr はブランチを push して base に向けた PR を作るだけ（マージはチーム）
# push するのは検査とレビューをしたコミット（途中で HEAD が変わったら止める）
# setup: リポジトリの種類（kind: bare・github・pr）・最上位のブランチ（base）・テストのコマンド（test）を
#       ~/.config/integrate/repos/<origin の URL の鍵> に書く（リポジトリの外。XDG_CONFIG_HOME には従わない: settings.json の deny と場所を合わせる）。
#       引数が足りなければ、端末なら推測を既定値に尋ね、端末でなければ推測を出して終了コード 2。既にあれば 1。
#       上書きは setup の直後の --force で、端末からだけ（エージェントには書き換えさせない）
set -eu
usage() { echo "usage: integrate [--human-approved] | integrate setup [--force] [--kind bare|github|pr] [--base <branch>] [--test <command>] | integrate setup --show" >&2; exit 2; }
approved=""
mode=""
case "$#:${1:-}" in
  0:) ;;
  1:--human-approved) approved=1 ;;
  *:setup) mode=setup; shift ;;
  *) usage ;;
esac
root="$(git rev-parse --show-toplevel)" || exit 1
cd "$root"
fail() {
  notify "統合を止めました（$(basename "$root")）: $1" 2>/dev/null || true
  echo "統合しません: $1" >&2
  exit 1
}
# origin の GitHub のリポジトリ <owner>/<repo>（GitHub でなければ空）。gh の GH_REPO・set-default・GH_HOST には従わない。
# insteadOf で展開した URL、無ければ書いたままの URL のうち github.com を含むもの（大文字小文字を問わない）の、末尾の <owner>/<repo>
github_repo() {
  for u in "$(git remote get-url origin)" "$(git config --get remote.origin.url)"; do
    printf '%s\n' "$u" | grep -qi github.com || continue
    printf '%s\n' "$u" | sed -E 's#/*$##; s#\.git$##; s#^.*[/:]([^/:]+/[^/:]+)$#\1#' | grep -E '^[^/:]+/[^/:]+$' || true
    return 0
  done
}
# origin の識別子: 取得先 URL。ローカルのパス（scheme が無く、最初の : より前に / があるか : が無い。git の規則）は
# 解決した絶対パスにする（相対パスが同じ別のリポジトリと見分ける）
remote_id() {
  url="$(git remote get-url origin 2>/dev/null)" || return 1
  case "$url" in
    *://*) ;;
    *) case "${url%%:*}" in
         "$url"|*/*) d="$(CDPATH= cd -P "$root" 2>/dev/null && CDPATH= cd -P "$url" 2>/dev/null && pwd -P)" && url="$d" ;;
       esac ;;
  esac
  printf '%s\n' "$url"
}
# 設定のファイル: 識別子の英数字と ._- 以外を _ にした名前の先頭 100 文字（読める）と、識別子のハッシュの先頭 12 文字
# （記号だけ違う・長い URL でも衝突せず、ファイル名の上限に収まる）
conf_path() {
  id="$(remote_id)" || return 1
  h="$(printf '%s' "$id" | git hash-object --stdin)" || return 1
  printf '%s/.config/integrate/repos/%.100s-%.12s\n' "$HOME" "$(printf '%s' "$id" | tr -c 'A-Za-z0-9._-' '_')" "$h"
}
# 設定を conf_kind・conf_base・conf_test・conf_remote に読む（シェルとしては実行しない）。無ければ 1、壊れていれば 2
conf_load() {
  conf_kind="" conf_base="" conf_test="" conf_remote=""
  f="$(conf_path)" || return 1
  [ -f "$f" ] || return 1
  n=0
  while IFS= read -r line || [ -n "$line" ]; do
    n=$((n + 1))
    case "$line" in
      kind=*) [ -z "$conf_kind" ] || return 2; conf_kind="${line#kind=}" ;;
      base=*) [ -z "$conf_base" ] || return 2; conf_base="${line#base=}" ;;
      test=*) [ -z "$conf_test" ] || return 2; conf_test="${line#test=}" ;;
      remote=*) [ -z "$conf_remote" ] || return 2; conf_remote="${line#remote=}" ;;
      *) return 2 ;;
    esac
  done < "$f"
  [ "$n" = 4 ] && [ -n "$conf_kind" ] && [ -n "$conf_base" ] && [ -n "$conf_test" ] && [ -n "$conf_remote" ] || return 2
  case "$conf_kind" in bare|github|pr) ;; *) return 2 ;; esac
}
# 推測: kind は GitHub でなければ bare、GitHub で持ち主が gh のログインと同じなら github、ほかは pr。
# base はリモートの HEAD が指すブランチ。test はリポジトリのファイルから
guess_kind() {
  repo="$(github_repo)"
  [ -n "$repo" ] || { echo bare; return; }
  me="$(gh api user -q .login 2>/dev/null || true)"
  lower() { printf '%s' "$1" | tr 'A-Z' 'a-z'; }
  if [ -n "$me" ] && [ "$(lower "${repo%%/*}")" = "$(lower "$me")" ]; then echo github; else echo pr; fi
}
guess_base() {
  git ls-remote --symref origin HEAD 2>/dev/null | awk '$1 == "ref:" && $3 == "HEAD" { sub("^refs/heads/", "", $2); print $2; exit }'
}
guess_test() {
  if [ -e scripts/check ]; then echo 'sh scripts/check'
  elif [ -e pyproject.toml ]; then echo 'uv run pytest'
  elif [ -e package.json ]; then echo 'npm test'
  elif [ -e Cargo.toml ]; then echo 'cargo test'
  elif [ -e go.mod ]; then echo 'go test ./...'
  fi
}
setup() {
  if [ "$#" = 1 ] && [ "$1" = --show ]; then
    f="$(conf_path)" && [ -f "$f" ] || { echo "設定が無い（integrate setup）" >&2; exit 1; }
    cat "$f"; exit 0
  fi
  force=""
  [ "${1:-}" != --force ] || { force=1; shift; }
  s_kind="" s_base="" s_test=""
  while [ "$#" -gt 0 ]; do
    [ "$#" -ge 2 ] && [ -n "$2" ] || usage
    case "$1" in
      --kind) s_kind="$2" ;;
      --base) s_base="$2" ;;
      --test) s_test="$2" ;;
      *) usage ;;
    esac
    shift 2
  done
  nl='
'
  case "$s_kind$s_base$s_test" in *"$nl"*) echo "値に改行は使えない" >&2; exit 2 ;; esac
  case "$s_kind" in ''|bare|github|pr) ;; *) echo "kind は bare・github・pr のどれか" >&2; exit 2 ;; esac
  remote="$(remote_id)" || { echo "origin が無い" >&2; exit 2; }
  f="$(conf_path)"
  if [ -n "$force" ]; then
    # 端末の確かめは抑止（--human-approved の deny と同じ水準）。同じユーザーで動くエージェントは擬似端末や rm で越えられるので、
    # 人だけが上書きできる保証ではない
    [ -t 0 ] && [ -t 1 ] || { echo "上書き（--force）は人が端末から行う" >&2; exit 2; }
  elif [ -e "$f" ]; then
    echo "設定が既にある（$f）。上書きは人が端末から integrate setup --force" >&2; exit 1
  fi
  if [ -z "$s_kind" ] || [ -z "$s_base" ] || [ -z "$s_test" ]; then
    g_kind="$(guess_kind)" g_base="$(guess_base)" g_test="$(guess_test)"
    if [ ! -t 0 ]; then
      printf 'kind=%s\nbase=%s\ntest=%s\n' "${s_kind:-$g_kind}" "${s_base:-$g_base}" "${s_test:-$g_test}"
      echo "足りない項目がある。確かめて integrate setup --kind <bare|github|pr> --base <branch> --test <command> で実行し直す" >&2
      exit 2
    fi
    # ask <名前> <推測>: 空の入力は推測を採る。どちらも空・kind が不正なら尋ね直す
    ask() {
      while :; do
        printf '%s [%s]: ' "$1" "$2" >&2
        IFS= read -r a || exit 2
        a="${a:-$2}"
        [ -n "$a" ] || continue
        [ "$1" != kind ] || case "$a" in bare|github|pr) ;; *) continue ;; esac
        printf '%s\n' "$a"; return
      done
    }
    [ -n "$s_kind" ] || s_kind="$(ask kind "$g_kind")"
    [ -n "$s_base" ] || s_base="$(ask base "$g_base")"
    [ -n "$s_test" ] || s_test="$(ask test "$g_test")"
  fi
  mkdir -p "$(dirname "$f")" || { echo "設定を書けない（$f）" >&2; exit 1; }
  body="$(printf 'kind=%s\nbase=%s\ntest=%s\nremote=%s' "$s_kind" "$s_base" "$s_test" "$remote")"
  if [ -n "$force" ]; then
    { printf '%s\n' "$body" > "$f.tmp.$$" && mv -f "$f.tmp.$$" "$f"; } 2>/dev/null || { rm -f "$f.tmp.$$"; echo "設定を書けない（$f）" >&2; exit 1; }
  else
    # 新規は排他的に作る（同時に setup しても書けるのは 1 つ）
    if ! (set -C; printf '%s\n' "$body" > "$f") 2>/dev/null; then
      [ -e "$f" ] && echo "設定が既にある（$f）" >&2 || echo "設定を書けない（$f）" >&2
      exit 1
    fi
  fi
  echo "設定しました: $f"
  exit 0
}
[ "$mode" != setup ] || setup "$@"
clean() {
  st="$(git status --porcelain --untracked-files=all)" || fail "git status が失敗した"
  [ -z "$st" ]
}

# 0. 設定（integrate setup）: 無い・壊れている・別のリモートのものなら統合しない
rc=0; conf_load || rc=$?
[ "$rc" != 1 ] || fail "このリポジトリの設定が無い。integrate setup で種類・最上位のブランチ・テストを決める"
[ "$rc" = 0 ] || fail "設定が壊れている: $(conf_path)。人が integrate setup --force で作り直す"
remote="$(remote_id)"
[ "$conf_remote" = "$remote" ] || fail "設定の remote（$conf_remote）が origin（$remote）と違う"
base="$conf_base"

branch="$(git branch --show-current)"
[ -n "$branch" ] && [ "$branch" != "$base" ] || fail "$base の上（またはブランチの外）で実行された"
clean || fail "コミットしていない変更がある"
head="$(git rev-parse HEAD)"
git fetch -q origin || fail "origin から fetch できない"
from="$(git rev-parse -q --verify "origin/$base^{commit}")" || fail "origin/$base が無い"
git merge-base --is-ancestor "$from" "$head" || fail "$base が進んでいる。rebase して検査・レビューからやり直す"

# 1. テスト（設定の test）
if ! out="$(sh -c "$conf_test" 2>&1)"; then
  printf '%s\n' "$out" | tail -n 40 >&2
  fail "テスト（$conf_test）が通らない"
fi

# 2. このコミットの origin/<base> との差分への Codex のレビューが PASS
review="$(ls "$(git rev-parse --path-format=absolute --git-common-dir)/codex-review/"*-branch-"$from-$head".md 2>/dev/null | tail -n 1)"
[ -n "$review" ] || fail "今のコミットへの Codex のレビュー（codex-review branch origin/$base）が無い"
[ "$(tail -n 1 "$review" | tr -d '[:space:]')" = "VERDICT:PASS" ] || fail "Codex のレビューが PASS でない: $review"

# 3. テストや検査を弱めていない（移動も削除として数える。Markdown の文書の説明は数えない）
if [ -z "$approved" ]; then
  diff="$(git diff --no-color --no-ext-diff --text --no-textconv "$from...$head" -- . ':(exclude)*.md')" || fail "差分を取れない"
  if printf '%s\n' "$diff" | grep -qE '^\+.*(pytest\.mark\.(skip|xfail)|unittest\.skip|type: *ignore|noqa)'; then
    fail "テストや検査を無効にする記述（skip・xfail・type: ignore・noqa）が追加されている。必要なら理由を書いて人が integrate --human-approved で通す"
  fi
  # テストのディレクトリと、命名規則でテストと分かるファイル（Python・Go・JS/TS・Ruby）
  git diff --quiet --no-renames --diff-filter=D "$from...$head" -- \
    ':(glob)**/test/**' ':(glob)**/tests/**' ':(glob)**/__tests__/**' ':(glob)**/spec/**' \
    ':(glob)**/test_*.py' ':(glob)**/*_test.py' ':(glob)**/conftest.py' ':(glob)**/*_test.go' \
    ':(glob)**/*.test.*' ':(glob)**/*.spec.*' ':(glob)**/*_spec.rb' \
    || fail "テストのファイルが削除・移動されている。必要なら理由を書いて人が integrate --human-approved で通す"
fi

# テストとレビューをしたコミットのままか
clean || fail "テストの後にコミットしていない変更がある（テストが追跡ファイルを書き換えた）"
[ "$(git rev-parse HEAD)" = "$head" ] || fail "テストの間に HEAD が変わった"

# 統合（設定の kind に合わせる）
# push 先が取得先と違う（pushurl。複数も含む）と、base の判定と PR の対象が push 先とずれるので通さない
[ "$(git remote get-url --push --all origin)" = "$(git remote get-url origin)" ] || fail "origin の push 先（pushurl）が取得先と違う"
case "$conf_kind" in
  bare|github)
    git push -q origin "$head:refs/heads/$base" || fail "$base への push が拒否された"
    echo "統合しました: $(git rev-parse --short "$head") → $base"
    exit 0 ;;
esac
# pr: ブランチを push して base に向けた PR を作るだけ（マージはチーム）
repo="$(github_repo)"
[ -n "$repo" ] || fail "origin が GitHub のリポジトリと分からないので PR を作れない"
git push -q origin "$head:refs/heads/$branch" || fail "ブランチを push できない"
url="$(gh pr list --repo "github.com/$repo" --head "$branch" --base "$base" --state open --json url -q '.[].url' | head -n 1)" || fail "PR を調べられない"
[ -n "$url" ] || url="$(gh pr create --repo "github.com/$repo" --fill --base "$base" --head "$branch")" || fail "PR を作れない"
echo "PR: $url（マージはチーム）"
