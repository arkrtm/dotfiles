#!/bin/sh
# サブエージェントの進みを herdr の別 pane に見せる（ARK-90。PC 用。モバイルには出ない）。
#   usage: agent-pane start|stop|cleanup   SubagentStart・SubagentStop・SessionStart（clear）と SessionEnd のフック（標準入力にフックの JSON）
#          agent-pane view <記録>           記録（jsonl）を追い、文とツールの呼び出しを 1 行ずつ出す（start が pane で動かす）
# herdr の中だけ。1 つ目はメインの上に 3 分の 1 の高さ（下に分けてから入れ替える。herdr の split は right と down だけ）、2 つ目はその右。
# 同時に開くのは 2 つまで。workflow のエージェント（agent_type が workflow-subagent）は数が多いので開かない（ARK-100）。
# 開いた pane は state/agent-pane/<メインの pane>/<agent_id>（1 行目 pane、2 行目 記録）に覚え、消えた pane・中断（meta.json の finished）は数えずに閉じる
MAX=2
if [ "${1:-}" = view ]; then
  rec="${2:?usage: agent-pane view <記録>}"
  while [ ! -e "$rec" ]; do sleep 0.5; done
  exec tail -n +1 -F "$rec" 2>/dev/null | jq -r --unbuffered '
    select(.type == "assistant") | .message.content[]? |
    if .type == "text" then .text[0:200]
    elif .type == "tool_use" then "→ \(.name) \((.input // {} | to_entries | first | .value // "" | tostring)[0:80])"
    else empty end' 2>/dev/null
fi

in="$(cat)"
[ "${HERDR_ENV:-}" = 1 ] && [ -n "${HERDR_PANE_ID:-}" ] || exit 0
command -v jq >/dev/null 2>&1 || exit 0
j() { printf '%s' "$in" | jq -r "$1 // empty" 2>/dev/null; }
sid="$(j .session_id)"
case "$sid" in ''|.|..|*/*) exit 0 ;; esac
# 記録はメインの pane ごと（clear でセッションが替わっても、前のセッションで閉じられなかった pane を数えて片づけられるように）
D="${XDG_STATE_HOME:-$HOME/.local/state}/agent-pane/$(printf '%s' "$HERDR_PANE_ID" | tr ':/' '__')"
mkdir -p "$D" 2>/dev/null || exit 0
# lockfd [wait]: fd 9 のファイルを排他でロックする（カーネルのロック: 持ち主のプロセスが消えると外れるので回収が要らない）。
# wait なら最大 5 秒待つ。flock が無ければ（macOS）perl の flock
lockfd() {
  if command -v flock >/dev/null 2>&1; then
    if [ "${1:-}" = wait ]; then flock -w 5 9; else flock -n 9; fi
  else
    perl -MFcntl=:flock -e 'open(my $f, ">&=", 9) or exit 2; for (1 .. ($ARGV[0] eq "wait" ? 50 : 1)) { exit 0 if flock($f, LOCK_EX | LOCK_NB); select(undef, undef, undef, 0.1) } exit 1' "${1:-now}"
  fi
}
# メインの pane ごとに 1 つずつ（数える → 開く → 覚える を並行の開始で割り込ませない）
lock() { exec 9>>"$D.lock"; lockfd wait || exit 0; }
# gone <pane>: herdr がその pane は無い（pane_not_found）と答えたら 0。通信の失敗は「ある」として扱う（覚えた pane を失わない）
gone() { out="$(herdr pane "$1" "$2" 2>&1)" && return 1; printf '%s' "$out" | grep -q '"pane_not_found"'; }
# close <記録>: pane を閉じられた、または既に無いときだけ記録を消す
close() {
  p="$(sed -n 1p "$1" 2>/dev/null)"
  if [ -z "$p" ] || herdr pane close "$p" >/dev/null 2>&1 || gone get "$p"; then rm -f "$1"; fi
}
aid="$(j .agent_id)"
case "$aid" in */*) exit 0 ;; esac

case "${1:-}" in
  start)
    [ -n "$aid" ] || exit 0
    [ "$(j .agent_type)" = workflow-subagent ] && exit 0
    lock
    # 同じエージェントの pane がまだあれば何もしない。人が閉じていたら開き直す
    if [ -e "$D/$aid" ]; then gone get "$(sed -n 1p "$D/$aid")" || exit 0; rm -f "$D/$aid"; fi
    n=0 top=""
    for f in "$D"/*; do
      [ -f "$f" ] || continue
      if gone get "$(sed -n 1p "$f")"; then rm -f "$f"; continue; fi
      r="$(sed -n 2p "$f")"
      if [ "$(jq -r '.finished // false' "${r%.jsonl}.meta.json" 2>/dev/null)" = true ]; then close "$f"; [ -e "$f" ] || continue; fi
      n=$((n + 1)); top="$(sed -n 1p "$f")"
    done
    [ "$n" -lt "$MAX" ] || exit 0
    tp="$(j .transcript_path)"
    [ -n "$tp" ] || exit 0
    case "$aid" in agent-*) a="$aid" ;; *) a="agent-$aid" ;; esac
    rec="${tp%.jsonl}/subagents/$a.jsonl"
    cwd="$(j .cwd)"
    # 開いているサブの pane があればその右、無ければメインの下に分けてメインと入れ替える（サブが上、メインが下）
    if [ -n "$top" ]; then set -- --pane "$top" --direction right; else set -- --pane "$HERDR_PANE_ID" --direction down --ratio 0.333; fi
    new="$(herdr pane split "$@" --no-focus ${cwd:+--cwd "$cwd"} 2>/dev/null | jq -r '.result.pane.pane_id // empty' 2>/dev/null)"
    [ -n "$new" ] || exit 0
    printf '%s\n%s\n' "$new" "$rec" > "$D/$aid"
    if [ -z "$top" ]; then herdr pane swap --source-pane "$HERDR_PANE_ID" --target-pane "$new" >/dev/null 2>&1 || { close "$D/$aid"; exit 0; }; fi
    q="$(printf '%s' "$rec" | sed "s/'/'\\\\''/g")" # ' を '\'' にしてシングルクォートで囲む
    # 表示を起動できなければ、空の pane と記録を残さない（上限を詰まらせず、再通知で開き直せるように）
    herdr pane run "$new" "agent-pane view '$q'" >/dev/null 2>&1 || close "$D/$aid" ;;
  stop)
    [ -n "$aid" ] && [ -f "$D/$aid" ] && close "$D/$aid" ;;
  cleanup)
    lock
    for f in "$D"/*; do [ -f "$f" ] && close "$f"; done ;;
esac
exit 0
